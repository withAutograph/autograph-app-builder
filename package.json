{
  "name": "autograph-app-builder",
  "version": "0.1.0",
  "description": "Autograph App Builder: a durable Eve agent for designing and creating supported applications.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "eve build && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:agent": "APP_BUILDER_TEST_MODEL=1 APP_BUILDER_LOCAL_PUBLICATION=1 APP_BUILDER_BRANCH_WORKTREE_PUBLICATION=1 eve eval --exclude-tag disabled-local-publication --strict --skip-report && APP_BUILDER_TEST_MODEL=1 APP_BUILDER_LOCAL_PUBLICATION=0 APP_BUILDER_BRANCH_WORKTREE_PUBLICATION=1 eve eval --tag disabled-local-publication --strict --skip-report",
    "test:sandbox-toolchain": "APP_BUILDER_TEST_MODEL=1 APP_BUILDER_REAL_SANDBOX=1 eve eval sandbox-toolchain --strict --skip-report",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:plugin",
    "configure": "node --import tsx scripts/configure-template.mts",
    "validate:plugin": "node --import tsx scripts/validate-plugin.mts",
    "validate:release": "node --import tsx scripts/validate-plugin.mts --release",
    "build:agent-plugin-package": "node --import tsx scripts/build-agent-plugin-package.mts",
    "build:openai-package": "node --import tsx scripts/build-openai-package.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@vercel/connect": "0.9.0",
    "@vercel/oidc": "3.8.5",
    "ai": "7.0.73",
    "better-auth": "1.7.1",
    "drizzle-orm": "0.45.2",
    "eve": "0.43.0",
    "mcp-handler": "2.1.1",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "just-bash": "3.4.1",
    "microsandbox": "0.6.14",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  }
}
