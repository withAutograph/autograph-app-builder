{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "self-reproduction-parity/v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "const": "evaluator"
    },
    "fixtureVersion": {
      "type": "number",
      "const": 1
    },
    "reference": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "enum": ["available", "missing", "infrastructure-unavailable"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string",
                "enum": [
                  "anonymous-entry",
                  "authentication",
                  "durable-draft",
                  "provider-return-success",
                  "provider-return-error",
                  "app-creation",
                  "preview-access",
                  "cancellation",
                  "retry",
                  "session-recovery",
                  "independent-child",
                  "documentation",
                  "server-first",
                  "narrow-client",
                  "server-writes",
                  "auth-cache-isolation",
                  "suspense",
                  "cache-components",
                  "partial-prefetching",
                  "instant-navigation",
                  "navigation-continuity",
                  "pending-optimistic",
                  "semantic-tokens",
                  "capture/desktop/panel-resize",
                  "capture/desktop/keyboard",
                  "capture/desktop/loading",
                  "capture/desktop/empty",
                  "capture/desktop/error",
                  "capture/desktop-wide/panel-resize",
                  "capture/desktop-wide/keyboard",
                  "capture/desktop-wide/loading",
                  "capture/desktop-wide/empty",
                  "capture/desktop-wide/error",
                  "capture/desktop-window/panel-resize",
                  "capture/desktop-window/keyboard",
                  "capture/desktop-window/loading",
                  "capture/desktop-window/empty",
                  "capture/desktop-window/error"
                ]
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "observed",
                  "missing-functionality",
                  "infrastructure-unavailable",
                  "not-run"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifacts": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^\\s]+(?<!\\/)$"
                      }
                    }
                  },
                  "required": ["id", "passed", "detail", "artifacts"],
                  "additionalProperties": false
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^\\s]+(?<!\\/)$"
                }
              },
              "method": {
                "type": "string",
                "enum": [
                  "browser",
                  "source-review",
                  "source-and-browser",
                  "@next/playwright/instant",
                  "none"
                ]
              }
            },
            "required": [
              "requirementId",
              "disposition",
              "reason",
              "assertions",
              "artifacts",
              "method"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["output", "reason", "sourceRevision", "observations"],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "output": {
          "type": "string",
          "enum": ["available", "missing", "infrastructure-unavailable"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string",
                "enum": [
                  "anonymous-entry",
                  "authentication",
                  "durable-draft",
                  "provider-return-success",
                  "provider-return-error",
                  "app-creation",
                  "preview-access",
                  "cancellation",
                  "retry",
                  "session-recovery",
                  "independent-child",
                  "documentation",
                  "server-first",
                  "narrow-client",
                  "server-writes",
                  "auth-cache-isolation",
                  "suspense",
                  "cache-components",
                  "partial-prefetching",
                  "instant-navigation",
                  "navigation-continuity",
                  "pending-optimistic",
                  "semantic-tokens",
                  "capture/desktop/panel-resize",
                  "capture/desktop/keyboard",
                  "capture/desktop/loading",
                  "capture/desktop/empty",
                  "capture/desktop/error",
                  "capture/desktop-wide/panel-resize",
                  "capture/desktop-wide/keyboard",
                  "capture/desktop-wide/loading",
                  "capture/desktop-wide/empty",
                  "capture/desktop-wide/error",
                  "capture/desktop-window/panel-resize",
                  "capture/desktop-window/keyboard",
                  "capture/desktop-window/loading",
                  "capture/desktop-window/empty",
                  "capture/desktop-window/error"
                ]
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "observed",
                  "missing-functionality",
                  "infrastructure-unavailable",
                  "not-run"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "passed": {
                      "type": "boolean"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifacts": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^\\s]+(?<!\\/)$"
                      }
                    }
                  },
                  "required": ["id", "passed", "detail", "artifacts"],
                  "additionalProperties": false
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.{1,2}(?:\\/|$))(?!.*\\/\\/)[^\\s]+(?<!\\/)$"
                }
              },
              "method": {
                "type": "string",
                "enum": [
                  "browser",
                  "source-review",
                  "source-and-browser",
                  "@next/playwright/instant",
                  "none"
                ]
              }
            },
            "required": [
              "requirementId",
              "disposition",
              "reason",
              "assertions",
              "artifacts",
              "method"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["output", "reason", "sourceRevision", "observations"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "runId", "producer", "fixtureVersion", "reference", "candidate"],
  "additionalProperties": false
}
