#!/bin/sh
#MISE hide=true
#MISE description="Inspect exact local sandbox image identity and OCI provenance"
set -eu

node_bin="$(mise which node)"
export APP_BUILDER_IMAGE_NODE_BIN="$node_bin"
export APP_BUILDER_IMAGE_DOCKER_BIN="$(mise which docker)"
exec "$PWD/.config/mise/scripts/trusted-node-launcher" "$node_bin" --experimental-strip-types .config/mise/scripts/repository/image-lifecycle.ts inspect-local "$@"
