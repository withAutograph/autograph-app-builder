#!/bin/sh
#MISE hide=true
#MISE description="Build the exact linux/arm64 sandbox image locally"
set -eu

node_bin="$(mise which node)"
export APP_BUILDER_IMAGE_NODE_BIN="$node_bin"
export APP_BUILDER_IMAGE_BUILDX_BIN="$(mise which docker-cli-plugin-docker-buildx)"
exec "$PWD/.config/mise/scripts/trusted-node-launcher" "$node_bin" --experimental-strip-types .config/mise/scripts/repository/image-lifecycle.ts build "$@"
