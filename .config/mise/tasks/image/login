#!/bin/sh
#MISE hide=true
#MISE description="Match one approved stdin token to the pinned GitHub CLI keyring identity"
set -eu

node_bin="$(mise which node)"
export APP_BUILDER_IMAGE_NODE_BIN="$node_bin"
export APP_BUILDER_IMAGE_GH_BIN="$(mise which gh)"
export APP_BUILDER_IMAGE_DOCKER_BIN="$(mise which docker)"
export APP_BUILDER_IMAGE_BUILDX_BIN="$(mise which docker-cli-plugin-docker-buildx)"
exec "$PWD/.config/mise/scripts/trusted-node-launcher" "$node_bin" --experimental-strip-types \
  .config/mise/scripts/repository/image-lifecycle.ts login "$@"
