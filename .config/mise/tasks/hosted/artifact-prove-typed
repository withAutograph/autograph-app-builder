#!/bin/sh
#MISE description="Prove exact artifact commands and typed planning-only Eve workflow"
set -eu

if [ "$#" -ne 8 ] || [ "$1" != "--image" ] || [ "$3" != "--source-root" ] || [ "$5" != "--artifact" ] || [ "$7" != "--artifact-sha256" ]; then
  echo "usage: mise run hosted:artifact-prove-typed -- --image <digest-ref> --source-root <exact-checkout> --artifact <dependency-artifact> --artifact-sha256 <sha256>" >&2
  exit 64
fi

image=$2
source_root=$4
artifact=$6
artifact_sha256=$8
mise run hosted:artifact-prove -- \
  --arrusted-root "$source_root" \
  --artifact "$artifact" \
  --artifact-sha256 "$artifact_sha256"

exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$(mise which node)" --import tsx scripts/run-eve-eval.mts \
  --gate-a-profile hosted-artifact \
  --gate-a-image "$image" \
  --gate-a-source-root "$source_root" \
  sandbox-identity-planning --strict --skip-report
