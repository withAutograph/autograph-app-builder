#!/bin/sh
#MISE description="Activate one exact hosted Preview workspace membership"
set -eu

if [ "$#" -ne 2 ] || [ "$1" != "--request-file" ]; then
  echo "usage: mise run hosted:membership-seed -- --request-file /absolute/owner-only.json" >&2
  exit 64
fi
if [ "${DATABASE_URL+x}" != x ] || [ -z "$DATABASE_URL" ]; then
  echo "hosted:membership-seed requires DATABASE_URL" >&2
  exit 64
fi
database_url=$DATABASE_URL
unset DATABASE_URL
printf '%s' "$database_url" | (
  unset database_url
  exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
    "$(mise which node)" --import tsx lib/db/hosted-admin-cli.mts \
    apply --expected-action membership.seed --database-url-fd 0 --request-file "$2"
)
