#!/bin/sh
#MISE description="Bind one tenant to an exact GitHub App installation"
set -eu

if [ "$#" -ne 2 ] || [ "$1" != "--request-file" ]; then
  echo "usage: mise run hosted:github-installation-bind -- --request-file /absolute/owner-only.json" >&2
  exit 64
fi
if [ "${DATABASE_URL+x}" != x ] || [ -z "$DATABASE_URL" ]; then
  echo "hosted:github-installation-bind requires DATABASE_URL" >&2
  exit 64
fi
database_url=$DATABASE_URL
unset DATABASE_URL
printf '%s' "$database_url" | (
  unset database_url
  exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
    "$(mise which node)" --import tsx lib/db/hosted-github-installation-cli.mts \
    apply --database-url-fd 0 --request-file "$2"
)
