#!/bin/sh
#MISE description="Prove the hosted dependency artifact against an exact Arrusted checkout"
set -eu

exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$(mise which node)" --import tsx \
  .config/mise/scripts/repository/prove-hosted-arrusted-artifact.mts \
  --mise-bin "$(command -v mise)" "$@"
