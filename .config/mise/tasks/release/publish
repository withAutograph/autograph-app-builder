#!/bin/sh
#MISE description="Publish and deploy only the bytes from an exact release:prove receipt"
set -eu

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage:
  mise run release:publish -- \
    --candidate-root /absolute/path/to/proven-candidate

Publish only the bytes sealed by release:prove. Vercel Git deploys the exact
main commit independently; this command never rebuilds or deploys.

Required:
  --candidate-root PATH  Absolute path to the unchanged proven candidate.
  -h, --help             Show this help.

This command creates the GitHub prerelease. Marketplace import is a separate
reviewed workflow in withAutograph/marketplace.
Run it only after explicit publication authorization.
EOF
    exit 0
    ;;
esac

export APP_BUILDER_RELEASE_NODE_BIN="$(mise which node)"
export APP_BUILDER_RELEASE_GH_BIN="$(mise which gh)"
exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$APP_BUILDER_RELEASE_NODE_BIN" --import tsx scripts/publish-release-candidate.mts "$@"
