#!/bin/sh
#MISE description="Supervise Eve and Next with one exact fresh-bootstrap capability"
set -eu

if [ "$#" -ne 3 ]; then
  echo "usage: mise run local:start -- <owner-only-state-root> <owner-only-destination-root> <local-source-root>" >&2
  exit 64
fi

source_root=$3
if [ "${source_root#/}" = "$source_root" ] || [ -L "$source_root" ] || [ ! -d "$source_root" ]; then
  echo "local:start: source root must be an absolute regular directory" >&2
  exit 78
fi
canonical_source=$(CDPATH= cd -P -- "$source_root" && pwd -P)
if [ "$canonical_source" != "$source_root" ]; then
  echo "local:start: source root must be canonical" >&2
  exit 78
fi
case "$(/usr/bin/uname -s)" in
  Darwin)
    source_owner=$(/usr/bin/stat -f '%u' -- "$source_root")
    source_mode=$(/usr/bin/stat -f '%Lp' -- "$source_root")
    ;;
  Linux)
    source_owner=$(/usr/bin/stat -c '%u' -- "$source_root")
    source_mode=$(/usr/bin/stat -c '%a' -- "$source_root")
    ;;
  *) echo "local:start: unsupported host" >&2; exit 78 ;;
esac
if [ "$source_owner" != "$(/usr/bin/id -u)" ]; then
  echo "local:start: source root must be owned by the current account" >&2
  exit 78
fi
case "$source_mode" in
  *[0-7][2367]|*[2367][0-7])
    echo "local:start: source root must not be group/world writable" >&2
    exit 78
    ;;
esac

export APP_BUILDER_FRESH_BOOTSTRAP_ENABLED=1
export APP_BUILDER_FRESH_BOOTSTRAP_STATE_ROOT="$1"
export APP_BUILDER_FRESH_BOOTSTRAP_ALLOWED_ROOT="$2"
export APP_BUILDER_LOCAL_ADAPTER=1
export EVE_AGENT_HOST="http://127.0.0.1:2000"

node_bin="$(mise which node)"
launcher=".config/mise/scripts/trusted-node-launcher"
"$launcher" "$node_bin" --import tsx --input-type=module -e '
  const { productionFreshBootstrapCapability } = await import("./lib/repository/node-fresh-bootstrap.ts");
  await productionFreshBootstrapCapability();
'
eve_pid=""
next_pid=""

stop_children() {
  trap - EXIT INT TERM
  [ -z "$eve_pid" ] || kill "$eve_pid" 2>/dev/null || true
  [ -z "$next_pid" ] || kill "$next_pid" 2>/dev/null || true
  [ -z "$eve_pid" ] || wait "$eve_pid" 2>/dev/null || true
  [ -z "$next_pid" ] || wait "$next_pid" 2>/dev/null || true
}
trap stop_children EXIT INT TERM

REPOSITORY_LOCAL_ROOTS="$source_root" .config/mise/scripts/local-eve-launcher &
eve_pid="$!"
"$launcher" "$node_bin" node_modules/next/dist/bin/next dev \
  --hostname 127.0.0.1 --port 3000 &
next_pid="$!"

while kill -0 "$eve_pid" 2>/dev/null && kill -0 "$next_pid" 2>/dev/null; do
  sleep 1
done

status=1
if ! kill -0 "$eve_pid" 2>/dev/null; then
  set +e
  wait "$eve_pid"
  status="$?"
  set -e
elif ! kill -0 "$next_pid" 2>/dev/null; then
  set +e
  wait "$next_pid"
  status="$?"
  set -e
fi
stop_children
exit "$status"
