#!/bin/sh
#MISE description="Reset only ignored local Emulate state"
set -eu

state_dir=.emulate
pid_file="$state_dir/dev-emulated.pids"
docker=$(mise which docker)
if [ -f "$pid_file" ]; then
  for key in app_pid emulate_pid; do
    pid=$(sed -n "s/^${key}=\([0-9][0-9]*\)$/\1/p" "$pid_file")
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null || true
    fi
  done
fi
"$docker" rm -f autograph-app-builder-emulated-postgres >/dev/null 2>&1 || true
if [ -d "$state_dir" ]; then
  find "$state_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
fi
