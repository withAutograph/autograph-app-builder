#!/bin/sh
#MISE hide=true
#MISE description="Reset only ignored local Emulate state"
set -eu

state_dir=.emulate
pid_file="$state_dir/dev-emulated.pids"
docker=$(mise which docker)
if [ -f "$pid_file" ]; then
  for key in app_pid emulate_pid; do
    pid=$(sed -n "s/^${key}=\([0-9][0-9]*\)$/\1/p" "$pid_file")
    if [ -n "$pid" ]; then
      pkill -TERM -P "$pid" 2>/dev/null || true
      kill "$pid" 2>/dev/null || true
    fi
  done
fi
worktree_id=$(basename "$(dirname "$(pwd -P)")")
database_container=${APP_BUILDER_DATABASE_CONTAINER:-autograph-app-builder-web-product-e2e-postgres-$worktree_id}
if [ "${APP_BUILDER_EXTERNAL_DATABASE:-0}" != 1 ]; then
  "$docker" rm -f "$database_container" >/dev/null 2>&1 || true
fi
if [ -d "$state_dir" ]; then
  find "$state_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
fi
