#!/bin/sh
#MISE description="Run the complete emulated web product CI lane"
set -eu

mise run auth-e2e:setup
export APP_BUILDER_EXTERNAL_WEB_SERVER=1
.config/mise/tasks/app/dev-emulated &
app_pid=$!
cleanup() {
  kill "$app_pid" >/dev/null 2>&1 || true
  wait "$app_pid" >/dev/null 2>&1 || true
  mise run auth-e2e:reset >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM
attempt=0
until curl --fail --silent "http://127.0.0.1:${APP_BUILDER_LOCAL_PORT:-3001}/auth/sign-in" >/dev/null; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 300 ]; then
    echo "emulated auth app did not become ready" >&2
    exit 1
  fi
  sleep 1
done
mise run auth-e2e:test
