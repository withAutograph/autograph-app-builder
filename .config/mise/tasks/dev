#!/bin/sh
#MISE description="Run the only live, non-release App Builder development workflow"
set -eu

if [ "${VERCEL_TOKEN+x}" = x ] || [ "${AI_GATEWAY_API_KEY+x}" = x ]; then
  echo "dev: static Vercel and AI Gateway credentials are unsupported; use project OIDC" >&2
  exit 78
fi

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage:
  mise run dev -- --arrusted-root /absolute/path/to/arrusted [options]

Run the non-release App Builder workflow from a writable local Arrusted checkout
and a transient development snapshot. Keep this command running while you use the development
plugin from a fresh Codex task.

Required:
  --arrusted-root PATH     Absolute path to a local Arrusted checkout. The
                           checkout may contain uncommitted changes.

Options:
  --state-root PATH        Owner-only state and cache root. Defaults to
                           .artifacts/development.
  --resume-cycle PATH      Explicitly reuse a stopped owner-bound cycle in this state root,
                           retaining its saved Eve sessions while loading current Builder code.
  --destination-root PATH  Builder-owned generated-work root. Defaults to
                           .artifacts/development/destination.
  --install-plugin BOOL    Install in the active Codex profile (default true).
                           Set false for explicit endpoint clients without profile changes.
  --next-port PORT         Loopback App Builder and /mcp port. Default: 3000.
  --hosted-session-resource URL
                           Access an existing hosted Builder through the local
                           native Codex client, using its normal stored OAuth.
                           Agent execution remains hosted; local changes are not applied.
  --hosted-session-codex-bin PATH
                           Use an existing native Codex client for session access.
                           Defaults to the project-selected Codex executable.
  --eve-port PORT          Loopback Eve port. Default: 2000.
  --emulated-web true      Prepare synthetic local auth/providers/PostgreSQL and
                           serve HTTPS localhost. Requires Docker and existing
                           trusted local TLS files; no trust-store changes.
  --web-certificate PATH   Existing localhost certificate (default certificates/localhost.pem).
  --web-key PATH           Existing key (default certificates/localhost-key.pem).
  --web-ca PATH            Existing CA (default CAROOT or cached mkcert -CAROOT).
  -h, --help               Show this help.

The command snapshots Arrusted, starts loopback /mcp, checks MCP transport
readiness, and (unless --install-plugin false) installs app-builder@autograph-dev in the active
CODEX_HOME, disabled globally and enabled by this repository's .codex/config.toml.
The local development worker cannot publish, deploy, or mutate providers.
The optional existing-session connector preserves hosted authority and approvals.
EOF
    exit 0
    ;;
esac

mise run local:ensure-oidc

export APP_BUILDER_DEV_MISE_BIN="$(command -v mise)"
export APP_BUILDER_DEV_NODE_BIN="$(mise which node)"
export APP_BUILDER_DEV_VERCEL_BIN="$(mise which vercel)"
export APP_BUILDER_DEV_CODEX_BIN="$(mise which codex)"
app_builder_codex_home="${CODEX_HOME:-$HOME/.codex}"
case "$app_builder_codex_home" in
  /*) ;;
  *)
    echo "dev: CODEX_HOME must be absolute" >&2
    exit 78
    ;;
esac
export APP_BUILDER_DEV_CODEX_HOME="$app_builder_codex_home"

exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$APP_BUILDER_DEV_NODE_BIN" --import tsx scripts/development-entry.mts "$@"
