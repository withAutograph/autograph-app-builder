#!/bin/sh
#MISE description="Observe and compare output from the public App Builder workflow"
set -eu

report_only=0
candidate_runtime=0
public_endpoint=0
for argument in "$@"; do
  case "$argument" in
    -h|--help)
      cat <<'EOF'
Submit evals/self-reproduction/brief.md through the supported App Builder web UI
or autograph_start, then answer only its ordinary product questions and approvals.
App Builder owns cloning, installation, planning, implementation, recovery and validation.

Drive that same public MCP conversation reproducibly (no internal stages):
  mise run eval:self-reproduction -- --endpoint http://127.0.0.1:64613/mcp --output-dir /tmp/self-reproduction
Supply another product brief with --brief-file PATH, or the exact existing
autograph_start request with --start-file PATH (including clientRequestId).
Select a repository branch or open PR through the ordinary product brief or
prepared handoff. This driver adds no private source instruction fields.
Hosted endpoints may use APP_BUILDER_PUBLIC_MCP_TOKEN from the server-side
environment. Tokens are never recorded in run state or transcripts.
Delivered previews are observed automatically while public polling continues.
Use --no-preview-observation only for transport-only runs; browser coverage stays unassessed.
Resume the same session and answer its outstanding product questions:
  mise run eval:self-reproduction -- --endpoint http://127.0.0.1:64613/mcp --output-dir /tmp/self-reproduction --resume --responses-file /tmp/responses.json
Resume retains the saved original start request. A lost prompt-start response
is read through autograph_get with its original clientRequestId before an
exact same-request retry. Lookup covers prompt, prepared handoff, and resume starts.

Compare the unchanged output afterward:
  mise run eval:self-reproduction -- --report-only --candidate-root PATH [comparison options]

Guided native generation is retired. Infrastructure probes and staged internal
workflows are not out-of-box self-reproduction proof.
See docs/evals/self-reproduction.md for the acceptance and evidence contract.
EOF
      exit 0
      ;;
    --endpoint|--endpoint=*) public_endpoint=1 ;;
    --report-only) report_only=1 ;;
    --candidate-runtime) candidate_runtime=1 ;;
  esac
done
if [ "$public_endpoint" = 1 ] && [ "$report_only" = 1 ]; then
  echo "Choose public conversation driving or report-only comparison, not both." >&2
  exit 64
fi
if [ "$public_endpoint" = 1 ]; then
  exec .config/mise/scripts/trusted-node-launcher \
    "$(mise which node)" --import tsx scripts/self-reproduction-public.mts "$@"
fi
if [ "$report_only" != 1 ]; then
  echo "Start self-reproduction through the supported App Builder web UI or autograph_start with the product brief. Use --endpoint for public MCP driving or --report-only for comparison; guided internal generation is retired." >&2
  exit 64
fi

# Only an explicitly requested comparison Sandbox needs project OIDC.
if [ "$candidate_runtime" = 1 ]; then
  mise run local:ensure-oidc
fi

exec .config/mise/scripts/trusted-node-launcher \
  "$(mise which node)" --import tsx scripts/eval-self-reproduction.mts \
  --mise-executable "${MISE_BIN_PATH:-$(command -v mise)}" "$@"
