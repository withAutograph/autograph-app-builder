#!/bin/sh
#MISE description="Run deterministic product-quality checks that do not require provider credentials"
set -eu

mise run test:unit -- \
  lib/agent/component-composition-policy.test.ts \
  evals/support/product-quality.test.ts

exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$(mise which node)" node_modules/playwright/cli.js test \
  --config playwright.product-quality.config.ts
