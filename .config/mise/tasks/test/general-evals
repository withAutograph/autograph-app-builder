#!/bin/sh
#MISE description="Run the general Gate A Eve evaluations without fresh-bootstrap cases"
set -eu

node_bin="$(mise which node)"
launcher="$PWD/.config/mise/scripts/trusted-node-launcher"
eval_runner="scripts/run-eve-eval.mts"

for profile in general-enabled general-disabled; do
  scenarios="$("$node_bin" --import tsx scripts/eval-scenario-selection.mts "$profile")"
  # Inventory identifiers are fixed repository-owned whitespace-free names.
  # No tag filters: every selected scenario must execute.
  # shellcheck disable=SC2086
  "$launcher" "$node_bin" --import tsx "$eval_runner" \
    --gate-a-profile "$profile" $scenarios --strict --skip-report
done
