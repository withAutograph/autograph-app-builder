#!/bin/sh
#MISE description="Verify public app release journal recovery with an owned local PostgreSQL cluster"
set -eu
postgres_bin=$(dirname "$(command -v initdb)")
exec "$PWD/.config/mise/scripts/trusted-node-launcher" "$(mise which node)" --import tsx \
  .config/mise/scripts/repository/public-release-proof/main.mts --postgres-bin "$postgres_bin" "$@"
