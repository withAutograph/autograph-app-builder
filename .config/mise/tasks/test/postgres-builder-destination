#!/bin/sh
#MISE description="Prove saved-session destination attachment with an owned disposable PostgreSQL cluster"
set -eu
postgres_bin=$(dirname "$(command -v initdb)")
exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$(mise which node)" --import tsx \
  .config/mise/scripts/repository/test-postgres-builder-destination.mts "$postgres_bin"
