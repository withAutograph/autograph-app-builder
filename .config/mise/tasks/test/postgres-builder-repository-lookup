#!/bin/sh
#MISE description="Prove owned Builder repository recovery lookup using disposable local PostgreSQL"
set -eu
postgres_bin=$(dirname "$(command -v initdb)")
exec "$PWD/.config/mise/scripts/trusted-node-launcher" \
  "$(mise which node)" --import tsx \
  .config/mise/scripts/repository/test-postgres-builder-repository-lookup.mts "$postgres_bin"
