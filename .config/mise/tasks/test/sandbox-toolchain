#!/bin/sh
#MISE description="Prove the pinned sandbox toolchain through Eve"
set -eu

node_bin="$(mise which node)"
launcher="$PWD/.config/mise/scripts/trusted-node-launcher"
export APP_BUILDER_REAL_SANDBOX=1
exec "$launcher" "$node_bin" --import tsx scripts/run-eve-eval.mts sandbox-toolchain --strict --skip-report
