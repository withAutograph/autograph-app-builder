#!/bin/sh
#MISE description="Run explicit real Vercel Sandbox integration cases against an Arrusted source checkout"
set -eu
if [ "$#" -lt 1 ]; then
  echo "usage: mise run test:sandbox-evals -- <arrusted-source-root> [scenario ...]" >&2
  exit 64
fi
source_root="$1"
shift
node_bin="$(mise which node)"
launcher="$PWD/.config/mise/scripts/trusted-node-launcher"
scenarios="$("$node_bin" --import tsx scripts/eval-scenario-selection.mts sandbox)"
if [ "$#" -eq 0 ]; then
  # shellcheck disable=SC2086
  set -- $scenarios
fi
result=0
for scenario in "$@"; do
  case " $(printf '%s\n' "$scenarios" | tr '\n' ' ') " in
    *" $scenario "*) ;;
    *) echo "Not a supported Sandbox inventory case: $scenario" >&2; exit 64 ;;
  esac
  "$launcher" "$node_bin" --import tsx scripts/run-eve-eval.mts \
    --gate-a-profile sandbox --gate-a-source-root "$source_root" \
    --gate-a-mise-executable "$(command -v mise)" \
    --gate-a-vercel-executable "$(mise which vercel)" \
    "$scenario" --strict --skip-report || result=1
done
exit "$result"
