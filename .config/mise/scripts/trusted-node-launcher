#!/bin/sh
set -eu

if [ "${NODE_OPTIONS+x}" = x ]; then
  echo "trusted-node-launcher: refusing ambient NODE_OPTIONS" >&2
  exit 78
fi
if [ "$#" -eq 0 ]; then
  echo "trusted-node-launcher: missing pinned executable" >&2
  exit 64
fi

executable=$1
shift
account_name=$(/usr/bin/id -un)
host_name=$(/usr/bin/uname -s)
case "$host_name" in
  Darwin)
    account_home=$(/usr/bin/dscacheutil -q user -a name "$account_name" | /usr/bin/awk '/^dir:/{print $2}')
    ;;
  Linux)
    account_home=$(/usr/bin/getent passwd "$account_name" | /usr/bin/awk -F: '{print $6}')
    ;;
  *)
    echo "trusted-node-launcher: unsupported host" >&2
    exit 78
    ;;
esac
if [ -z "$account_home" ] || [ ! -d "$account_home" ]; then
  echo "trusted-node-launcher: OS account home was unavailable" >&2
  exit 78
fi
child_home=$account_home
if [ -n "${APP_BUILDER_DEV_RUNTIME_HOME:-}" ]; then
  runtime_home=$APP_BUILDER_DEV_RUNTIME_HOME
  if [ -L "$runtime_home" ] || [ ! -d "$runtime_home" ]; then
    echo "trusted-node-launcher: development runtime home is not a directory" >&2
    exit 78
  fi
  canonical_runtime_home=$(CDPATH= cd -P -- "$runtime_home" && pwd -P)
  if [ "$canonical_runtime_home" != "$runtime_home" ]; then
    echo "trusted-node-launcher: development runtime home is not canonical" >&2
    exit 78
  fi
  case "$host_name" in
    Darwin)
      runtime_home_owner=$(/usr/bin/stat -f '%u' -- "$runtime_home")
      runtime_home_mode=$(/usr/bin/stat -f '%Lp' -- "$runtime_home")
      ;;
    Linux)
      runtime_home_owner=$(/usr/bin/stat -c '%u' -- "$runtime_home")
      runtime_home_mode=$(/usr/bin/stat -c '%a' -- "$runtime_home")
      ;;
  esac
  if [ "$runtime_home_owner" != "$(/usr/bin/id -u)" ] || [ "$runtime_home_mode" != 700 ]; then
    echo "trusted-node-launcher: development runtime home must be owner-only" >&2
    exit 78
  fi
  child_home=$runtime_home
fi
pinned_node="$account_home/.local/share/mise/installs/node/24.18.0/bin/node"
pinned_pnpm="$account_home/.local/share/mise/installs/pnpm/11.7.0/pnpm"
case "$executable" in
  "$pinned_node") kind=node ;;
  "$pinned_pnpm") kind=pnpm ;;
  *)
    echo "trusted-node-launcher: executable is not a pinned Node or pnpm path" >&2
    exit 78
    ;;
esac

verify_pinned_executable() {
  candidate=$1
  if [ -L "$candidate" ] || [ ! -f "$candidate" ] || [ ! -x "$candidate" ]; then
    echo "trusted-node-launcher: pinned executable is not a regular executable" >&2
    exit 78
  fi
  candidate_directory=$(/usr/bin/dirname -- "$candidate")
  candidate_leaf=$(/usr/bin/basename -- "$candidate")
  canonical_directory=$(CDPATH= cd -P -- "$candidate_directory" && pwd -P)
  if [ "$canonical_directory/$candidate_leaf" != "$candidate" ]; then
    echo "trusted-node-launcher: pinned executable path is not canonical" >&2
    exit 78
  fi
  case "$host_name" in
    Darwin)
      owner=$(/usr/bin/stat -f '%u' -- "$candidate")
      mode=$(/usr/bin/stat -f '%Lp' -- "$candidate")
      links=$(/usr/bin/stat -f '%l' -- "$candidate")
      ;;
    Linux)
      owner=$(/usr/bin/stat -c '%u' -- "$candidate")
      mode=$(/usr/bin/stat -c '%a' -- "$candidate")
      links=$(/usr/bin/stat -c '%h' -- "$candidate")
      ;;
  esac
  if [ "$owner" != "$(/usr/bin/id -u)" ] || [ "$links" -lt 1 ]; then
    echo "trusted-node-launcher: pinned executable identity is not owner-bound" >&2
    exit 78
  fi
  case "$mode" in
    *[2367][0-9]|*[0-9][2367])
      echo "trusted-node-launcher: pinned executable is group/world writable" >&2
      exit 78
      ;;
  esac
}

verify_pinned_executable "$executable"
working_directory=$(/bin/pwd -P)
child_path="$account_home/.local/share/mise/installs/node/24.18.0/bin:/usr/bin:/bin"
if [ "$kind" = pnpm ]; then
  verify_pinned_executable "$pinned_node"
fi

case "$kind" in
  node|pnpm)
    exec 3<&0
    /usr/bin/env -i \
      PATH="$child_path" \
      PWD="$working_directory" \
      HOME="$child_home" \
      TMPDIR="${TMPDIR:-/tmp}" \
      LANG="${LANG:-C}" \
      LC_ALL="${LC_ALL:-C}" \
      TZ="${TZ:-}" \
      CI="${CI:-}" \
      NODE_ENV="${NODE_ENV:-}" \
      APP_BUILDER_LOCAL_PUBLICATION="${APP_BUILDER_LOCAL_PUBLICATION:-}" \
      APP_BUILDER_BRANCH_WORKTREE_PUBLICATION="${APP_BUILDER_BRANCH_WORKTREE_PUBLICATION:-}" \
      APP_BUILDER_BRANCH_WORKTREE_ROOT="${APP_BUILDER_BRANCH_WORKTREE_ROOT:-}" \
      APP_BUILDER_FRESH_BOOTSTRAP_ENABLED="${APP_BUILDER_FRESH_BOOTSTRAP_ENABLED:-}" \
      APP_BUILDER_FRESH_BOOTSTRAP_STATE_ROOT="${APP_BUILDER_FRESH_BOOTSTRAP_STATE_ROOT:-}" \
      APP_BUILDER_FRESH_BOOTSTRAP_ALLOWED_ROOT="${APP_BUILDER_FRESH_BOOTSTRAP_ALLOWED_ROOT:-}" \
      APP_BUILDER_FRESH_BOOTSTRAP_EVAL_FAULT="${APP_BUILDER_FRESH_BOOTSTRAP_EVAL_FAULT:-}" \
      APP_BUILDER_REAL_SANDBOX="${APP_BUILDER_REAL_SANDBOX:-}" \
      APP_BUILDER_HOSTED_ARTIFACT_PROOF="${APP_BUILDER_HOSTED_ARTIFACT_PROOF:-}" \
      APP_BUILDER_SANDBOX_IMAGE="${APP_BUILDER_SANDBOX_IMAGE:-}" \
      APP_BUILDER_IMAGE_NODE_BIN="${APP_BUILDER_IMAGE_NODE_BIN:-}" \
      APP_BUILDER_IMAGE_PNPM_BIN="${APP_BUILDER_IMAGE_PNPM_BIN:-}" \
      APP_BUILDER_IMAGE_DOCKER_BIN="${APP_BUILDER_IMAGE_DOCKER_BIN:-}" \
      APP_BUILDER_IMAGE_BUILDX_BIN="${APP_BUILDER_IMAGE_BUILDX_BIN:-}" \
      APP_BUILDER_IMAGE_MSB_BIN="${APP_BUILDER_IMAGE_MSB_BIN:-}" \
      APP_BUILDER_IMAGE_GH_BIN="${APP_BUILDER_IMAGE_GH_BIN:-}" \
      APP_BUILDER_DEV_NODE_BIN="${APP_BUILDER_DEV_NODE_BIN:-}" \
      APP_BUILDER_DEV_CODEX_BIN="${APP_BUILDER_DEV_CODEX_BIN:-}" \
      APP_BUILDER_DEV_CODEX_HOME="${APP_BUILDER_DEV_CODEX_HOME:-}" \
      APP_BUILDER_DEV_DOCKER_BIN="${APP_BUILDER_DEV_DOCKER_BIN:-}" \
      APP_BUILDER_DEV_BUILDX_BIN="${APP_BUILDER_DEV_BUILDX_BIN:-}" \
      APP_BUILDER_DEV_MSB_BIN="${APP_BUILDER_DEV_MSB_BIN:-}" \
      APP_BUILDER_DEV_RUNTIME_HOME="${APP_BUILDER_DEV_RUNTIME_HOME:-}" \
      APP_BUILDER_EXECUTION_MODE="${APP_BUILDER_EXECUTION_MODE:-}" \
      APP_BUILDER_DEVELOPMENT_SOURCE_FINGERPRINT="${APP_BUILDER_DEVELOPMENT_SOURCE_FINGERPRINT:-}" \
      APP_BUILDER_DEVELOPMENT_DEPENDENCY_KEY="${APP_BUILDER_DEVELOPMENT_DEPENDENCY_KEY:-}" \
      APP_BUILDER_RELEASE_NODE_BIN="${APP_BUILDER_RELEASE_NODE_BIN:-}" \
      APP_BUILDER_RELEASE_DOCKER_BIN="${APP_BUILDER_RELEASE_DOCKER_BIN:-}" \
      APP_BUILDER_RELEASE_BUILDX_BIN="${APP_BUILDER_RELEASE_BUILDX_BIN:-}" \
      APP_BUILDER_RELEASE_MSB_BIN="${APP_BUILDER_RELEASE_MSB_BIN:-}" \
      APP_BUILDER_RELEASE_GH_BIN="${APP_BUILDER_RELEASE_GH_BIN:-}" \
      APP_BUILDER_RELEASE_GITHUB_TOKEN="${APP_BUILDER_RELEASE_GITHUB_TOKEN:-}" \
      APP_BUILDER_RELEASE_VERCEL_BIN="${APP_BUILDER_RELEASE_VERCEL_BIN:-}" \
      APP_BUILDER_LOCAL_ADAPTER="${APP_BUILDER_LOCAL_ADAPTER:-}" \
      APP_BUILDER_GITHUB_PUBLICATION_ENABLED="${APP_BUILDER_GITHUB_PUBLICATION_ENABLED:-}" \
      APP_BUILDER_LOCAL_PROVIDER_EMULATION="${APP_BUILDER_LOCAL_PROVIDER_EMULATION:-}" \
      APP_BUILDER_LOCAL_AUTH_EMULATION="${APP_BUILDER_LOCAL_AUTH_EMULATION:-}" \
      APP_BUILDER_LOCAL_PORT="${APP_BUILDER_LOCAL_PORT:-}" \
      APP_BUILDER_DATABASE_PORT="${APP_BUILDER_DATABASE_PORT:-}" \
      APP_BUILDER_DATABASE_CONTAINER="${APP_BUILDER_DATABASE_CONTAINER:-}" \
      APP_BUILDER_EXTERNAL_DATABASE="${APP_BUILDER_EXTERNAL_DATABASE:-}" \
      APP_BUILDER_EXTERNAL_WEB_SERVER="${APP_BUILDER_EXTERNAL_WEB_SERVER:-}" \
      EMULATE_BASE_PORT="${EMULATE_BASE_PORT:-}" \
      VERCEL_EMULATOR_URL="${VERCEL_EMULATOR_URL:-}" \
      GITHUB_EMULATOR_URL="${GITHUB_EMULATOR_URL:-}" \
      EMULATE_PROVIDER_TOKEN="${EMULATE_PROVIDER_TOKEN:-}" \
      EMULATE_VERCEL_CONFIGURATION_ID="${EMULATE_VERCEL_CONFIGURATION_ID:-}" \
      EMULATE_VERCEL_TEAM_ID="${EMULATE_VERCEL_TEAM_ID:-}" \
      EMULATE_GITHUB_INSTALLATION_ID="${EMULATE_GITHUB_INSTALLATION_ID:-}" \
      EMULATE_GITHUB_REPOSITORY="${EMULATE_GITHUB_REPOSITORY:-}" \
      EMULATE_LOCAL_RELAY_SECRET="${EMULATE_LOCAL_RELAY_SECRET:-}" \
      EVE_HOSTED_ADAPTER="${EVE_HOSTED_ADAPTER:-}" \
      BETTER_AUTH_URL="${BETTER_AUTH_URL:-}" \
      MCP_RESOURCE_URL="${MCP_RESOURCE_URL:-}" \
      BETTER_AUTH_SECRET="${BETTER_AUTH_SECRET:-}" \
      PASSKEY_ONBOARDING="${PASSKEY_ONBOARDING:-}" \
      GITHUB_CLIENT_ID="${GITHUB_CLIENT_ID:-}" \
      GITHUB_CLIENT_SECRET="${GITHUB_CLIENT_SECRET:-}" \
      GITHUB_APP_ID="${GITHUB_APP_ID:-}" \
      GITHUB_APP_PRIVATE_KEY="${GITHUB_APP_PRIVATE_KEY:-}" \
      APP_BUILDER_TEMPLATE_READER_INSTALLATION_ID="${APP_BUILDER_TEMPLATE_READER_INSTALLATION_ID:-}" \
      GITHUB_APP_SLUG="${GITHUB_APP_SLUG:-}" \
      GITHUB_APP_CLIENT_ID="${GITHUB_APP_CLIENT_ID:-}" \
      GITHUB_APP_CLIENT_SECRET="${GITHUB_APP_CLIENT_SECRET:-}" \
      GITHUB_APP_INSTALL_STATE_SECRET="${GITHUB_APP_INSTALL_STATE_SECRET:-}" \
      VERCEL_AUTH_CLIENT_ID="${VERCEL_AUTH_CLIENT_ID:-}" \
      VERCEL_AUTH_CLIENT_SECRET="${VERCEL_AUTH_CLIENT_SECRET:-}" \
      VERCEL_INTEGRATION_SLUG="${VERCEL_INTEGRATION_SLUG:-}" \
      VERCEL_INTEGRATION_CLIENT_ID="${VERCEL_INTEGRATION_CLIENT_ID:-}" \
      VERCEL_INTEGRATION_CLIENT_SECRET="${VERCEL_INTEGRATION_CLIENT_SECRET:-}" \
      VERCEL_INTEGRATION_TOKEN_KEY="${VERCEL_INTEGRATION_TOKEN_KEY:-}" \
      VERCEL_INTEGRATION_TOKEN_KEY_VERSION="${VERCEL_INTEGRATION_TOKEN_KEY_VERSION:-}" \
      FLAGS="${FLAGS:-}" \
      FLAGS_SECRET="${FLAGS_SECRET:-}" \
      EVE_AGENT_HOST="${EVE_AGENT_HOST:-}" \
      REPOSITORY_LOCAL_ROOTS="${REPOSITORY_LOCAL_ROOTS:-}" \
      REPOSITORY_WORKSPACE_ROOT="${REPOSITORY_WORKSPACE_ROOT:-}" \
      "$executable" "$@" <&3 3<&- &
    child_pid=$!
    exec 3<&-
    trap 'kill -TERM "$child_pid" 2>/dev/null || true' HUP INT TERM
    set +e
    wait "$child_pid"
    status=$?
    set -e
    trap - HUP INT TERM
    exit "$status"
    ;;
esac
