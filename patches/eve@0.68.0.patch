+import { createRecoveryHistoryInterner } from "#execution/session/recovery-history-interning.js";
+import {
+  sessionCommandHookToken,
+  sessionInboxHookToken,
+} from "#execution/session-inbox/address.js";
+import { resolveTerminalCheckpointOwner, discoverOwnedRecoveryLineage, nativeRecoveryBoundary } from "#execution/session/recovery-owner-provenance.js";
+// Server-only native checkpoint inspection. This module never starts/resumes a run.
+// The caller MUST supply canonical ownership authorization; model/client IDs are
+// not authority. Payloads remain behind an in-process opaque handle.
+const payloads = new WeakMap();
+const lineagePreflights = new WeakMap();
+const isRecord = (value) => value !== null && typeof value === "object";
+const nativeFunction = (name) =>
+  String(name ?? "")
+    .split(/[/:#]/u)
+    .at(-1);
+const coordinates = (event, slot) => ({
+  eventId: event.eventId,
+  slot,
+  stepId: event.correlationId,
+});
+// Eve's vendored World index is type-only at runtime. Follow its native
+// slot-identity contract directly rather than importing a bundler chunk name.
+const nativeEventSlot = (eventId) => {
+  if (!/^evnt_[0-9]{26}$/u.test(eventId))
+    throw new Error("Native recovery event has no slot identity.");
+  const slot = Number(eventId.slice(5));
+  if (!Number.isSafeInteger(slot) || slot < 1)
+    throw new Error("Native recovery event has no slot identity.");
+  return slot;
+};
+const workflowPhases = new Set([
+  "empty",
+  "prepared",
+  "ui_previewed",
+  "ui_accepted",
+  "app_spec_accepted",
+  "dependencies_prepared",
+  "identity_resolved",
+  "planned",
+  "apply_failed",
+  "applied",
+  "validation_pending",
+  "validation_failed",
+  "validated",
+  "reviewed",
+  "publication_pending",
+  "publication_failed",
+  "published_local",
+  "branch_publication_pending",
+  "branch_publication_failed",
+  "published_branch_worktree",
+  "fresh_bootstrap_pending",
+  "fresh_bootstrap_failed",
+  "published_fresh_bootstrap",
+]);
+
+export function readTerminalRecoveryCandidate(handle) {
+  const payload = payloads.get(handle);
+  if (payload === undefined) throw new Error("Unknown private native recovery candidate.");
+  return payload;
+}
+
+/** Dependencies are native SDK operations, injectable for synthetic fixtures. */
+export function createTerminalRecoveryCandidateCollector(dependencies) { return createCandidateCollector(dependencies, resolveTerminalCheckpointOwner); }
+export function createOwnedLineagePreflightCollector(dependencies) {
+  const collect = createCandidateCollector(dependencies, discoverOwnedRecoveryLineage);
+  return async (input) => {
+    const result = await collect({ ...input, allowParked: true });
+    if (result.kind !== "candidate") return result;
+    const preflight = Object.freeze({ kind: "private-native-lineage-preflight", version: 1 });
+    lineagePreflights.set(preflight, result.candidate);
+    return { kind: "preflight", preflight };
+  };
+}
+export function readOwnedLineagePreflight(preflight) {
+  const candidate = lineagePreflights.get(preflight);
+  if (candidate === undefined) throw new Error("Unknown private native lineage preflight.");
+  return readTerminalRecoveryCandidate(candidate);
+}
+export async function reconcileOwnedLineagePreflight(preflight) {
+  const candidate = lineagePreflights.get(preflight);
