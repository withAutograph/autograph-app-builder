@@ -0,0 +1,36 @@
+import type { TerminalRecoveryAuthorityInput, TerminalRecoveryBinding, TerminalRecoveryDescriptor } from "#execution/session/terminal-recovery.js";
+export interface RecoveryHolderBindingFacts {
+  readonly operationFound: boolean | null;
+  readonly descriptorMatches: boolean | null;
+  readonly sourceBound: boolean | null;
+  readonly operationSucceeded: boolean | null;
+  readonly operationReserved: boolean | null;
+  readonly operationSubmissionUnknown: boolean | null;
+  readonly operationRejected: boolean | null;
+  readonly sourceCancelled: boolean | null;
+  readonly sourceCancellationMatches: boolean | null;
+  readonly receiptPresent: boolean | null;
+  readonly receiptOwnerMatches: boolean | null;
+  readonly committedChildMatches: boolean | null;
+}
+export interface RecoveryHolderBindingInput extends TerminalRecoveryAuthorityInput {
+  readonly holderOwnerRunId: string;
+  readonly holderDescriptor: TerminalRecoveryDescriptor;
+}
+export interface RecoveryHolderObservationInput extends TerminalRecoveryAuthorityInput {
+  readonly receipt: TerminalRecoveryBinding | null | undefined;
+  readonly ports: {
+    observeRecoveryHolderBinding?(input: RecoveryHolderBindingInput): Promise<RecoveryHolderBindingFacts | undefined>;
+  };
+  /** Current app authorization and exact unchanged canonical receipt; failures are never advisory. */
+  authorizeCurrent(): Promise<void>;
+}
+export interface RecoveryHolderObservationDependencies {
+  getHook(token: string): Promise<{ readonly runId: string; readonly metadata: Promise<unknown> }>;
+  isHookNotFound(error: unknown): boolean;
+  readRunEntry(ownerRunId: string): Promise<{ readonly runId: string; readonly status: string; readonly entry: unknown }>;
+  record(summary: Readonly<Record<string, unknown>>): void;
+  now(): number;
+}
+/** Read-only current logical inbox ownership diagnostic. No checkpoint or hook is changed. */
+export declare function observeRecoveryInboxHolder(input: RecoveryHolderObservationInput, dependencies?: RecoveryHolderObservationDependencies): Promise<void>;
