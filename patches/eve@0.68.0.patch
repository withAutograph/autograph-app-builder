+/** Advisory structural diagnostics. Inputs stay private; outputs contain counts and opaque identity hashes only. */
+export declare function protocolIdentityHash(value: unknown): string | undefined;
+export declare function summarizeModelProtocol(messages: unknown): object;
+export declare function recordModelProtocolDiagnostic(input: {
+  logicalSessionId: string;
+  turnId?: string;
+  sdkCallId?: string;
+  harnessAttempt: number;
+  harnessStep: number;
+  sdkCallIndex: number;
+  canonical: unknown;
+  sdkInput: unknown;
+  sdkBeforeProvider: unknown;
+}): void;
+export declare function recordRecoveryProtocolDiagnostic(input: {
+  sourceOwnerRunId: string;
+  logicalSessionId: string;
+  selectedStepId?: string;
+  selectedEventId?: string;
+  selectedKind?: string;
+  outcome: string;
+  reason?: string;
+  callId?: string;
