+          payload.nativeEvents.some(
+            (event) =>
+              event.type === "action.result" && event.data?.result?.callId === call.toolCallId,
+          ),
+        committed_result_present: () =>
+          observed.some((entry) => hasResult(entry.session.history, call.toolCallId)),
+        buffered_result_present: () =>
+          observed.some((entry) => hasResult(entry.buffered, call.toolCallId)),
+        incoming_result_present: () =>
+          observed.some((entry) =>
+            entry.candidate.incoming?.runtimeResults?.results.some(
+              (result) => result.callId === call.toolCallId,
+            ),
+          ),
+      });
+      return uncertain("cancelled-call-result-unreconciled", call.toolCallId);
+    }
+    const index = Math.min(...witnesses.map((witness) => witness.index));
+    const pending = insertions.get(index) ?? [];
+    pending.push({ callId: call.toolCallId, toolName: call.toolName });
+    insertions.set(index, pending);
+  }
+  if (insertions.size === 0) return { kind: "unchanged" };
+  const restored = [];
+  let offset = 0;
+  for (const [index, callsAtIndex] of [...insertions].sort(([left], [right]) => left - right)) {
+    restored.push(...history.slice(offset, index));
+    const settled = settleCancelledToolHistory(history.slice(0, index), callsAtIndex);
+    restored.push(...settled.slice(index));
+    offset = index;
+  }
+  restored.push(...history.slice(offset));
+  return { kind: "restored", history: restored };
+}
