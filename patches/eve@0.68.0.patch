+        try {
+          retained.output = history.checkpoint(await dependencies.hydrateStepReturnValue(step.output, run.runId, key));
+        } catch {
+          issues.push({ reason: "native-step-output-unreadable", stepId });
+        }
+      }
+      const completedTerminalError = name === "turnStep" && retained.output?.action === "done";
+      if (
+        step.input !== undefined &&
+        (name !== "turnStep" || step.status === "failed" || completedTerminalError)
+      ) {
+        try {
+          retained.arguments = history.stepArguments(await dependencies.hydrateStepArguments(step.input, run.runId, key));
+        } catch {
+          issues.push({ reason: "native-step-input-unreadable", stepId });
+        }
+      }
+      return retained;
+    };
+    const addCandidate = (kind, value, origin) => {
+      if (!isRecord(value) || !isRecord(value.serializedContext) || !isRecord(value.sessionState))
+        return;
+      let session;
+      try {
+        session = dependencies.readDurableSession(value.sessionState);
+      } catch {
+        return;
+      }
+      if (
+        session.sessionId !== binding.logicalSessionId ||
+        value.sessionState.sessionId !== binding.logicalSessionId ||
