+++ b/dist/src/execution/session/recovery-reconciliation.d.ts
@@ -0,0 +1,70 @@
+import type { SessionCheckpoint } from "#execution/session/handoff.js";
+import type { TurnStepPayload } from "#execution/session/turn-step-types.js";
+import type {
+  NativeRecoveryCandidateKind,
+  NativeRecoveryOrigin,
+  NativeRecoveryInboxEvent,
+  PrivateNativeRecoveryCandidate,
+} from "#execution/session/recovery-candidate.js";
+
+export interface NativeRecoveryReconciliationProvenance {
+  readonly version: 1;
+  readonly sourceOwnerRunId: string;
+  /** Physical namespace of every native origin/event coordinate below. */
+  readonly checkpointOwnerRunId: string;
+  readonly logicalSessionId: string;
+  /** The authoritative latest paired typed state; its grants are never replaced. */
+  readonly selectedOrigin: NativeRecoveryOrigin & { readonly kind: NativeRecoveryCandidateKind };
+  readonly historySourceOrigin?: NativeRecoveryOrigin & {
+    readonly kind: NativeRecoveryCandidateKind;
+  };
+  readonly incomingOrigin?: NativeRecoveryOrigin & { readonly kind: NativeRecoveryCandidateKind };
+  readonly coveredNativeEventIds: readonly string[];
+  /** Full later World frontier remains in the private collector payload. */
+  readonly frontierEventIds: readonly string[];
+  readonly nativeProtocolFactCount: number;
+  readonly reconstructedCoordination: boolean;
+}
+export type NativeRecoveryReconciliation =
+  | {
+      readonly kind: "ready";
+      /** Policy comes from the original native entry, hydrated by the boot consumer. */
+      readonly checkpointCore: Pick<SessionCheckpoint, "serializedContext" | "sessionState">;
+      /** Exact original typed incoming payload. Only the native owner may execute it. */
+      readonly replayInput?: TurnStepPayload;
+      readonly carriedInbox?: readonly NativeRecoveryInboxEvent[];
+      readonly provenance: NativeRecoveryReconciliationProvenance;
+    }
+  | {
+      readonly kind: "uncertain";
+      readonly reason:
+        | "native-stream-incomplete"
+        | "approval-transcript-unavailable"
+        | "conflicting-retained-history"
+        | "coordination-results-incomplete"
+        | "later-coordination-input-unreconciled"
+        | "runtime-result-consumption-ambiguous"
+        | "uncommitted-action-result"
+        | "uncommitted-action-dispatch"
+        | "failed-turn-effects-unreconciled"
+        | "delivery-consumption-unreconciled"
+        | "runtime-result-owner-unreconciled"
+        | "unreadable-native-effect-frontier"
+        | "unconsumed-native-inbox-input"
+        | "cancelled-turn-replay"
+        | "cancelled-call-history-unreconciled"
+        | "cancelled-call-result-unreconciled";
+      readonly callId?: string;
+    }
+  | {
+      readonly kind: "unavailable";
+      readonly reason:
+        | "paired-native-checkpoint-unavailable"
+        | "native-checkpoint-identity-mismatch";
+    };
+/** Pure native reconciliation. No emitter, authorizer, dispatcher, model, tool or provider execution. */
+export declare function reconcileTerminalRecoveryCandidate(
+  handle: PrivateNativeRecoveryCandidate,
+  options?: { readonly repeatableCallIds?: readonly string[] },
+): Promise<NativeRecoveryReconciliation>;
+
