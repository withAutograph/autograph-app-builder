--- /dev/null
+++ b/dist/src/execution/session/recovery-reconciliation.js
@@ -0,0 +1,597 @@
+import { activeTurnId } from "#harness/active-turn-id.js";
+import { decodeSessionInboxPayload } from "#execution/session-inbox/protocol.js";
+import { proposeRetrospectiveCancelledToolHistory } from "#execution/session/recovery-cancelled-tool-history.js";
+import { isCancelledToolHistoryResult } from "#harness/cancelled-tool-history.js";
+import { recordRecoveryProtocolDiagnostic } from "#harness/model-protocol-diagnostic.js";
+import { isDeepStrictEqual } from "node:util";
+import { readTerminalRecoveryCandidate } from "#execution/session/recovery-candidate.js";
+import {
+  readDurableSession,
+  replaceDurableSessionSnapshot,
+} from "#execution/durable-session-store.js";
+import { getPendingCoordinationBatch, setPendingCoordinationBatch } from "#harness/coordination.js";
+import { getPendingInputBatches } from "#harness/pending-input-batches.js";
+import { coalesceApprovalReplayTail } from "#harness/approval-coordination.js";
+import { resolveRuntimeActionResultsForCallIds } from "#runtime/actions/results.js";
+import { isResultBoundToRunningHandle } from "#subagents/handles/query.js";
+import {
+  sessionCommandHookToken,
+  sessionInboxHookToken,
+} from "#execution/session-inbox/address.js";
+
+const parts = (messages) =>
+  messages.flatMap((message) => (Array.isArray(message.content) ? message.content : []));
+const callIds = (messages, type) =>
+  new Set(
+    parts(messages)
+      .filter((part) => part.type === type)
+      .map((part) => part.toolCallId),
+  );
+const committedResultIds = (messages) =>
+  new Set(
+    parts(messages)
+      .filter((part) => part.type === "tool-result" && !isCancelledToolHistoryResult(part))
+      .map((part) => part.toolCallId),
+  );
+const origin = (candidate) => ({ ...candidate.origin, kind: candidate.kind });
+const prefix = (left, right) =>
+  left.length <= right.length &&
+  left.every((message, index) => isDeepStrictEqual(message, right[index]));
+const uncertain = (reason, callId) => ({
+  kind: "uncertain",
+  reason,
+  ...(callId === undefined ? {} : { callId }),
+});
+
+function retainedTranscript(session) {
+  const coordination = getPendingCoordinationBatch(session.state);
+  const pending = getPendingInputBatches(session.state);
+  return [
+    ...session.history,
+    ...(coordination?.responseMessages ?? []),
+    ...pending.flatMap((batch) => batch.responseMessages),
+  ];
+}
+function approvalTranscriptAvailable(session) {
+  const transcript = parts(retainedTranscript(session));
+  const requests = new Set(
+    transcript
+      .filter((part) => part.type === "tool-approval-request")
+      .map((part) => part.approvalId),
+  );
+  return transcript.every(
+    (part) => part.type !== "tool-approval-response" || requests.has(part.approvalId),
+  );
+}
+
+// Older mixed batches retained the original assistant transcript separately
+// while committing its approval response first. Move only the exact matching
+// response/denial parts after their original requests; preserve all other parts.
+function restoreCoordinationTranscript(session) {
+  const batch = getPendingCoordinationBatch(session.state);
+  if (batch === undefined || batch.responseMessages.length === 0)
+    return { session, restored: false };
+  const original = parts(batch.responseMessages);
+  const originalCalls = new Set(
+    original.filter((part) => part.type === "tool-call").map((part) => part.toolCallId),
+  );
+  const requests = new Set(
+    original.filter((part) => part.type === "tool-approval-request").map((part) => part.approvalId),
+  );
+  if ([...callIds(session.history, "tool-call")].some((id) => originalCalls.has(id)))
+    return undefined;
+  const before = [];
+  const responses = [];
+  for (const message of session.history) {
+    if (message.role !== "tool") {
+      before.push(message);
+      continue;
+    }
+    const moved = [];
+    const retained = [];
+    for (const part of message.content) {
+      const belongs =
+        (part.type === "tool-approval-response" && requests.has(part.approvalId)) ||
+        (part.type === "tool-result" &&
+          originalCalls.has(part.toolCallId) &&
+          part.output?.type === "execution-denied");
+      (belongs ? moved : retained).push(part);
+    }
+    if (retained.length > 0) before.push({ ...message, content: retained });
+    if (moved.length > 0) responses.push({ ...message, content: moved });
+  }
+  const history = coalesceApprovalReplayTail([...before, ...batch.responseMessages, ...responses]);
+  return {
+    session: setPendingCoordinationBatch({
+      ...batch,
+      responseMessages: [],
+      session: { ...session, history },
+    }),
+    restored: true,
+  };
+}
+
+function afterInput(event, source) {
+  const data = event.data ?? {};
+  const emission = source.sessionState.emissionState;
+  if (typeof data.sequence !== "number" || typeof data.stepIndex !== "number") return true;
+  return (
+    data.sequence > emission.sequence ||
+    (data.sequence === emission.sequence && data.stepIndex >= emission.stepIndex)
+  );
+}
+function isRestorableTerminalInboxPayload(payload, sourceTurnId) {
+  let decoded;
+  try {
+    decoded = decodeSessionInboxPayload(payload);
+  } catch {
+    return false;
+  }
+  if (decoded.kind === "cancel") {
+    return (
+      typeof decoded.turnId === "string" &&
+      decoded.turnId === sourceTurnId &&
+      Object.keys(decoded).every((key) => ["kind", "turnId"].includes(key))
+    );
+  }
+  return decoded.kind === "deliver";
+}
+
+function retainedInboxSuffix(payload, latest) {
+  const retained = payload.carriedInbox ?? [];
+  // A later authored step may already have admitted an envelope without a
+  // committed checkpoint. Keep that ambiguity; never submit it twice.
+  if (
+    retained.length > 0 &&
+    payload.events.some(
+      (event) =>
+        event.eventType.startsWith("step_") && Number(event.eventId.slice(5)) > retained[0].slot,
+    )
+  )
+    return;
+  const ids = new Set();
+  const command = sessionCommandHookToken(payload.binding.logicalSessionId);
+  const session = readDurableSession(latest.sessionState);
+  const tokens = new Set([command, sessionInboxHookToken(command)]);
+  if (typeof session.continuationToken === "string" && session.continuationToken.length > 0) {
+    tokens.add(session.continuationToken);
+    tokens.add(sessionInboxHookToken(session.continuationToken));
+  }
+  const hooks = new Map(
+    payload.events
+      .filter((event) => event.eventType === "hook_created")
+      .map((event) => [event.correlationId, event.eventData?.token]),
+  );
+  for (const item of retained) {
+    const event = payload.events.find((value) => value.eventId === item.eventId);
+    if (
+      event === undefined ||
+      event.eventType !== "hook_received" ||
+      event.runId !== payload.checkpointOwnerRunId ||
+      item.runId !== event.runId ||
+      event.correlationId !== item.correlationId ||
+      Number(event.eventId.slice(5)) !== item.slot ||
+      item.slot <= latest.origin.slot ||
+      ids.has(item.eventId) ||
+      !tokens.has(event.eventData?.token ?? hooks.get(event.correlationId))
+    )
+      return;
+    if (
+      !isRestorableTerminalInboxPayload(
+        item.payload,
+        activeTurnId(latest.sessionState.emissionState),
+      )
+    )
+      return;
+    ids.add(item.eventId);
+  }
+  if (retained.some((item, index) => index > 0 && item.slot <= retained[index - 1].slot)) return;
+  return { entries: retained, ids };
+}
+
+function assessEffects(payload, source, session, incoming, carriedInboxIds) {
+  if (payload.issues.some((issue) => issue.reason === "native-stream-incomplete"))
+    return uncertain("native-stream-incomplete");
+  // A failed turn has no committed authored-state return. A finalizer input
+  // merely preserves its pre-step cursor; it cannot certify those effects.
+  for (const issue of payload.issues) {
+    if (issue.reason !== "failed-turn-effects-unreconciled") continue;
+    const terminal = payload.events.find(
+      (event) => event.correlationId === issue.stepId && event.eventType === "step_failed",
+    );
+    const slot = terminal === undefined ? undefined : Number(terminal.eventId.slice(5));
+    const subsequentlyCommitted =
+      slot !== undefined &&
+      payload.candidates.some(
+        (candidate) => candidate.kind === "committed-turn-output" && candidate.origin.slot > slot,
+      );
+    if (!subsequentlyCommitted) return uncertain("failed-turn-effects-unreconciled");
+  }
+  // A readable later pair covers an earlier completed native step; a
+  // decode failure beyond that pair still leaves its actual effects unknown.
+  const latestSlot = Math.max(...payload.candidates.map((candidate) => candidate.origin.slot));
+  for (const issue of payload.issues) {
+    if (
+      issue.reason !== "native-step-input-unreadable" &&
+      issue.reason !== "native-step-output-unreadable"
+    )
+      continue;
+    const related = payload.events.filter((event) => event.correlationId === issue.stepId);
+    if (
+      related.length === 0 ||
+      related.some((event) => Number(event.eventId.slice(5)) > latestSlot)
+    )
+      return uncertain("unreadable-native-effect-frontier");
+  }
+  // Do not discard an accepted command that arrived after the original
+  // incoming payload. Other hooks remain ordinary preserved frontier facts.
+  const command = sessionCommandHookToken(payload.binding.logicalSessionId);
+  const inboxTokens = new Set([
+    command,
+    sessionInboxHookToken(command),
+    session.continuationToken,
+    sessionInboxHookToken(session.continuationToken),
+  ]);
+  const hookTokens = new Map(
+    payload.events
+      .filter((event) => event.eventType === "hook_created")
+      .map((event) => [event.correlationId, event.eventData?.token]),
+  );
+  for (const event of payload.events) {
+    if (event.eventType !== "hook_received" || Number(event.eventId.slice(5)) <= source.origin.slot)
+      continue;
+    if (
+      inboxTokens.has(event.eventData?.token ?? hookTokens.get(event.correlationId)) &&
+      !carriedInboxIds?.has(event.eventId)
+    )
+      return uncertain("unconsumed-native-inbox-input");
+  }
+  const committedResults = committedResultIds(session.history);
+  const pendingHumanInput = new Set(
+    getPendingInputBatches(session.state).flatMap((batch) =>
+      batch.requests.map((request) => request.action?.callId).filter(Boolean),
+    ),
+  );
+  const received = new Map(
+    (incoming?.runtimeResults?.results ?? []).map((result) => [result.callId, result]),
+  );
+  for (const event of payload.nativeEvents) {
+    if (!afterInput(event, source)) continue;
+    if (
+      event.type === "turn.cancelled" &&
+      (event.data?.sequence === undefined ||
+        event.data.sequence >= source.sessionState.emissionState.sequence)
+    )
+      return uncertain("cancelled-turn-replay");
+    if (event.type === "action.result") {
+      const result = event.data?.result;
+      if (result === undefined || typeof result.callId !== "string") continue;
+      if (
+        committedResults.has(result.callId) ||
+        isDeepStrictEqual(received.get(result.callId), result)
+      )
+        continue;
+      // An emitted result is not an authored-state commit. Never execute its
+      // call again merely because the terminal transcript lost that output.
+      return uncertain("uncommitted-action-result", result.callId);
+    }
+    if (event.type === "actions.requested")
+      for (const action of event.data?.actions ?? []) {
+        if (
+          typeof action.callId !== "string" ||
+          committedResults.has(action.callId) ||
+          pendingHumanInput.has(action.callId) ||
+          received.has(action.callId)
+        )
+          continue;
+        return uncertain("uncommitted-action-dispatch", action.callId);
+      }
+  }
+}
+
+function assessProtocolCompletion(payload, session) {
+  const transcript = parts(session.history);
+  const results = callIds(session.history, "tool-result");
+  const requests = new Map(
+    transcript
+      .filter((part) => part.type === "tool-approval-request")
+      .map((part) => [part.approvalId, part.toolCallId]),
+  );
+  const tail = session.history.at(-1);
+  const replayable = new Set(
+    (tail?.role === "tool" ? parts([tail]) : [])
+      .filter((part) => part.type === "tool-approval-response")
+      .map((part) => requests.get(part.approvalId)),
+  );
+  const pendingInput = new Set(
+    getPendingInputBatches(session.state).flatMap((batch) =>
+      batch.requests.map((request) => request.action?.callId),
+    ),
+  );
+  const coordination = getPendingCoordinationBatch(session.state);
+  const pendingCoordination = new Set(
+    coordination === undefined
+      ? []
+      : [...coordination.runtimeActions, ...coordination.tasks].map((action) => action.callId),
+  );
+  const emittedResults = new Set(
+    payload.nativeEvents
+      .filter((event) => event.type === "action.result")
+      .map((event) => event.data?.result?.callId),
+  );
+  for (const call of transcript) {
+    if (call.type !== "tool-call" || call.providerExecuted === true || results.has(call.toolCallId))
+      continue;
+    if (pendingInput.has(call.toolCallId) || pendingCoordination.has(call.toolCallId)) continue;
+    // An emitted native result cannot be converted into an authored commit or
+    // permission to reexecute an already completed action.
+    if (emittedResults.has(call.toolCallId))
+      return uncertain("uncommitted-action-result", call.toolCallId);
+    if (replayable.has(call.toolCallId)) continue;
+    return uncertain("uncommitted-action-dispatch", call.toolCallId);
+  }
+}
+
+// App-owned repeatability authorizes retry of this exact call, not a claim
+// that an earlier attempt had no effects. Genuine results remain authoritative.
+function restoreRepeatableApprovalTail(session, repeatableCallIds, replayInput) {
+  const transcript = parts(session.history);
+  const results = callIds(session.history, "tool-result");
+  const selected = new Set();
+  for (const id of new Set(repeatableCallIds ?? [])) {
+    if (typeof id !== "string" || results.has(id)) continue;
+    const calls = transcript.filter((part) => part.type === "tool-call" && part.toolCallId === id);
+    const requests = transcript.filter(
+      (part) => part.type === "tool-approval-request" && part.toolCallId === id,
+    );
+    if (calls.length !== 1 || calls[0].providerExecuted === true || requests.length !== 1) continue;
+    const request = requests[0];
+    const responses = transcript.filter(
+      (part) => part.type === "tool-approval-response" && part.approvalId === request.approvalId,
+    );
+    const bindings = transcript.filter(
+      (part) => part.type === "tool-approval-request" && part.approvalId === request.approvalId,
+    );
+    if (bindings.length !== 1 || responses.length !== 1 || responses[0].approved !== true) continue;
+    const tail = session.history.at(-1);
+    if (tail?.role === "tool" && tail.content.includes(responses[0])) continue;
+    // Accepted input/pending work must retain the normal settlement owner.
+    if (
+      replayInput !== undefined ||
+      getPendingInputBatches(session.state).length > 0 ||
+      getPendingCoordinationBatch(session.state) !== undefined
+    )
+      continue;
+    selected.add(responses[0]);
+  }
+  if (selected.size === 0) return session;
+  const retained = [];
+  const moved = [];
+  for (const message of session.history) {
+    if (message.role !== "tool" || !Array.isArray(message.content)) {
+      retained.push(message);
+      continue;
+    }
+    const remaining = message.content.filter((part) => !selected.has(part));
+    const responses = message.content.filter((part) => selected.has(part));
+    if (responses.length === 0) retained.push(message);
+    else {
+      if (remaining.length > 0) retained.push({ ...message, content: remaining });
+      moved.push({ ...message, content: responses });
+    }
+  }
+  return { ...session, history: coalesceApprovalReplayTail([...retained, ...moved]) };
+}
+
+/** All values remain private. Original native reducers run only after boot. */
+async function reconcileCandidate(handle, options) {
+  const payload = readTerminalRecoveryCandidate(handle);
+  const candidates = [...payload.candidates].sort(
+    (left, right) => right.origin.slot - left.origin.slot,
+  );
+  if (candidates.length === 0)
+    return { kind: "unavailable", reason: "paired-native-checkpoint-unavailable" };
+  const latest = candidates[0];
+  const latestSession = readDurableSession(latest.sessionState);
+  for (const candidate of candidates) {
+    const session = readDurableSession(candidate.sessionState);
+    if (
+      session.sessionId !== payload.binding.logicalSessionId ||
+      candidate.sessionState.sessionId !== session.sessionId ||
+      candidate.serializedContext["eve.sessionId"] !== session.sessionId
+    )
+      return { kind: "unavailable", reason: "native-checkpoint-identity-mismatch" };
+  }
+  let session = latestSession;
+  let historySource = latest;
+  let incomingSource;
+  let replayInput;
+  let reconstructedCoordination = false;
+  const sourceInputs = candidates.filter((candidate) => candidate.incoming !== undefined);
+  // Prefer an actual terminal input whose retained coordination transcript was
+  // dropped by its completed error output. Its actual incoming outcomes remain
+  // native facts, not a reconstructed tool result or a new approval.
+  const source = sourceInputs.find((candidate) => {
+    const before = readDurableSession(candidate.sessionState);
+    const batch = getPendingCoordinationBatch(before.state);
+    return (
+      batch !== undefined &&
+      batch.responseMessages.length > 0 &&
+      [...callIds(batch.responseMessages, "tool-call")].some(
+        (id) => !callIds(latestSession.history, "tool-call").has(id),
+      )
+    );
+  });
+  if (source !== undefined) {
+    const before = readDurableSession(source.sessionState);
+    const restored = restoreCoordinationTranscript(before);
+    if (restored === undefined) return uncertain("conflicting-retained-history");
+    let history;
+    if (prefix(before.history, latestSession.history))
+      history = [
+        ...restored.session.history,
+        ...latestSession.history.slice(before.history.length),
+      ];
+    else if (prefix(latestSession.history, before.history)) history = restored.session.history;
+    else return uncertain("conflicting-retained-history");
+    // The latest authoritative pair may already have admitted this delivery.
+    // Runtime outcomes have exact call identity; user/auth deliveries require
+    // their own consumption proof and are never blindly submitted twice.
+    if (source.incoming.delivery !== undefined && source !== latest)
+      return uncertain("delivery-consumption-unreconciled");
+    const batch = getPendingCoordinationBatch(restored.session.state);
+    const expected = [...batch.runtimeActions, ...batch.tasks].map((call) => call.callId);
+    const actual = source.incoming.runtimeResults?.results ?? [];
+    const results = resolveRuntimeActionResultsForCallIds({
+      pendingCallIds: expected,
+      results: actual.filter((result) => isResultBoundToRunningHandle(before.state, result)),
+    });
+    if (expected.length > 0 && results === undefined)
+      return uncertain("coordination-results-incomplete");
+    if (actual.some((result) => !isResultBoundToRunningHandle(latestSession.state, result)))
+      return uncertain("runtime-result-owner-unreconciled");
+    const existing = getPendingCoordinationBatch(latestSession.state);
+    if (
+      existing !== undefined &&
+      !isDeepStrictEqual(existing, getPendingCoordinationBatch(before.state))
+    )
+      return uncertain("later-coordination-input-unreconciled");
+    const alreadyRecorded = committedResultIds(latestSession.history);
+    const recordedCount = expected.filter((id) => alreadyRecorded.has(id)).length;
+    if (recordedCount !== 0 && recordedCount !== expected.length)
+      return uncertain("runtime-result-consumption-ambiguous");
+    session = { ...latestSession, history: coalesceApprovalReplayTail(history) };
+    if (recordedCount === 0) {
+      session = setPendingCoordinationBatch({ ...batch, session });
+      replayInput = source.incoming;
+      reconstructedCoordination = true;
+    } else {
+      const { runtimeResults: consumed, ...remaining } = source.incoming;
+      if (Object.keys(remaining).length > 0) replayInput = remaining;
+    }
+    historySource = source;
+    incomingSource = source;
+  } else {
+    const restored = restoreCoordinationTranscript(session);
+    if (restored === undefined) return uncertain("conflicting-retained-history");
+    session = restored.session;
+    reconstructedCoordination = restored.restored;
+    // The input paired with an uncommitted/terminal turn is replayed only when
+    // the latest retained state is that exact input, not a later committed state.
+    if (latest.incoming !== undefined) {
+      replayInput = latest.incoming;
+      incomingSource = latest;
+    }
+  }
+  if (!approvalTranscriptAvailable(session)) return uncertain("approval-transcript-unavailable");
+  // Protocol closure is not an authored effect commit. Inspect the complete
+  // retained frontier, including outcomes older than the selected input.
+  const cancelledCallIds = new Set(
+    parts(session.history)
+      .filter(isCancelledToolHistoryResult)
+      .map((part) => part.toolCallId),
+  );
+  for (const event of payload.nativeEvents) {
+    const callId = event.type === "action.result" ? event.data?.result?.callId : undefined;
+    if (cancelledCallIds.has(callId))
+      return uncertain("cancelled-call-result-unreconciled", callId);
+  }
+  for (const candidate of candidates) {
+    for (const result of candidate.incoming?.runtimeResults?.results ?? []) {
+      if (cancelledCallIds.has(result.callId))
+        return uncertain("cancelled-call-result-unreconciled", result.callId);
+    }
+  }
+  const carriedInbox = retainedInboxSuffix(payload, latest);
+  const effectUncertainty = assessEffects(
+    payload,
+    historySource,
+    session,
+    incomingSource?.incoming,
+    carriedInbox?.ids,
+  );
+  if (effectUncertainty !== undefined) return effectUncertainty;
+  if (carriedInbox === undefined) return uncertain("unconsumed-native-inbox-input");
+  const cancelledHistory = proposeRetrospectiveCancelledToolHistory(payload, latest, session);
+  if (cancelledHistory.kind === "uncertain") return cancelledHistory;
+  if (cancelledHistory.kind === "restored")
+    session = { ...session, history: cancelledHistory.history };
+  session = restoreRepeatableApprovalTail(session, options.repeatableCallIds, replayInput);
+  const protocolUncertainty = assessProtocolCompletion(payload, session);
+  if (protocolUncertainty !== undefined) return protocolUncertainty;
+  const frontier = payload.events.filter(
+    (event) => Number(event.eventId.slice(5)) > historySource.origin.slot,
+  );
+  return {
+    kind: "ready",
+    checkpointCore: {
+      serializedContext: latest.serializedContext,
+      sessionState:
+        session === latestSession
+          ? latest.sessionState
+          : replaceDurableSessionSnapshot({ session, state: latest.sessionState }),
+    },
+    ...(replayInput === undefined ? {} : { replayInput }),
+    ...(carriedInbox.entries.length === 0 ? {} : { carriedInbox: carriedInbox.entries }),
+    provenance: {
+      version: 1,
+      sourceOwnerRunId: payload.binding.ownerRunId,
+      checkpointOwnerRunId: payload.checkpointOwnerRunId,
+      logicalSessionId: payload.binding.logicalSessionId,
+      selectedOrigin: origin(latest),
+      ...(historySource === latest ? {} : { historySourceOrigin: origin(historySource) }),
+      ...(incomingSource === undefined ? {} : { incomingOrigin: origin(incomingSource) }),
+      coveredNativeEventIds: payload.events
+        .filter((event) => Number(event.eventId.slice(5)) <= latest.origin.slot)
+        .map((event) => event.eventId),
+      frontierEventIds: frontier.map((event) => event.eventId),
+      nativeProtocolFactCount: payload.nativeEvents.length,
+      reconstructedCoordination,
+    },
+  };
+}
+
+export async function reconcileTerminalRecoveryCandidate(handle, options = {}) {
+  const result = await reconcileCandidate(handle, options);
+  try {
+    const payload = readTerminalRecoveryCandidate(handle);
+    const latest = [...payload.candidates].sort(
+      (left, right) => right.origin.slot - left.origin.slot,
+    )[0];
+    const latestSession =
+      latest === undefined ? undefined : readDurableSession(latest.sessionState);
+    recordRecoveryProtocolDiagnostic({
+      sourceOwnerRunId: payload.binding.ownerRunId,
+      logicalSessionId: payload.binding.logicalSessionId,
+      selectedStepId: latest?.origin.stepId,
+      selectedEventId: latest?.origin.eventId,
+      selectedKind: latest?.kind,
+      selectedEmission: latest?.sessionState.emissionState,
+      nativeEventCount: payload.events.length,
+      maxNativeSlot: payload.events.reduce(
+        (max, event) => Math.max(max, Number(event.eventId.slice(5))),
+        0,
+      ),
+      outcome: result.kind,
+      reason: result.reason,
+      callId: result.callId,
+      reconstructedCoordination: result.provenance?.reconstructedCoordination,
+      incomingRuntimeResultCount: result.replayInput?.runtimeResults?.results?.length ?? 0,
+      latest: latestSession?.history ?? [],
+      latestCoordination:
+        latestSession === undefined
+          ? []
+          : (getPendingCoordinationBatch(latestSession.state)?.responseMessages ?? []),
+      latestPendingInput:
+        latestSession === undefined
+          ? []
+          : getPendingInputBatches(latestSession.state).flatMap((batch) => batch.responseMessages),
+      nativeEvents: payload.nativeEvents,
+      reconciled:
+        result.kind === "ready"
+          ? readDurableSession(result.checkpointCore.sessionState).history
+          : [],
+    });
+  } catch {}
+  return result;
+}
