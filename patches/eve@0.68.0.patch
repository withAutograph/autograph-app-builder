+import { isDeepStrictEqual } from "node:util";
+import { readDurableSession } from "#execution/durable-session-store.js";
+import { getPendingCoordinationBatch, resolveToolCallInputObject } from "#harness/coordination.js";
+import { getPendingInputBatches } from "#harness/pending-input-batches.js";
+import { getBlockingWorkflowToolRuns } from "#harness/workflow-tool-runs.js";
+import { settleCancelledToolHistory } from "#harness/cancelled-tool-history.js";
+import { protocolIdentityHash } from "#harness/model-protocol-diagnostic.js";
+import { createLogger } from "#internal/logging.js";
+
+const log = createLogger("harness.model-protocol");
+// Advisory diagnostics run only after an unchanged refusal predicate succeeds.
+// Each name is static; no retained input or error value enters this event.
+const recordRefusal = (stage, callId, guards) => {
+  try {
+    const failed = [];
+    const unreadable = [];
+    for (const [name, evaluate] of Object.entries(guards)) {
+      try {
+        if (evaluate()) failed.push(name);
+      } catch {
+        unreadable.push(name);
+      }
+    }
+    log.info(
+      `recovery-cancelled-history ${JSON.stringify({
+        version: 1,
+        stage,
+        callIdHash: protocolIdentityHash(callId),
+        failed,
+        unreadable,
+      })}`,
+    );
+  } catch {}
+};
+
+const parts = (messages) =>
+  messages.flatMap((message) => (Array.isArray(message.content) ? message.content : []));
+const assistantCalls = (history, callId) =>
+  history.flatMap((message) =>
+    message.role === "assistant" && Array.isArray(message.content)
+      ? message.content.filter((part) => part.type === "tool-call" && part.toolCallId === callId)
+      : [],
+  );
+const prefix = (earlier, later) =>
+  earlier.length <= later.length &&
+  earlier.every((message, index) => isDeepStrictEqual(message, later[index]));
+const uncertain = (reason, callId) => ({
+  kind: "uncertain",
+  reason,
+  ...(callId === undefined ? {} : { callId }),
+});
+const activeTurn = (emission) =>
+  emission.turnId === "" ? `turn_${emission.sequence}` : emission.turnId;
+const nameOf = (action) => (action.kind === "load-skill" ? "load_skill" : action.toolName);
+const hasResult = (messages, callId) =>
+  parts(messages).some((part) => part.type === "tool-result" && part.toolCallId === callId);
+const sameInput = (action, call) => {
+  try {
+    return isDeepStrictEqual(
+      action.input,
+      resolveToolCallInputObject(call.input, { callId: call.toolCallId, toolName: call.toolName }),
+    );
+  } catch {
+    return false;
+  }
+};
+
+function inspectCandidate(candidate, logicalSessionId) {
+  const session = readDurableSession(candidate.sessionState);
+  if (
+    session.sessionId !== logicalSessionId ||
+    candidate.sessionState.sessionId !== logicalSessionId ||
+    candidate.serializedContext["eve.sessionId"] !== logicalSessionId
+  )
+    return;
+  const pending = getPendingCoordinationBatch(session.state);
+  const blocking = getBlockingWorkflowToolRuns(session.state);
+  const buffered = [
+    ...(pending?.responseMessages ?? []),
+    ...getPendingInputBatches(session.state).flatMap((batch) => batch.responseMessages),
+  ];
+  return { candidate, session, pending, blocking, buffered };
+}
+
+function witnessFor(observed, call, latestHistory, latestEmission, nativeEvents) {
+  const { candidate, session, pending, blocking } = observed;
+  const emission = candidate.sessionState.emissionState;
+  const turnId = activeTurn(emission);
+  const runs = blocking.filter((run) => run.callId === call.toolCallId);
+  const actions = [...(pending?.runtimeActions ?? []), ...(pending?.tasks ?? [])].filter(
+    (action) => action.callId === call.toolCallId,
+  );
+  if (runs.length === 0 && actions.length === 0) return { kind: "absent" };
+  if (
+    runs.length > 1 ||
+    actions.length > 1 ||
+    runs.some(
+      (run) =>
+        run.toolName !== call.toolName ||
+        run.origin.turnId !== turnId ||
+        run.origin.stepIndex > emission.stepIndex,
+    ) ||
+    actions.some((action) => nameOf(action) !== call.toolName || !sameInput(action, call)) ||
+    (actions.length > 0 &&
+      (pending.event.turnId !== turnId ||
+        pending.event.sequence !== emission.sequence ||
+        pending.event.stepIndex > emission.stepIndex)) ||
+    (runs.length > 0 && actions.length > 0 && runs[0].origin.stepIndex !== pending.event.stepIndex)
+  ) {
+    recordRefusal("witness_ownership", call.toolCallId, {
+      multiple_blocking_runs: () => runs.length > 1,
+      multiple_actions: () => actions.length > 1,
+      blocking_name_mismatch: () => runs.some((run) => run.toolName !== call.toolName),
+      blocking_turn_mismatch: () => runs.some((run) => run.origin.turnId !== turnId),
+      blocking_step_after_emission: () =>
+        runs.some((run) => run.origin.stepIndex > emission.stepIndex),
+      action_name_mismatch: () => actions.some((action) => nameOf(action) !== call.toolName),
+      action_input_mismatch: () => actions.some((action) => !sameInput(action, call)),
+      coordination_turn_mismatch: () => actions.length > 0 && pending.event.turnId !== turnId,
+      coordination_sequence_mismatch: () =>
+        actions.length > 0 && pending.event.sequence !== emission.sequence,
+      coordination_step_after_emission: () =>
+        actions.length > 0 && pending.event.stepIndex > emission.stepIndex,
+      blocking_coordination_step_mismatch: () =>
+        runs.length > 0 &&
+        actions.length > 0 &&
+        runs[0].origin.stepIndex !== pending.event.stepIndex,
+    });
+    return { kind: "ambiguous" };
+  }
+  const cancellations = nativeEvents.flatMap((event, index) =>
+    event.type === "turn.cancelled" && event.data?.turnId === turnId ? [{ event, index }] : [],
+  );
+  if (cancellations.some(({ event }) => event.data.sequence !== emission.sequence)) {
+    recordRefusal("cancellation", call.toolCallId, { cancellation_sequence_mismatch: () => true });
+    return { kind: "ambiguous" };
+  }
+  if (cancellations.length === 0 || latestEmission.sequence <= emission.sequence)
+    return { kind: "absent" };
+  const requested = nativeEvents.flatMap((event, index) =>
+    event.type === "actions.requested" &&
+    event.data?.actions?.some((action) => action.callId === call.toolCallId)
+      ? [{ event, index }]
+      : [],
+  );
+  const stepIndex = actions.length > 0 ? pending.event.stepIndex : runs[0].origin.stepIndex;
+  if (
+    requested.some(
+      ({ event }) =>
+        event.data.turnId !== turnId ||
+        event.data.sequence !== emission.sequence ||
+        event.data.stepIndex !== stepIndex,
+    ) ||
+    (requested.length > 0 &&
+      !cancellations.some(
+        ({ index }) => index > Math.max(...requested.map((request) => request.index)),
+      ))
+  ) {
+    recordRefusal("requested_coordinates", call.toolCallId, {
+      requested_turn_mismatch: () => requested.some(({ event }) => event.data.turnId !== turnId),
+      requested_sequence_mismatch: () =>
+        requested.some(({ event }) => event.data.sequence !== emission.sequence),
+      requested_step_mismatch: () =>
+        requested.some(({ event }) => event.data.stepIndex !== stepIndex),
+      cancellation_not_after_request: () =>
+        requested.length > 0 &&
+        !cancellations.some(
+          ({ index }) => index > Math.max(...requested.map((request) => request.index)),
+        ),
+    });
+    return { kind: "ambiguous" };
+  }
+  // A coordination transcript can have been buffered before its exact assistant
+  // call entered committed history. It is usable only as the same latest prefix.
+  let history = session.history;
+  if (assistantCalls(history, call.toolCallId).length === 0)
+    history = [...history, ...(pending?.responseMessages ?? [])];
+  const calls = assistantCalls(history, call.toolCallId);
+  // An earlier prefix without the call cannot witness its interruption.
+  if (calls.length === 0 && prefix(history, latestHistory)) return { kind: "absent" };
+  if (calls.length !== 1 || !isDeepStrictEqual(calls[0], call) || !prefix(history, latestHistory)) {
+    recordRefusal("witness_history", call.toolCallId, {
+      history_call_count: () => calls.length !== 1,
+      history_call_mismatch: () => !isDeepStrictEqual(calls[0], call),
+      history_prefix_mismatch: () => !prefix(history, latestHistory),
+    });
+    return { kind: "ambiguous" };
+  }
+  return {
+    kind: "witness",
+    index: history.length,
+    turnId,
+    sequence: emission.sequence,
+    address: runs[0]?.address,
+  };
+}
+
+/**
+ * Pure history proposal after the caller has proved the physical leaf and run
+ * the ordinary effect-frontier assessment. No result here certifies effects,
+ * authorizes replay, or changes latest state, context, receipts, or input.
+ */
+export function proposeRetrospectiveCancelledToolHistory(payload, latestCandidate, latestSession) {
+  const logicalSessionId = payload.binding.logicalSessionId;
+  const checkpointOwnerRunId = payload.checkpointOwnerRunId ?? payload.run.runId;
+  if (
+    payload.run.runId !== checkpointOwnerRunId ||
+    payload.events.some((event) => event.runId !== checkpointOwnerRunId) ||
+    !payload.candidates.includes(latestCandidate) ||
+    latestSession.sessionId !== logicalSessionId
+  ) {
+    recordRefusal("payload_identity", undefined, {
+      checkpoint_owner_mismatch: () => payload.run.runId !== checkpointOwnerRunId,
+      event_owner_mismatch: () =>
+        payload.events.some((event) => event.runId !== checkpointOwnerRunId),
+      latest_candidate_missing: () => !payload.candidates.includes(latestCandidate),
+      latest_session_mismatch: () => latestSession.sessionId !== logicalSessionId,
+    });
+    return uncertain("cancelled-call-history-unreconciled");
+  }
+  let observed;
+  try {
+    observed = payload.candidates.map((candidate) => inspectCandidate(candidate, logicalSessionId));
+  } catch {
+    recordRefusal("candidate_read", undefined, { candidate_unreadable: () => true });
+    return uncertain("cancelled-call-history-unreconciled");
+  }
+  if (observed.some((candidate) => candidate === undefined)) {
+    recordRefusal("candidate_identity", undefined, {
+      candidate_logical_identity_mismatch: () => true,
+    });
+    return uncertain("cancelled-call-history-unreconciled");
+  }
+  const latest = observed.find((entry) => entry.candidate === latestCandidate);
+  if (latest === undefined) {
+    recordRefusal("latest_candidate", undefined, { latest_candidate_missing: () => true });
