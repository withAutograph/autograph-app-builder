+++ b/dist/src/execution/session/terminal-recovery.d.ts
@@ -0,0 +1,97 @@
+import type { SessionAuthContext } from "#channel/types.js";
+import type { SessionCheckpoint } from "#execution/session/handoff.js";
+import type { TerminalRecoveryWorkflowEntryInput } from "#execution/session/entry-input.js";
+import type { PrivateNativeRecoveryCandidate, PrivateNativeRecoveryPayload, CollectTerminalRecoveryCandidateInput, TerminalRecoveryCandidateResult } from "#execution/session/recovery-candidate.js";
+
+export interface TerminalRecoveryDescriptor {
+  readonly version: 1;
+  readonly operationId: string;
+  readonly sourcePublicSessionId: string;
+  readonly sourceOwnerRunId: string;
+  readonly sourceAdapterGeneration: number;
+  readonly logicalSessionId: string;
+  readonly originalAuthoritySessionId: string;
+  readonly parentCancellationRevision: number;
+  readonly sourceHandoffId?: string;
+}
+export interface TerminalRecoveryProvenance {
+  readonly kind: "terminal-finalizer-input" | "completed-terminal-turn-input" | "failed-turn-input" | "committed-turn-output";
+  readonly sourceStepId: string;
+  readonly sourceEventId: string;
+  readonly sourceSlot: number;
+  readonly checkpointVersion: 1;
+}
+export interface TerminalRecoveryBinding extends TerminalRecoveryDescriptor {
+  readonly ownerRunId: string;
+  readonly provenance: TerminalRecoveryProvenance;
+}
+export interface TerminalRecoveryAuthorityInput {
+  readonly auth: SessionAuthContext;
+  readonly descriptor: TerminalRecoveryDescriptor;
+}
+/** Trusted app projection; the diagnostic sink validates primitive buckets before logging. */
+export interface TerminalRecoveryCandidateFacts {
+  readonly flags: Readonly<Record<string, boolean | null>>;
+  readonly counts: Readonly<Record<string, number>>;
+  readonly hashes: Readonly<Record<string, string | null>>;
+}
+export interface TerminalRecoveryCandidateFactsInput extends TerminalRecoveryAuthorityInput {
+  readonly binding: { readonly ownerRunId: string; readonly logicalSessionId: string };
+  readonly payload: PrivateNativeRecoveryPayload;
+}
+/** Exact native candidate supplied only to a trusted app-owned repeatability policy. */
+export interface TerminalRecoveryRepeatableCallsInput extends TerminalRecoveryAuthorityInput {
+  readonly binding: { readonly ownerRunId: string; readonly logicalSessionId: string };
+  readonly payload: PrivateNativeRecoveryPayload;
+}
+/** Trusted server-local app ports. Private candidate payloads stay local; only sanitized facts are logged, never raw checkpoints or grants in HTTP/public responses. */
+export interface TerminalRecoveryPorts {
+  authorize(input: TerminalRecoveryAuthorityInput): Promise<void>;
+  /** Authorizes exact retained calls using app-owned call-bound repeatability proof; missing or failed decisions grant no calls. */
+  authorizeRepeatableRecoveryCalls?(input: TerminalRecoveryRepeatableCallsInput): Promise<readonly string[] | undefined>;
+  /** Trusted read-only projection, called only inside a currently authorized exact-owner observation. */
+  observeCandidateFacts?(input: TerminalRecoveryCandidateFactsInput): Promise<TerminalRecoveryCandidateFacts | undefined>;
+  /** Requires the succeeded operation and exact committed public child, with current cancellation fences. */
+  authorizeActivation(input: TerminalRecoveryAuthorityInput): Promise<void>;
+  readReceipt(input: TerminalRecoveryAuthorityInput): Promise<TerminalRecoveryBinding | null | undefined>;
+  commitReceipt(input: TerminalRecoveryAuthorityInput & { readonly recoveryBinding: TerminalRecoveryBinding }): Promise<TerminalRecoveryBinding>;
+}
+export interface TerminalRecoveryDependencies {
+  collect(input: CollectTerminalRecoveryCandidateInput): Promise<TerminalRecoveryCandidateResult>;
+  reconcile: typeof import("#execution/session/recovery-reconciliation.js").reconcileTerminalRecoveryCandidate;
+  readCandidate(candidate: PrivateNativeRecoveryCandidate): PrivateNativeRecoveryPayload;
+  readEntry(payload: PrivateNativeRecoveryPayload): Promise<unknown>;
+  start(input: Omit<TerminalRecoveryWorkflowEntryInput, "kind" | "ownerDeploymentId">): Promise<unknown>;
+  getHook(token: string): Promise<{ readonly runId: string; readonly metadata: Promise<unknown> }>;
+  resumeHook(token: string, payload: { readonly kind: "activate-terminal-recovery"; readonly operationId: string; readonly ownerRunId: string }): Promise<unknown>;
+  isHookNotFound(error: unknown): boolean;
+  now(): number;
+  wait(ms: number): Promise<void>;
+}
+export declare function parseTerminalRecoveryDescriptor(value: unknown, operationId: unknown): TerminalRecoveryDescriptor | undefined;
+export declare function terminalRecoveryActivationToken(auth: SessionAuthContext, descriptor: TerminalRecoveryDescriptor): string;
+export declare function terminalRecoveryPolicy(entry: unknown): Pick<SessionCheckpoint, "capabilities" | "retention" | "sessionTimeoutMs"> | undefined;
+export declare function recoverTerminalSession(input: TerminalRecoveryAuthorityInput & { readonly ports: TerminalRecoveryPorts }, dependencies: TerminalRecoveryDependencies): Promise<{ readonly kind: "accepted"; readonly recoveryBinding: TerminalRecoveryBinding } | { readonly kind: "unavailable" | "uncertain"; readonly reason: string }>;
+export declare function activateTerminalSession(input: TerminalRecoveryAuthorityInput & { readonly ports: TerminalRecoveryPorts }, dependencies: Pick<TerminalRecoveryDependencies, "getHook" | "resumeHook" | "isHookNotFound">): Promise<{ readonly kind: "accepted"; readonly recoveryBinding: TerminalRecoveryBinding }>;
+export declare function handleTerminalRecoveryRequest(input: {
+  readonly payload: Record<string, unknown>;
+  readonly auth: SessionAuthContext;
+  readonly forwarded: boolean;
+  readonly ports?: TerminalRecoveryPorts;
+}): Promise<Response>;
+
+export interface TerminalRecoveryObservationInput {
+  readonly descriptor: TerminalRecoveryDescriptor;
+  readonly ownerRunId: string;
+  readonly receiptPresent: boolean;
+  readonly outcome: "candidate" | "unavailable";
+  readonly reason?: string;
+  readonly payload?: PrivateNativeRecoveryPayload;
+  readonly candidateFacts?: TerminalRecoveryCandidateFacts;
+}
+export interface TerminalRecoveryObservationDependencies extends Pick<TerminalRecoveryDependencies, "collect" | "readCandidate" | "now"> {
+  /** Safe advisory sink; return true only after recording the structural summary. */
+  recordObservation(input: TerminalRecoveryObservationInput): boolean;
+}
+/** Read-only retained native observation; never starts, resumes, reconciles or commits. */
+export declare function observeTerminalSession(input: TerminalRecoveryAuthorityInput & { readonly ports: Pick<TerminalRecoveryPorts, "authorize" | "readReceipt" | "observeCandidateFacts"> }, dependencies: TerminalRecoveryObservationDependencies): Promise<{ readonly kind: "accepted"; readonly sessionId: string }>;
diff --git a/dist/src/execution/session/terminal-recovery.js b/dist/src/execution/session/terminal-recovery.js
