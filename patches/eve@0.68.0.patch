+  return await reconcileTerminalRecoveryCandidate(candidate);
+}
+function createCandidateCollector(dependencies, resolveOwner) {
+  return async function collectTerminalRecoveryCandidate(input) {
+    const { binding: suppliedBinding, authorizeOwner } = input;
+    if (
+      !isRecord(suppliedBinding) ||
+      typeof suppliedBinding.ownerRunId !== "string" ||
+      !suppliedBinding.ownerRunId ||
+      typeof suppliedBinding.logicalSessionId !== "string" ||
+      !suppliedBinding.logicalSessionId ||
+      typeof authorizeOwner !== "function"
+    ) {
+      throw new Error("Canonical server ownership authorization is required.");
+    }
+    const binding = Object.freeze({
+      ownerRunId: suppliedBinding.ownerRunId,
+      logicalSessionId: suppliedBinding.logicalSessionId,
+    });
