+  if (start >= messages.length - 1) return messages;
+  let combined = { ...messages[start], content: [...messages[start].content] };
+  for (const message of messages.slice(start + 1)) {
+    const last = combined.content.at(-1);
+    if (last !== undefined && combined.providerOptions !== undefined) {
+      combined.content[combined.content.length - 1] = {
+        ...last, providerOptions: mergeProviderOptions(combined.providerOptions, last.providerOptions),
+      };
+    }
+    combined = { ...combined, ...message, content: [...combined.content, ...message.content] };
+    if (message.providerOptions === undefined) delete combined.providerOptions;
+  }
+  return [...messages.slice(0, start), combined];
+}
+function approvedNativeReplayCallIds(messages, tools) {
+  const calls = new Map();
+  const requests = new Map();
+  const results = new Set();
+  for (const message of messages) for (const part of Array.isArray(message.content) ? message.content : []) {
+    if (part.type === "tool-call") calls.set(part.toolCallId, part);
+    if (part.type === "tool-approval-request") requests.set(part.approvalId, part);
+    if (part.type === "tool-result") results.add(part.toolCallId);
+  }
+  const pending = new Set();
+  for (const message of messages.slice(approvalReplayTailStart(messages))) for (const part of message.content) {
+    if (part.type !== "tool-approval-response" || !part.approved) continue;
+    const call = calls.get(requests.get(part.approvalId)?.toolCallId);
+    const tool = call === undefined ? undefined : tools?.get(call.toolName);
+    if (call !== undefined && !results.has(call.toolCallId) && tool?.execute !== undefined
+      && (tool.workflowId === undefined || tool.execution === "background") && tool.runtimeAction === undefined) pending.add(call.toolCallId);
+  }
+  return pending;
+}
+// Capture only actual SDK replay outputs. This also makes model retries and
+// failure checkpoints reuse a completed native call instead of executing twice.
+export function replayedNativeToolResults(messages, providerMessages, tools) {
+  const pending = approvedNativeReplayCallIds(messages, tools);
+  return providerMessages.flatMap((message) => message.role === "tool"
+    ? message.content.filter((part) => part.type === "tool-result" && pending.has(part.toolCallId)) : []);
+}
