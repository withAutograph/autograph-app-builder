+import { sessionCommandHookToken, sessionInboxHookToken } from "#execution/session-inbox/address.js";
+import { sessionHookTokens } from "#execution/session/hook-tokens.js";
+import { parseTerminalRecoveryDescriptor, terminalRecoveryActivationToken } from "#execution/session/terminal-recovery.js";
+
+const record = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const terminal = (status) => ["completed", "failed", "cancelled"].includes(status);
+
+/** Close only a positively authorized immutable loser; never retarget a token to its next owner. */
+export async function closeNoncanonicalRecoveryInboxHolder(input, suppliedDependencies) {
+  let stage = "lookup";
+  try {
+    const dependencies = suppliedDependencies ?? await nativeDependencies();
+    const { descriptor, ports } = input;
+    const token = sessionInboxHookToken(sessionCommandHookToken(descriptor.logicalSessionId));
+    await authorizeCurrent();
+    const captured = await lookup(token);
+    if (captured === undefined) return;
+    const ownerRunId = captured.runId;
+    requireIdentity(captured);
+    await requireMetadata(captured, "session");
+    await authorizeCurrent();
+    if (ports.authorizeRecoveryHolderClosure === undefined) throw new Error("Recovery inbox holder closure is not authorized.");
+    stage = "entry";
+    const retained = await dependencies.readRunEntry(ownerRunId);
+    await authorizeCurrent();
+    stage = "entry";
+    const entry = retained.entry;
+    if (retained.runId !== ownerRunId || !record(entry) || entry.kind !== "terminal-recovery" ||
+        entry.checkpoint?.sessionState?.sessionId !== descriptor.logicalSessionId ||
+        entry.checkpoint?.serializedContext?.["eve.sessionId"] !== descriptor.logicalSessionId) throw new Error("Recovery inbox holder is not a bound recovery candidate.");
+    const holderDescriptor = parseTerminalRecoveryDescriptor(entry.descriptor, entry.descriptor?.operationId);
+    if (holderDescriptor === undefined || holderDescriptor.logicalSessionId !== descriptor.logicalSessionId ||
+        holderDescriptor.originalAuthoritySessionId !== descriptor.originalAuthoritySessionId) throw new Error("Recovery inbox holder lineage differs.");
+    const closureCall = { auth: input.auth, descriptor, holderOwnerRunId: ownerRunId, holderHookId: captured.hookId, holderDescriptor };
+    await authorizeClosure();
+    // These are the addresses this actual retained owner claimed at boot. Read
+    // them afresh once; a missing or reassigned alias is never a cleanup target.
+    stage = "entry";
+    const addresses = sessionHookTokens(entry.checkpoint).map((alias) => ({ token: sessionInboxHookToken(alias), kind: "session" }));
+    addresses.push({ token: terminalRecoveryActivationToken(input.auth, holderDescriptor), kind: "activation" });
+    const hooks = new Map([[captured.hookId, captured]]);
+    for (const address of addresses) {
+      if (address.token === token) continue;
+      const hook = await lookup(address.token);
+      if (hook === undefined || hook.runId !== ownerRunId) continue;
+      requireIdentity(hook);
+      await requireMetadata(hook, address.kind);
+      hooks.set(hook.hookId, hook);
+    }
+    await authorizeClosure();
+    if (!await sameCommandHook()) return;
+    let run = await readExactRun();
+    if (!terminal(run.status)) {
+      if (!["pending", "running"].includes(run.status)) throw new Error("Recovery inbox holder status is unavailable.");
+      await authorizeClosure();
+      if (!await sameCommandHook()) return;
+      stage = "cancel";
+      try { await dependencies.cancelRun(ownerRunId); }
+      catch (error) {
+        // A concurrent terminal transition converges; a live run still fails.
+        run = await readExactRun();
+        if (!terminal(run.status)) { stage = "cancel"; throw error; }
+      }
+      run = await readExactRun();
+      if (!terminal(run.status)) throw new Error("Recovery inbox holder cancellation is unconfirmed.");
+    }
+    // Native cancellation does not run workflow finally. Release every captured
+    // owned address explicitly, always by its immutable ID and physical owner.
+    for (const hook of hooks.values()) {
+      await authorizeClosure();
+      if (await readCapturedHook(hook) === undefined) continue;
+      await authorizeClosure();
+      stage = "dispose";
+      try { await dependencies.disposeHook({ ownerRunId, hookId: hook.hookId, specVersion: hook.specVersion }); }
+      catch (error) {
+        if (await readCapturedHook(hook) !== undefined) { stage = "dispose"; throw error; }
+      }
+      if (await readCapturedHook(hook) !== undefined) throw new Error("Recovery inbox holder release is unconfirmed.");
+    }
+    const current = await lookup(token, "readback");
+    if (current !== undefined && (current.hookId === captured.hookId || current.runId === ownerRunId)) {
+      stage = "readback";
+      throw new Error("Recovery inbox remains bound to the closed holder.");
+    }
+    await authorizeCurrent();
+
+    async function authorizeCurrent() {
+      stage = "authorize";
+      await input.authorizeCurrent();
+    }
+    async function authorizeClosure() {
+      await authorizeCurrent();
+      const proof = await ports.authorizeRecoveryHolderClosure(closureCall);
+      if (proof?.kind !== "immutable-loser" || typeof proof.winnerOwnerRunId !== "string" || proof.winnerOwnerRunId.length === 0 || proof.winnerOwnerRunId === ownerRunId) throw new Error("Recovery inbox holder lacks an immutable winner.");
+      await authorizeCurrent();
+    }
+    async function lookup(address, lookupStage = "lookup") {
+      await authorizeCurrent();
+      stage = lookupStage;
+      let hook;
+      try { hook = await dependencies.getHook(address); }
+      catch (error) { if (!dependencies.isHookNotFound(error)) throw error; }
+      await authorizeCurrent();
+      return hook;
+    }
+    function requireIdentity(hook) {
+      stage = "lookup";
+      if (typeof hook.runId !== "string" || hook.runId.length === 0 || typeof hook.hookId !== "string" || hook.hookId.length === 0) throw new Error("Recovery inbox holder identity is unavailable.");
+    }
+    async function requireMetadata(hook, kind) {
+      stage = "lookup";
+      const metadata = await hook.metadata;
+      await authorizeCurrent();
+      stage = "lookup";
+      if (kind === "session") {
+        if (!record(metadata) || metadata.sessionId !== descriptor.logicalSessionId) throw new Error("Recovery inbox holder logical identity differs.");
+      } else {
+        const binding = metadata?.recoveryBinding;
+        if (!record(binding) || binding.ownerRunId !== ownerRunId) throw new Error("Recovery holder activation identity differs.");
+        const { ownerRunId: ignoredOwner, provenance: ignoredProvenance, ...boundDescriptor } = binding;
+        const parsed = parseTerminalRecoveryDescriptor(boundDescriptor, holderDescriptor.operationId);
+        if (parsed === undefined || JSON.stringify(parsed) !== JSON.stringify(holderDescriptor)) throw new Error("Recovery holder activation lineage differs.");
+      }
+    }
+    async function sameCommandHook() {
+      const current = await lookup(token);
+      if (current === undefined) return false;
+      stage = "lookup";
+      if (current.runId !== ownerRunId || current.hookId !== captured.hookId) throw new Error("Recovery inbox holder changed before closure.");
+      await requireMetadata(current, "session");
+      return true;
+    }
+    async function readExactRun() {
+      await authorizeCurrent();
+      stage = "readback";
+      const current = await dependencies.readRun(ownerRunId);
+      await authorizeCurrent();
+      stage = "readback";
+      if (current.runId !== ownerRunId) throw new Error("Recovery closure physical run changed.");
+      return current;
+    }
+    async function readCapturedHook(hook) {
+      await authorizeCurrent();
+      stage = "readback";
+      let current;
+      try { current = await dependencies.getHookById(hook.hookId); }
+      catch (error) { if (!dependencies.isHookNotFound(error)) throw error; }
+      await authorizeCurrent();
+      stage = "readback";
+      if (current !== undefined && (current.runId !== ownerRunId || current.hookId !== hook.hookId)) throw new Error("Recovery closure immutable hook changed.");
+      return current;
+    }
+  } catch (error) {
+    reportClosureFailure(stage, error);
+    throw error;
+  }
+}
+
+// Failure-only advisory projection: fixed labels and primitive facts, no error serialization.
+function reportClosureFailure(stage, error) {
+  const summary = { event: "eve.terminal_recovery_holder_closure_failed", stage, errorClass: "other" };
+  try {
+    const names = new Set(["WorkflowWorldError", "RunExpiredError", "HookNotFoundError", "RuntimeDecryptionError", "WorkflowRunNotFoundError", "HookForceClaimedError", "EntityConflictError", "SerializationError", "TypeError", "Error"]);
+    const codes = new Set(["TIMEOUT", "TRANSPORT", "PARSE_ERROR", "SCHEMA_VALIDATION", "run-expired", "stream-expired"]);
+    const seen = new Set();
+    let candidate = error;
+    for (let depth = 0; depth < 3; depth += 1) {
+      if (candidate === null || (typeof candidate !== "object" && typeof candidate !== "function") || seen.has(candidate)) break;
+      seen.add(candidate);
+      const name = Object.getOwnPropertyDescriptor(candidate, "name")?.value;
+      const code = Object.getOwnPropertyDescriptor(candidate, "code")?.value;
+      const status = Object.getOwnPropertyDescriptor(candidate, "status")?.value;
+      if (summary.errorClass === "other" && names.has(name)) summary.errorClass = name;
+      if (summary.code === undefined && codes.has(code)) summary.code = code;
+      if (summary.status === undefined && Number.isSafeInteger(status) && status >= 100 && status <= 599) summary.status = status;
+      candidate = Object.getOwnPropertyDescriptor(candidate, "cause")?.value;
+    }
+  } catch { /* A hostile error or diagnostic sink cannot change the original failure. */ }
+  try { console.error(`[eve:terminal-recovery-holder-closure] ${JSON.stringify(summary)}`); }
+  catch { /* Observation never authorizes or changes closure. */ }
+}
+
+async function nativeDependencies() {
+  const [runtime, serialization, errors] = await Promise.all([
+    import("#internal/workflow/runtime.js"),
+    import("#compiled/@workflow/core/serialization.js"),
+    import("#compiled/@workflow/errors/index.js"),
+  ]);
+  return {
+    getHook: runtime.getHookByToken,
+    getHookById: async (hookId) => (await runtime.getWorld()).hooks.get(hookId, { resolveData: "none" }),
+    isHookNotFound: (error) => errors.HookNotFoundError.is(error),
+    readRun: async (ownerRunId) => (await runtime.getWorld()).runs.get(ownerRunId, { resolveData: "none" }),
+    async readRunEntry(ownerRunId) {
+      const world = await runtime.getWorld();
+      const run = await world.runs.get(ownerRunId, { resolveData: "all" });
+      if (run.runId !== ownerRunId) throw new Error("Recovery closure run changed.");
+      const key = await runtime.resolveRunEncryptionKey(world, run);
+      const revivers = Object.fromEntries(["ReadableStream", "WritableStream", "AbortController", "AbortSignal"].map((type) => [type, (value) => ({ kind: "native-recovery-transport-reference", type, value })]));
+      const args = await serialization.hydrateWorkflowArguments(run.input, run.runId, key, globalThis, revivers);
+      return { runId: run.runId, status: run.status, entry: Array.isArray(args) && args.length === 1 ? args[0] : undefined };
+    },
+    cancelRun: async (ownerRunId) => runtime.cancelRun(await runtime.getWorld(), ownerRunId, { cancelReason: "Noncanonical terminal recovery candidate closed after immutable winner proof" }),
+    async disposeHook({ ownerRunId, hookId, specVersion }) {
+      await (await runtime.getWorld()).events.create(ownerRunId, { eventType: "hook_disposed", correlationId: hookId, ...(specVersion === undefined ? {} : { specVersion }) });
+    },
+  };
+}
