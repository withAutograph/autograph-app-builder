+++ b/dist/src/execution/session/recovery-holder-observation.js
@@ -0,0 +1,139 @@
+import { createHash } from "node:crypto";
+import { sessionCommandHookToken, sessionInboxHookToken } from "#execution/session-inbox/address.js";
+import { parseTerminalRecoveryDescriptor, terminalRecoveryActivationToken } from "#execution/session/terminal-recovery.js";
+
+const record = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const hash = (value) => createHash("sha256").update("eve.model-protocol.id.v1\0").update(value).digest("hex");
+const factsKeys = ["operationFound", "descriptorMatches", "sourceBound", "operationSucceeded", "operationReserved", "operationSubmissionUnknown", "operationRejected", "sourceCancelled", "sourceCancellationMatches", "receiptPresent", "receiptOwnerMatches", "committedChildMatches"];
+const completed = new Map();
+const ttl = 15_000;
+
+/** A diagnostic traversal of the authorized logical inbox, never an ownership transfer. */
+export async function observeRecoveryInboxHolder(input, suppliedDependencies) {
+  const dependencies = suppliedDependencies ?? await nativeDependencies();
+  const { descriptor, receipt, authorizeCurrent, ports } = input;
+  const token = sessionInboxHookToken(sessionCommandHookToken(descriptor.logicalSessionId));
+  const summary = {
+    event: "eve.terminal_recovery_inbox_holder",
+    outcome: "unavailable",
+    stage: "hook_lookup",
+    logicalSessionHash: hash(descriptor.logicalSessionId),
+    sourceOwnerHash: hash(descriptor.sourceOwnerRunId),
+    receiptOwnerHash: receipt == null ? null : hash(receipt.ownerRunId),
+  };
+  await authorizeCurrent();
+  let hook;
+  try { hook = await dependencies.getHook(token); }
+  catch (error) {
+    if (!dependencies.isHookNotFound(error)) { await authorizeCurrent(); return; }
+    summary.outcome = "absent";
+    await authorizeCurrent();
+    try { await dependencies.getHook(token); }
+    catch (currentError) {
+      await authorizeCurrent();
+      if (dependencies.isHookNotFound(currentError)) emit();
+      return;
+    }
+    await authorizeCurrent();
+    throw new Error("Recovery observation inbox owner changed.");
+  }
+  if (typeof hook.runId !== "string" || hook.runId.length === 0) {
+    await authorizeCurrent();
+    return;
+  }
+  const ownerRunId = hook.runId;
+  summary.holderOwnerHash = hash(ownerRunId);
+  summary.holderIsLogicalOwner = ownerRunId === descriptor.logicalSessionId;
+  summary.holderIsSourceOwner = ownerRunId === descriptor.sourceOwnerRunId;
+  summary.holderIsReceiptOwner = receipt == null ? null : ownerRunId === receipt.ownerRunId;
+  summary.stage = "hook_metadata";
+  let metadata;
+  try { metadata = await hook.metadata; } catch { /* Read failure stays unavailable. */ }
+  summary.hookLogicalIdentityMatches = record(metadata) && metadata.sessionId === descriptor.logicalSessionId;
+  if (!summary.hookLogicalIdentityMatches) {
+    if (await checkCurrentHook()) emit();
+    return;
+  }
+  await authorizeCurrent();
+  const cacheKey = createHash("sha256").update(JSON.stringify([terminalRecoveryActivationToken(input.auth, descriptor), receipt, ownerRunId])).digest("hex");
+  const cached = completed.get(cacheKey);
+  if (cached !== undefined && dependencies.now() - cached < ttl) {
+    await checkCurrentHook();
+    return;
+  }
+  summary.stage = "retained_entry";
+  let retained;
+  try { retained = await dependencies.readRunEntry(ownerRunId); } catch { /* No exception contents escape. */ }
+  await authorizeCurrent();
+  if (retained !== undefined && retained.runId === ownerRunId) {
+    summary.nativeStatus = ["pending", "running", "completed", "failed", "cancelled"].includes(retained.status) ? retained.status : "unknown";
+    const entry = record(retained.entry) ? retained.entry : undefined;
+    summary.entryKind = ["initial", "handoff", "terminal-recovery"].includes(entry?.kind) ? entry.kind : "unknown";
+    const context = entry?.kind === "initial" ? entry.serializedContext : entry?.checkpoint?.serializedContext;
+    summary.contextLogicalIdentityMatches = record(context) ? context["eve.sessionId"] === descriptor.logicalSessionId : null;
+    summary.stateLogicalIdentityMatches = record(entry?.checkpoint?.sessionState) ? entry.checkpoint.sessionState.sessionId === descriptor.logicalSessionId : null;
+    const holderDescriptor = entry?.kind === "terminal-recovery" ? parseTerminalRecoveryDescriptor(entry.descriptor, entry.descriptor?.operationId) : undefined;
+    summary.recoveryDescriptorPresent = holderDescriptor !== undefined;
+    summary.descriptorMatchesCurrent = holderDescriptor === undefined ? null : Object.keys(descriptor).every((key) => holderDescriptor[key] === descriptor[key]) && Object.keys(holderDescriptor).every((key) => holderDescriptor[key] === descriptor[key]);
+    summary.descriptorLogicalIdentityMatches = holderDescriptor === undefined ? null : holderDescriptor.logicalSessionId === descriptor.logicalSessionId;
+    summary.descriptorOriginalAuthorityMatches = holderDescriptor === undefined ? null : holderDescriptor.originalAuthoritySessionId === descriptor.originalAuthoritySessionId;
+    if (holderDescriptor !== undefined) summary.holderOperationHash = hash(holderDescriptor.operationId);
+    if (holderDescriptor !== undefined && summary.descriptorLogicalIdentityMatches && summary.descriptorOriginalAuthorityMatches && ports.observeRecoveryHolderBinding !== undefined) {
+      summary.stage = "canonical_binding";
+      let facts;
+      try { facts = await ports.observeRecoveryHolderBinding({ auth: input.auth, descriptor, holderOwnerRunId: ownerRunId, holderDescriptor }); }
+      catch { /* App projection failure is unavailable, never authority to change the holder. */ }
+      await authorizeCurrent();
+      summary.canonicalFacts = Object.fromEntries(factsKeys.map((key) => [key, typeof facts?.[key] === "boolean" ? facts[key] : null]));
+    }
+    summary.outcome = entry === undefined ? "unavailable" : "observed";
+  }
+  if (!await checkCurrentHook()) return;
+  summary.stage = "complete";
+  if (emit() && summary.outcome === "observed") {
+    completed.set(cacheKey, dependencies.now());
+    while (completed.size > 256) completed.delete(completed.keys().next().value);
+  }
+
+  async function checkCurrentHook() {
+    await authorizeCurrent();
+    let current;
+    try { current = await dependencies.getHook(token); }
+    catch {
+      await authorizeCurrent();
+      return false;
+    }
+    let currentMetadata;
+    try { currentMetadata = await current.metadata; } catch { return false; }
+    await authorizeCurrent();
+    if (current.runId !== ownerRunId || (record(currentMetadata) && currentMetadata.sessionId === descriptor.logicalSessionId) !== summary.hookLogicalIdentityMatches) throw new Error("Recovery observation inbox owner changed.");
+    return true;
+  }
+  function emit() {
+    try { dependencies.record(summary); return true; }
+    catch { return false; }
+  }
+}
+
+async function nativeDependencies() {
+  const [runtime, serialization, errors] = await Promise.all([
+    import("#internal/workflow/runtime.js"),
+    import("#compiled/@workflow/core/serialization.js"),
+    import("#compiled/@workflow/errors/index.js"),
+  ]);
+  return {
+    getHook: runtime.getHookByToken,
+    isHookNotFound: (error) => errors.HookNotFoundError.is(error),
+    async readRunEntry(ownerRunId) {
+      const world = await runtime.getWorld();
+      const run = await world.runs.get(ownerRunId, { resolveData: "all" });
+      if (run.runId !== ownerRunId) throw new Error("Recovery observation run changed.");
+      const key = await runtime.resolveRunEncryptionKey(world, run);
+      const revivers = Object.fromEntries(["ReadableStream", "WritableStream", "AbortController", "AbortSignal"].map((type) => [type, (value) => ({ kind: "native-recovery-transport-reference", type, value })]));
+      const args = await serialization.hydrateWorkflowArguments(run.input, run.runId, key, globalThis, revivers);
+      return { runId: run.runId, status: run.status, entry: Array.isArray(args) && args.length === 1 ? args[0] : undefined };
+    },
+    now: Date.now,
+    record: (summary) => console.info(`[eve:terminal-recovery-inbox-holder] ${JSON.stringify(summary)}`),
+  };
+}
