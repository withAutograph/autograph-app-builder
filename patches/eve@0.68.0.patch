+      ) {
+        if (retained.output?.action === "done") {
+          addCandidate(
+            "completed-terminal-turn-input",
+            argument,
+            inputOrigins.get(event.correlationId) ?? origin,
+          );
+        }
+        addCandidate("committed-turn-output", retained.output, origin);
+      }
+    }
+
+    const rank = {
+      "terminal-finalizer-input": 0,
+      "completed-terminal-turn-input": 1,
+      "failed-turn-input": 2,
+      "committed-turn-output": 3,
+    };
+    candidates.sort(
+      (left, right) => rank[left.kind] - rank[right.kind] || right.origin.slot - left.origin.slot,
+    );
+    const unique = candidates.filter(
+      (candidate, index) =>
+        candidates.findIndex(
+          (other) =>
+            other.kind === candidate.kind && other.origin.stepId === candidate.origin.stepId,
+        ) === index,
+    );
+    if (unique.length === 0)
+      return { kind: "unavailable", reason: "paired-native-checkpoint-unavailable" };
+
+    // Preserve accepted, uncommitted command envelopes as inert private evidence.
+    // Only the activated recovery owner may admit them through the ordinary inbox.
+    const carriedInbox = [];
+    const latest = [...unique].sort((left, right) => right.origin.slot - left.origin.slot)[0];
+    const latestSession = dependencies.readDurableSession(latest.sessionState);
+    const command = sessionCommandHookToken(binding.logicalSessionId);
+    const inboxTokens = new Set([command, sessionInboxHookToken(command)]);
+    if (
+      typeof latestSession.continuationToken === "string" &&
+      latestSession.continuationToken.length > 0
+    ) {
+      inboxTokens.add(latestSession.continuationToken);
+      inboxTokens.add(sessionInboxHookToken(latestSession.continuationToken));
+    }
+    const hookTokens = new Map(
+      events
+        .filter(({ event }) => event.eventType === "hook_created")
+        .map(({ event }) => [event.correlationId, event.eventData?.token]),
+    );
+    for (const { event, slot } of events) {
+      if (
+        slot <= latest.origin.slot ||
+        event.eventType !== "hook_received" ||
+        !inboxTokens.has(event.eventData?.token ?? hookTokens.get(event.correlationId))
+      )
+        continue;
+      await authorizeOwner(binding);
+      try {
+        const full = await world.events.get(run.runId, event.eventId, { resolveData: "all" });
+        if (
+          full.runId !== run.runId ||
+          full.eventId !== event.eventId ||
+          full.eventType !== event.eventType ||
+          full.correlationId !== event.correlationId ||
+          (full.eventData?.token ?? hookTokens.get(full.correlationId)) !==
+            (event.eventData?.token ?? hookTokens.get(event.correlationId))
+        )
+          throw new Error("Native inbox receipt identity differs.");
+        const payload = await dependencies.hydrateHookPayload(
+          full.eventData.payload,
+          run.runId,
+          key,
+        );
+        carriedInbox.push({
+          runId: run.runId,
+          eventId: event.eventId,
+          correlationId: event.correlationId,
+          slot,
+          payload,
+        });
+      } catch {
+        // Absence of an exact retained envelope can never waive the inbox guard.
+        issues.push({ reason: "native-inbox-payload-unreadable" });
+      }
+    }
+
+    const nativeEvents = [];
+    try {
+      for await (const event of dependencies.readNativeEvents(binding.ownerRunId))
+        nativeEvents.push(event);
+    } catch {
+      issues.push({ reason: "native-stream-incomplete" });
+    }
+    // A result emitted during a failed step is real evidence, but is not proof
+    // that the step's authored-state mutations committed. Never infer or replay.
+    for (const { step } of steps.values()) {
+      if (step.status === "failed" && nativeFunction(step.stepName) === "turnStep") {
+        issues.push({ reason: "failed-turn-effects-unreconciled", stepId: step.stepId });
+      }
+    }
+    for (const retained of steps.values()) {
+      if (
+        nativeFunction(retained.step.stepName) === "turnStep" &&
+        retained.output?.action === "done"
+      ) {
+        issues.push({
+          reason: "completed-terminal-effects-unreconciled",
+          stepId: retained.step.stepId,
+        });
+      }
+    }
+    const frontier = unique.map((candidate) => ({
+      origin: candidate.origin,
+      // Full later native log is retained, including original hook/approval
+      // payloads, failed inputs and completed outcomes. No rollback is implied.
+      events: events.filter(({ slot }) => slot > candidate.origin.slot).map(({ event }) => event),
+    }));
+    const payload = {
+      version: 1,
+      binding,
+      checkpointOwnerRunId: owner.checkpointOwnerRunId,
+      handoffChain: owner.chain,
+      run,
+      nativeRunKey: key,
+      candidates: unique,
+      events: events.map(({ event }) => event),
+      frontier,
+      steps: [...steps.values()],
+      nativeEvents,
+      carriedInbox,
+      issues,
+    };
+    await authorizeOwner(binding);
+    const handle = Object.freeze({ kind: "private-native-recovery-candidate", version: 1 });
+    payloads.set(handle, payload);
+    const inspection = Object.freeze({
+      version: 1,
+      candidates: unique.map((candidate) => {
+        const session = dependencies.readDurableSession(candidate.sessionState);
+        const workflow = session.state?.["autograph-app-builder.workflow.v17"];
+        const authority = session.state?.["autograph-app-builder.private-apply-authority.v1"];
+        return {
+          kind: candidate.kind,
+          slot: candidate.origin.slot,
+          workflowPhase: workflowPhases.has(workflow?.phase) ? workflow.phase : "unavailable",
+          privateApplyGrantPresent: authority?.grant != null,
+          sandboxStatePresent: session.sandboxState !== undefined,
+          historyMessageCount: session.history?.length ?? 0,
+          incomingRuntimeResultCount: candidate.incoming?.runtimeResults?.results?.length ?? 0,
+          incomingDeliveryPresent: candidate.incoming?.delivery !== undefined,
+        };
+      }),
+      nativeEventCount: nativeEvents.length,
+      uncertaintyReasons: [...new Set(issues.map(({ reason }) => reason))],
+      // Collection alone never establishes safe replay or permission to run.
+      requiresTrustedReconciliation: true,
+    });
+    return { kind: "candidate", candidate: handle, inspection };
+  };
+}
+
+/** Read a finite, unchanged prefix without following an unclosed terminal stream. */
+export async function* readTerminalNativeEventsSnapshot(world, runId, key) {
+  const [serialization, stream, protocol] = await Promise.all([
+    import("#compiled/@workflow/core/serialization.js"),
+    import("#execution/ndjson-stream.js"),
+    import("#protocol/message-version.js"),
+  ]);
+  const name = `${runId.replace("wrun_", "strm_")}_user`;
+  const before = await world.streams.getInfo(runId, name);
+  if (!Number.isSafeInteger(before.tailIndex) || before.tailIndex < -1 || typeof before.done !== "boolean")
+    throw new Error("Incomplete native stream.");
+  const count = before.tailIndex + 1;
+  const assertUnchanged = async () => {
+    const after = await world.streams.getInfo(runId, name);
+    if (after.tailIndex !== before.tailIndex || after.done !== before.done)
+      throw new Error("Changed native stream.");
+  };
+  let frames = 0;
+  let stopped = false;
+  let connection;
+  const closeConnection = async (current) => {
+    if (current === undefined) return;
+    if (current.closing !== undefined) return current.closing;
+    current.closing = (async () => {
+      try { await current.reader.cancel(); }
+      catch (error) { if (error !== current.disconnect) throw error; }
+      finally {
+        current.reader.releaseLock();
+        try { await current.writer.abort(); }
+        catch (error) { if (error !== current.disconnect) throw error; }
+        finally {
+          current.writer.releaseLock();
+          try { await current.raw.cancel(); }
+          catch (error) { if (error !== current.disconnect) throw error; }
+          finally { current.raw.releaseLock(); }
+        }
+      }
+    })();
+    return current.closing;
+  };
+  const readFrames = async function* () {
+    while (!stopped && frames < count) {
+      // Preserve the supplied World and its absolute native-index contract.
+      const raw = (await world.streams.get(runId, name, frames)).getReader();
+      const unframer = serialization.getByteUnframingStream();
+      const current = { start: frames, raw, reader: unframer.readable.getReader(), writer: unframer.writable.getWriter() };
+      connection = current;
+      let pending = current.reader.read();
+      pending.catch(() => {});
+      let headerSize = 0;
+      let remaining = 0;
+      const header = new Uint8Array(4);
+      try {
+        while (!stopped && frames < count) {
+          let next;
+          try { next = await raw.read(); }
+          catch (error) { current.disconnect = error; break; }
+          if (next.done) break;
+          const value = next.value;
+          if (!(value instanceof Uint8Array)) throw new Error("Invalid native stream bytes.");
+          let offset = 0;
+          let complete = 0;
+          while (offset < value.byteLength) {
+            if (remaining === 0) {
+              const take = Math.min(4 - headerSize, value.byteLength - offset);
+              header.set(value.subarray(offset, offset + take), headerSize);
+              headerSize += take;
+              offset += take;
+              if (headerSize !== 4) continue;
+              remaining = new DataView(header.buffer).getUint32(0, false);
+              headerSize = 0;
+              if (remaining === 0) throw new Error("Incomplete native stream frame.");
+            }
+            const take = Math.min(remaining, value.byteLength - offset);
+            remaining -= take;
+            offset += take;
+            if (remaining === 0) {
+              complete++;
+              if (frames + complete === count && offset !== value.byteLength)
+                throw new Error("Changed native stream.");
+            }
+          }
+          // Drain every complete frame before another transport read. An EOF
+          // cannot discard complete queued frames or bytes already decoded.
+          await current.writer.write(value);
+          for (let index = 0; index < complete; index++) {
+            const decoded = await pending;
+            if (decoded.done) throw new Error("Incomplete native stream decoding.");
+            pending = current.reader.read();
+            pending.catch(() => {});
+            const frame = new Uint8Array(decoded.value.byteLength + 4);
+            new DataView(frame.buffer).setUint32(0, decoded.value.byteLength, false);
+            frame.set(decoded.value, 4);
+            frames++;
+            yield frame;
+          }
+        }
+      } finally { await closeConnection(current); }
+      if (stopped || frames === count) return;
+      if (frames === current.start) throw new Error("Native stream made no progress.");
+      // Keep complete prefix frames in RAM; only the connection-local partial
+      // frame is discarded and reread at this exact next native index.
+      await assertUnchanged();
+    }
+  };
+  const iterator = readFrames();
+  const finite = new ReadableStream({
+    async pull(controller) {
+      const next = await iterator.next();
+      if (next.done) controller.close();
+      else controller.enqueue(next.value);
+    },
+    async cancel() {
+      stopped = true;
+      await closeConnection(connection);
+      await iterator.return();
+    },
+  });
+  const inert = Object.fromEntries(
+    ["ReadableStream", "WritableStream", "AbortController", "AbortSignal"].map((type) => [
+      type,
+      (value) => Object.freeze({ kind: "native-recovery-transport-reference", type, value }),
+    ]),
+  );
+  let decodedFrames = 0;
+  const bytes = finite
+    .pipeThrough(
+      serialization.getDeserializeStream(
+        { ...serialization.getCommonRevivers(globalThis), ...inert },
+        key,
+      ),
+    )
+    .pipeThrough(
+      new TransformStream({
+        transform(value, controller) {
+          if (!(value instanceof Uint8Array)) throw new Error("Invalid native stream bytes.");
+          decodedFrames++;
+          controller.enqueue(value);
+        },
+      }),
+    );
+  const events = [];
+  try {
+    for await (const event of stream.parseNdjsonStream(
+      () => bytes,
+      protocol.normalizePersistedMessageStreamEvent,
+    ))
+      events.push(event);
+    if (frames !== count || decodedFrames !== count)
+      throw new Error("Incomplete native stream decoding.");
+    await assertUnchanged();
+  } finally {
+    stopped = true;
+    await closeConnection(connection);
+    await iterator.return();
+  }
+  yield* events;
+}
+
+/** Production wiring stays inside the native framework, after owner authorization. */
+export async function collectTerminalRecoveryCandidate(input) { return await collectNativeCandidate(input, createTerminalRecoveryCandidateCollector); }
+export async function collectOwnedLineagePreflight(input) { return await collectNativeCandidate({ ...input, allowParked: true }, createOwnedLineagePreflightCollector); }
+async function collectNativeCandidate(input, collectorFactory) {
+  const [runtime, serialization, durable] = await Promise.all([
+    import("#internal/workflow/runtime.js"),
+    import("#compiled/@workflow/core/serialization.js"),
+    import("#execution/durable-session-store.js"),
+  ]);
+  // Hydration for inspection must not start stream forwarding, lock polling,
+  // or live AbortSignal readers. Keep transport refs inert; their original
+  // serialized bytes remain in the private native log/step record.
+  const transportRevivers = Object.fromEntries(
+    ["ReadableStream", "WritableStream", "AbortController", "AbortSignal"].map((type) => [
+      type,
+      (value) => Object.freeze({ kind: "native-recovery-transport-reference", type, value }),
+    ]),
+  );
+  return collectorFactory({
+    getWorld: runtime.getWorld,
+    resolveRunEncryptionKey: runtime.resolveRunEncryptionKey,
+    hydrateWorkflowArguments: (value, runId, key) =>
+      serialization.hydrateWorkflowArguments(value, runId, key, globalThis, transportRevivers),
+    hydrateHookPayload: async (value, _runId, key) =>
+      serialization.deserializePreparedReplayPayload(
+        await serialization.prepareReplayPayload(value, key),
+        globalThis,
+        transportRevivers,
+      ),
+    hydrateStepArguments: (value, runId, key) =>
+      serialization.hydrateStepArguments(value, runId, key, [], globalThis, transportRevivers),
+    hydrateStepReturnValue: (value, runId, key) =>
+      serialization.hydrateStepReturnValue(value, runId, key, globalThis, transportRevivers),
+    readDurableSession: durable.readDurableSession,
+    requireEventSlot: nativeEventSlot,
+    async *readNativeEvents(runId) {
+      const world = await runtime.getWorld();
+      const run = await world.runs.get(runId, { resolveData: "none" });
+      if (run.runId !== runId || (!["failed", "completed", "cancelled"].includes(run.status) && !(input.allowParked === true && ["pending", "running"].includes(run.status))))
+        throw new Error("Native stream owner is not terminal.");
+      const key = await runtime.resolveRunEncryptionKey(world, run);
+      yield* readTerminalNativeEventsSnapshot(world, runId, key);
+    },
+    now: Date.now,
+  })(input);
+}
