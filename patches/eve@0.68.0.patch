+    await authorizeOwner(binding);
+    const world = await dependencies.getWorld();
+    const anchor = await world.runs.get(binding.ownerRunId, { resolveData: "all" });
+    if (anchor.runId !== binding.ownerRunId)
+      throw new Error("Native recovery run identity differs.");
