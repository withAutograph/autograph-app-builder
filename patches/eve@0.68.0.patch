+    // and newest step IDs cannot establish which state the owner adopted.
+    for (const { event, slot } of events) {
+      if (!event.eventType.startsWith("step_") || !event.correlationId) continue;
+      const knownName = stepNames.get(event.correlationId);
+      // The immutable World retains every raw payload. Keep its complete
+      // metadata frontier here; fetch only relevant checkpoint payloads.
+      if (knownName !== undefined && !relevantSteps.has(knownName)) continue;
