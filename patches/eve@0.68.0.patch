+/** Close only recorded calls owned by the cancelled turn. This is a model
+ * protocol result, not a provider receipt or a claim that effects did not run. */
+function settleCancelledToolHistory(history, pendingCalls, retainedMessages = []) {
+  const expected = new Map();
+  for (const { callId, toolName } of pendingCalls) {
+    if (
+      typeof callId !== "string" ||
+      callId.length === 0 ||
+      typeof toolName !== "string" ||
+      toolName.length === 0
+    )
+      continue;
+    const prior = expected.get(callId);
+    expected.set(callId, prior === undefined || prior === toolName ? toolName : null);
+  }
+  const calls = new Map();
+  const results = new Set();
+  for (const message of history) {
+    if (!Array.isArray(message.content)) continue;
+    for (const part of message.content) {
+      if (part.type === "tool-result") results.add(part.toolCallId);
+      if (message.role !== "assistant" || part.type !== "tool-call") continue;
+      const prior = calls.get(part.toolCallId);
+      calls.set(part.toolCallId, prior === undefined ? part : null);
+    }
+  }
+  // A buffered result has not passed its original reducer. Preserve that
+  // owner's durable input rather than inventing a result or certifying effects.
+  for (const message of retainedMessages) {
+    if (!Array.isArray(message.content)) continue;
+    for (const part of message.content) {
+      if (part.type !== "tool-result") continue;
+      const call = calls.get(part.toolCallId);
+      const expectedName = expected.get(part.toolCallId);
+      if (
+        call != null &&
+        call.providerExecuted !== true &&
+        typeof expectedName === "string" &&
+        call.toolName === expectedName &&
+        !results.has(part.toolCallId)
+      ) {
+        throw new Error(
+          "Cancellation result ownership is unresolved; retain the original reducer input.",
+        );
+      }
+    }
+  }
+  const content = [];
+  for (const [callId, toolName] of expected) {
+    const call = calls.get(callId);
+    if (
+      toolName === null ||
+      call == null ||
+      call.providerExecuted === true ||
+      call.toolName !== toolName ||
+      results.has(callId)
+    )
+      continue;
+    content.push({
+      type: "tool-result",
+      toolCallId: callId,
+      toolName,
+      output: {
+        type: "error-json",
+        value: {
+          code: "parent_turn_cancelled_before_result",
+          effects: "unknown",
+          message:
+            "The parent turn was cancelled before a result for this call was recorded. Reconcile the existing operation before retrying. This record is not a success, approval, or provider receipt.",
+        },
+      },
+    });
+  }
+  return content.length === 0 ? history : [...history, { role: "tool", content }];
+}
+
+// This tag only removes evidence of completion; it never proves who authored
+// a result and never grants permission to delete an output or replay a call.
+function isCancelledToolHistoryResult(part) {
+  return (
+    part.type === "tool-result" &&
+    part.output?.type === "error-json" &&
+    part.output.value?.code === "parent_turn_cancelled_before_result" &&
+    part.output.value?.effects === "unknown"
+  );
+}
+
+export { settleCancelledToolHistory, isCancelledToolHistoryResult };
