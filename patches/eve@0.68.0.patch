+import type { TerminalRecoveryAuthorityInput, TerminalRecoveryDescriptor } from "#execution/session/terminal-recovery.js";
+export interface RecoveryHolderClosureAuthorizationInput extends TerminalRecoveryAuthorityInput {
+  readonly holderOwnerRunId: string;
+  readonly holderHookId: string;
+  readonly holderDescriptor: TerminalRecoveryDescriptor;
+}
+export interface RecoveryHolderClosureAuthorization {
+  readonly kind: "immutable-loser";
+  readonly winnerOwnerRunId: string;
+}
+export interface RecoveryHolderClosureInput extends TerminalRecoveryAuthorityInput {
+  readonly ports: {
+    authorizeRecoveryHolderClosure?(input: RecoveryHolderClosureAuthorizationInput): Promise<RecoveryHolderClosureAuthorization>;
+  };
+  /** Re-read current app authority/Stop and require its exact operation still has no receipt. */
+  authorizeCurrent(): Promise<void>;
+}
+export interface RecoveryHolderClosureHook {
+  readonly runId: string;
+  readonly hookId: string;
+  readonly specVersion?: number;
+}
+export interface RecoveryHolderClosureDependencies {
+  getHook(token: string): Promise<RecoveryHolderClosureHook & { readonly metadata: Promise<unknown> }>;
+  getHookById(hookId: string): Promise<RecoveryHolderClosureHook>;
+  isHookNotFound(error: unknown): boolean;
+  readRunEntry(ownerRunId: string): Promise<{ readonly runId: string; readonly status: string; readonly entry: unknown }>;
+  readRun(ownerRunId: string): Promise<{ readonly runId: string; readonly status: string }>;
+  cancelRun(ownerRunId: string): Promise<void>;
+  disposeHook(input: { readonly ownerRunId: string; readonly hookId: string; readonly specVersion?: number }): Promise<void>;
+}
+/** Prepare-time closure only. Captures the retained owner's command, continuation and activation hooks;
+ * disposes only their immutable IDs after fresh immutable-loser proof. Missing/reassigned aliases are
+ * preserved, absent inbox returns, unproven ownership throws, and receipts are never replaced. */
+export declare function closeNoncanonicalRecoveryInboxHolder(input: RecoveryHolderClosureInput, dependencies?: RecoveryHolderClosureDependencies): Promise<void>;
