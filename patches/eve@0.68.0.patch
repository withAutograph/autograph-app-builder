+    const witnesses = [];
+    for (const entry of observed) {
+      if (entry.candidate.origin.slot >= latestCandidate.origin.slot) continue;
+      const witness = witnessFor(
+        entry,
+        call,
+        history,
+        latestCandidate.sessionState.emissionState,
+        payload.nativeEvents,
+      );
+      if (witness.kind === "ambiguous")
+        return uncertain("cancelled-call-history-unreconciled", call.toolCallId);
+      if (witness.kind === "witness") witnesses.push(witness);
+    }
+    if (witnesses.length === 0) continue;
+    if (assistantCalls(history, call.toolCallId).length !== 1) {
+      recordRefusal("latest_history", call.toolCallId, { history_call_count: () => true });
+      return uncertain("cancelled-call-history-unreconciled", call.toolCallId);
+    }
+    const first = witnesses[0];
+    const address = witnesses.find((witness) => witness.address !== undefined)?.address;
+    if (
+      witnesses.some(
+        (witness) =>
+          witness.turnId !== first.turnId ||
+          witness.sequence !== first.sequence ||
+          (witness.address !== undefined && !isDeepStrictEqual(witness.address, address)),
+      )
+    ) {
+      recordRefusal("witness_consistency", call.toolCallId, {
+        witness_turn_mismatch: () => witnesses.some((witness) => witness.turnId !== first.turnId),
+        witness_sequence_mismatch: () =>
+          witnesses.some((witness) => witness.sequence !== first.sequence),
