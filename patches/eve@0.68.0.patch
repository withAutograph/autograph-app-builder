index 0000000..0949701
--- /dev/null
+++ b/dist/src/execution/session/terminal-recovery.js
@@ -0,0 +1,332 @@
+import { createHash } from "node:crypto";
+import { DEFAULT_SESSION_TIMEOUT_MS } from "#execution/session/timeout.js";
+import { SESSION_CHECKPOINT_VERSION } from "#execution/session/handoff.js";
+
+const descriptorKeys = ["version", "operationId", "sourcePublicSessionId", "sourceOwnerRunId", "sourceAdapterGeneration", "logicalSessionId", "originalAuthoritySessionId", "parentCancellationRevision", "sourceHandoffId"];
+const provenanceKeys = ["kind", "sourceStepId", "sourceEventId", "sourceSlot", "checkpointVersion"];
+const candidateKinds = ["terminal-finalizer-input", "completed-terminal-turn-input", "failed-turn-input", "committed-turn-output"];
+const record = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+
+export function parseTerminalRecoveryDescriptor(value, operationId) {
+  if (!record(value) || Object.keys(value).some((key) => !descriptorKeys.includes(key)) || value.version !== 1 || value.operationId !== operationId) return;
+  for (const key of ["operationId", "sourcePublicSessionId", "sourceOwnerRunId", "logicalSessionId", "originalAuthoritySessionId"]) {
+    if (typeof value[key] !== "string" || value[key].length === 0 || value[key].length > 500) return;
+  }
+  if (!Number.isSafeInteger(value.sourceAdapterGeneration) || value.sourceAdapterGeneration < 1 || !Number.isSafeInteger(value.parentCancellationRevision) || value.parentCancellationRevision < 0) return;
+  if (value.sourceHandoffId !== undefined && (typeof value.sourceHandoffId !== "string" || value.sourceHandoffId.length === 0 || value.sourceHandoffId.length > 200)) return;
+  return Object.fromEntries(descriptorKeys.filter((key) => value[key] !== undefined).map((key) => [key, value[key]]));
+}
+
+export function terminalRecoveryActivationToken(auth, descriptor) {
+  const identity = JSON.stringify([auth.authenticator, auth.issuer ?? null, auth.principalType, auth.principalId, descriptor]);
+  return `eve:terminal-recovery:${createHash("sha256").update(identity).digest("hex")}`;
+}
+
+function matchesDescriptor(binding, descriptor) {
+  return record(binding) && descriptorKeys.every((key) => binding[key] === descriptor[key]) &&
+    typeof binding.ownerRunId === "string" && binding.ownerRunId.length > 0 && record(binding.provenance) &&
+    candidateKinds.includes(binding.provenance.kind) && binding.provenance.checkpointVersion === 1 &&
+    typeof binding.provenance.sourceStepId === "string" && typeof binding.provenance.sourceEventId === "string" &&
+    Number.isSafeInteger(binding.provenance.sourceSlot) && binding.provenance.sourceSlot >= 0;
+}
+const sameReceipt = (left, right) => left.ownerRunId === right.ownerRunId && provenanceKeys.every((key) => left.provenance[key] === right.provenance[key]);
+
+/** Derive policy only from the retained source entry and this runtime's documented initial default. */
+export function terminalRecoveryPolicy(entry) {
+  if (!record(entry)) return;
+  const source = entry.kind === "initial" ? entry :
+    entry.kind === "handoff" || entry.kind === "terminal-recovery" ? entry.checkpoint : undefined;
+  if (!record(source)) return;
+  const sessionTimeoutMs = entry.kind === "initial" ? source.sessionTimeoutMs ?? DEFAULT_SESSION_TIMEOUT_MS : source.sessionTimeoutMs;
+  if (sessionTimeoutMs !== false && (typeof sessionTimeoutMs !== "number" || !Number.isFinite(sessionTimeoutMs) || sessionTimeoutMs < 0)) return;
+  const capabilities = entry.kind === "initial" ? source.serializedContext?.["eve.capabilities"] : source.capabilities;
+  return { capabilities, retention: source.retention, sessionTimeoutMs };
+}
+
+export async function recoverTerminalSession(input, dependencies) {
+  const { auth, descriptor, ports } = input;
+  const call = { auth, descriptor };
+  await ports.authorize(call);
+  const token = terminalRecoveryActivationToken(auth, descriptor);
+  const existing = await ports.readReceipt(call);
+  if (existing !== null && existing !== undefined) {
+    if (!matchesDescriptor(existing, descriptor)) throw new Error("Recovery receipt binding changed.");
+    return { kind: "accepted", recoveryBinding: existing };
+  }
+  let ready = await findReady();
+  if (ready === undefined) {
+    const collected = await dependencies.collect({
+      binding: { ownerRunId: descriptor.sourceOwnerRunId, logicalSessionId: descriptor.logicalSessionId },
+      authorizeOwner: async (binding) => {
+        if (binding.ownerRunId !== descriptor.sourceOwnerRunId || binding.logicalSessionId !== descriptor.logicalSessionId) throw new Error("Recovery source binding changed.");
+        await ports.authorize(call);
+      },
+    });
+    if (collected.kind !== "candidate") return { kind: "unavailable", reason: collected.reason };
+    const payload = dependencies.readCandidate(collected.candidate);
+    let repeatableCallIds;
+    if (ports.authorizeRepeatableRecoveryCalls !== undefined) {
+      const binding = { ownerRunId: descriptor.sourceOwnerRunId, logicalSessionId: descriptor.logicalSessionId };
+      if (payload.binding?.ownerRunId !== binding.ownerRunId || payload.binding?.logicalSessionId !== binding.logicalSessionId) throw new Error("Recovery source binding changed.");
+      const authorizeCandidate = async () => {
+        await ports.authorize(call);
+        if (await ports.readReceipt(call) != null) throw new Error("Recovery receipt changed during candidate authorization.");
+      };
+      await authorizeCandidate();
+      try {
+        const authorized = await ports.authorizeRepeatableRecoveryCalls({ ...call, binding, payload });
+        if (Array.isArray(authorized) && authorized.every((id) => typeof id === "string" && id.length > 0)) repeatableCallIds = [...new Set(authorized)];
+      } catch { /* A failed app decision grants no repeatable calls; strict reconciliation still applies. */ }
+      // Revocation and a concurrently committed owner must never be advisory.
+      await authorizeCandidate();
+    }
+    const reconciled = await dependencies.reconcile(collected.candidate, repeatableCallIds === undefined ? undefined : { repeatableCallIds });
+    if (reconciled.kind !== "ready") return reconciled;
+    let policy;
+    try { policy = terminalRecoveryPolicy(await dependencies.readEntry(payload)); }
+    catch { return { kind: "unavailable", reason: "source-policy-unavailable" }; }
+    if (policy === undefined) return { kind: "unavailable", reason: "source-policy-unavailable" };
+    const selected = payload.candidates.find((candidate) => candidate.origin.eventId === reconciled.provenance.selectedOrigin.eventId && candidate.origin.stepId === reconciled.provenance.selectedOrigin.stepId);
+    if (selected === undefined) return { kind: "uncertain", reason: "checkpoint-origin-unavailable" };
+    const provenance = {
+      kind: selected.kind,
+      sourceStepId: selected.origin.stepId,
+      sourceEventId: selected.origin.eventId,
+      sourceSlot: selected.origin.slot,
+      checkpointVersion: 1,
+    };
+    const checkpoint = { ...reconciled.checkpointCore, ...policy, version: SESSION_CHECKPOINT_VERSION };
+    if (checkpoint.sessionState.sessionId !== descriptor.logicalSessionId || checkpoint.serializedContext["eve.sessionId"] !== descriptor.logicalSessionId) return { kind: "uncertain", reason: "checkpoint-identity-mismatch" };
+    await ports.authorize(call);
+    await dependencies.start({ activationToken: token, checkpoint, descriptor, provenance, replayInput: reconciled.replayInput });
+    // A start timeout remains unknown. A later exact request discovers the ready hook;
+    // no checkpoint may execute until its canonical physical owner receipt is committed.
+    const deadline = dependencies.now() + 30_000;
+    let observationDelayMs = 250;
+    do {
+      ready = await findReady();
+      if (ready !== undefined) break;
+      const remainingMs = deadline - dependencies.now();
+      if (remainingMs <= 0) throw new Error("Recovery owner acceptance is unknown.");
+      await dependencies.wait(Math.min(observationDelayMs, remainingMs));
+      observationDelayMs = Math.min(observationDelayMs * 2, 2_000);
+    } while (true);
+  }
+  await ports.authorize(call);
+  const receipt = await ports.commitReceipt({ ...call, recoveryBinding: ready });
+  if (!matchesDescriptor(receipt, descriptor) || !sameReceipt(receipt, ready)) throw new Error("Recovery receipt did not retain its physical owner and provenance.");
+  return { kind: "accepted", recoveryBinding: receipt };
+
+  async function findReady() {
+    let hook;
+    try { hook = await dependencies.getHook(token); }
+    catch (error) { if (dependencies.isHookNotFound(error)) return; throw error; }
+    const binding = (await hook.metadata)?.recoveryBinding;
+    if (!matchesDescriptor(binding, descriptor) || binding.ownerRunId !== hook.runId) throw new Error("Recovery activation owner changed.");
+    return binding;
+  }
+
+}
+
+// A diagnostic is never an activation authority. Only fixed labels and data-only
+// primitive error facts may leave this boundary; never serialize an exception.
+function reportActivationFailure(stage, error) {
+  const summary = { event: "eve.terminal_recovery_activation_failed", stage, errorClass: "other" };
+  try {
+    const names = new Set(["WorkflowWorldError", "RunExpiredError", "HookNotFoundError", "RuntimeDecryptionError", "WorkflowRunNotFoundError", "HookForceClaimedError", "EntityConflictError", "SerializationError", "TypeError", "Error"]);
+    const codes = new Set(["TIMEOUT", "TRANSPORT", "PARSE_ERROR", "SCHEMA_VALIDATION", "run-expired", "stream-expired"]);
+    const seen = new Set();
+    let candidate = error;
+    for (let depth = 0; depth < 3; depth += 1) {
+      if (candidate === null || (typeof candidate !== "object" && typeof candidate !== "function") || seen.has(candidate)) break;
+      seen.add(candidate);
+      const name = Object.getOwnPropertyDescriptor(candidate, "name")?.value;
+      const code = Object.getOwnPropertyDescriptor(candidate, "code")?.value;
+      const status = Object.getOwnPropertyDescriptor(candidate, "status")?.value;
+      if (summary.errorClass === "other" && names.has(name)) summary.errorClass = name;
+      if (summary.code === undefined && codes.has(code)) summary.code = code;
+      if (summary.status === undefined && Number.isSafeInteger(status) && status >= 100 && status <= 599) summary.status = status;
+      candidate = Object.getOwnPropertyDescriptor(candidate, "cause")?.value;
+    }
+  } catch { /* Error projection is advisory, including hostile accessors/proxies. */ }
+  try { console.error(`[eve:terminal-recovery-activation] ${JSON.stringify(summary)}`); }
+  catch { /* A failed diagnostic sink must never replace the original exception. */ }
+}
+
+/** Release only an already committed owner after the app proves its canonical public child. */
+export async function activateTerminalSession(input, dependencies) {
+  const { auth, descriptor, ports } = input;
+  const call = { auth, descriptor };
+  await ports.authorizeActivation(call);
+  let stage = "receipt_read";
+  try {
+    const receipt = await ports.readReceipt(call);
+    stage = "receipt_validate";
+    if (!matchesDescriptor(receipt, descriptor)) throw new Error("Recovery activation receipt is unavailable.");
+    const token = terminalRecoveryActivationToken(auth, descriptor);
+    let hook;
+    stage = "hook_lookup";
+    try { hook = await dependencies.getHook(token); }
+    catch (error) { if (!dependencies.isHookNotFound(error)) throw error; }
+    // A consumed/ended hook never authorizes creation of another physical owner.
+    if (hook !== undefined) {
+      stage = "hook_metadata";
+      const ready = (await hook.metadata)?.recoveryBinding;
+      stage = "hook_validate";
+      if (!matchesDescriptor(ready, descriptor) || ready.ownerRunId !== hook.runId || !sameReceipt(ready, receipt)) throw new Error("Recovery activation does not match the receipt.");
+      stage = "reauthorize";
+      await ports.authorizeActivation(call);
+      stage = "resume";
+      try {
+        await dependencies.resumeHook(token, { kind: "activate-terminal-recovery", operationId: descriptor.operationId, ownerRunId: receipt.ownerRunId });
+      } catch (error) {
+        if (!dependencies.isHookNotFound(error)) throw error;
+      }
+    }
+    return { kind: "accepted", recoveryBinding: receipt };
+  } catch (error) {
+    reportActivationFailure(stage, error);
+    throw error;
+  }
+}
+
+// Diagnostic suppression only: hashes, completion flags and timestamps, never checkpoint bytes.
+// Eviction affects only repeated logging/read cost, never authorization or admission.
+const observations = new Map();
+const OBSERVATION_TTL_MS = 15_000;
+const OBSERVATION_CACHE_ENTRIES = 256;
+
+/** Inspect original and receipt physical owners without starting or activating anything. */
+export async function observeTerminalSession(input, dependencies) {
+  const { auth, descriptor, ports } = input;
+  const call = { auth, descriptor };
+  await ports.authorize(call);
+  const receipt = await ports.readReceipt(call);
+  if (receipt != null && !matchesDescriptor(receipt, descriptor)) throw new Error("Recovery observation receipt changed.");
+  // The recovered checkpoint cannot establish whether the original owner retained a
+  // genuine result. Observe each exact authorized physical owner independently.
+  const acceptedOwnerRunId = receipt?.ownerRunId ?? descriptor.sourceOwnerRunId;
+  await observeOwner(descriptor.sourceOwnerRunId);
+  if (acceptedOwnerRunId !== descriptor.sourceOwnerRunId) await observeOwner(acceptedOwnerRunId);
+  return { kind: "accepted", sessionId: acceptedOwnerRunId };
+
+  async function observeOwner(ownerRunId) {
+    const key = createHash("sha256").update("eve.terminal-observation.v1\0").update(JSON.stringify([
+      terminalRecoveryActivationToken(auth, descriptor), ownerRunId,
+      receipt == null ? null : provenanceKeys.map((field) => receipt.provenance[field]),
+    ])).digest("hex");
+    const binding = { ownerRunId, logicalSessionId: descriptor.logicalSessionId };
+    async function authorizeSelected(selected = binding) {
+      if (selected.ownerRunId !== binding.ownerRunId || selected.logicalSessionId !== binding.logicalSessionId) throw new Error("Recovery observation owner changed.");
+      await ports.authorize(call);
+      const current = await ports.readReceipt(call);
+      if (receipt == null ? current != null : !matchesDescriptor(current, descriptor) || !sameReceipt(current, receipt)) throw new Error("Recovery observation receipt changed.");
+    }
+    await authorizeSelected();
+    let cached = observations.get(key);
+    if (cached !== undefined && cached.completedAt !== undefined && dependencies.now() - cached.completedAt >= OBSERVATION_TTL_MS) {
+      observations.delete(key);
+      cached = undefined;
+    }
+    if (cached === undefined) {
+      const entry = {};
+      entry.pending = (async () => {
+        const collected = await dependencies.collect({ binding, authorizeOwner: authorizeSelected });
+        await authorizeSelected();
+        let payload;
+        try {
+          payload = collected.kind === "candidate" ? dependencies.readCandidate(collected.candidate) : undefined;
+          if (payload !== undefined && (payload.binding.ownerRunId !== ownerRunId || payload.binding.logicalSessionId !== descriptor.logicalSessionId)) throw new Error("Recovery observation payload changed.");
+        } catch { return false; }
+        let candidateFacts;
+        if (payload !== undefined && ports.observeCandidateFacts !== undefined) {
