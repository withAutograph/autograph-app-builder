+import type { TerminalRecoveryWorkflowEntryInput } from "#execution/session/entry-input.js";
+import type { SessionBoot } from "#execution/session/program.js";
+import type { SessionInboxHandle } from "#execution/session-inbox/inbox.js";
+export declare function bootTerminalRecoveryOwner(input: TerminalRecoveryWorkflowEntryInput): Promise<{ inbox: SessionInboxHandle; session: SessionBoot } | undefined>;
+/** Synthetic workflow-port fixture seam. Production uses bootTerminalRecoveryOwner. */
+export declare function bootTerminalRecoveryOwnerWithPorts(input: TerminalRecoveryWorkflowEntryInput, ports: {
+  createHook: typeof import("#compiled/@workflow/core/index.js").createHook;
+  createSessionInbox: typeof import("#execution/session-inbox/inbox.js").createSessionInbox;
+  getWorkflowMetadata: typeof import("#compiled/@workflow/core/index.js").getWorkflowMetadata;
+  getWritable: typeof import("#compiled/@workflow/core/index.js").getWritable;
+  validateCheckpoint: typeof import("#execution/session/handoff-steps.js").validateTerminalRecoveryCheckpointStep;
+}): Promise<{ inbox: SessionInboxHandle; session: SessionBoot } | undefined>;
