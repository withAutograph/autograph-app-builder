+import type { Event, World, WorkflowRun } from "#compiled/@workflow/world/index.js";
+import type { PayloadKey } from "#compiled/@workflow/core/serialization/encryption.js";
+import type {
+  NativeRecoveryCollectorDependencies,
+  NativeRecoveryOwnerBinding,
+} from "#execution/session/recovery-candidate.js";
+/** Private retained native evidence. Event positions belong only to parentRunId. */
+export interface NativeHandoffProvenance {
+  readonly parentRunId: string;
+  readonly ownerRunId: string;
+  readonly startStepId: string;
+  readonly activationEventId: string;
+  readonly events: readonly Event[];
+}
+export interface NativeRecoveryBoundary {
+  readonly stage: "authority_anchor" | "handoff_parent" | "handoff_successor" | "final_owner";
+  readonly status: "pending" | "running" | "completed" | "failed" | "cancelled" | "waiting" | "queued" | "suspended" | "other";
+  readonly parentStatus?: "pending" | "running" | "completed" | "failed" | "cancelled" | "waiting" | "queued" | "suspended" | "other";
+  readonly allowParked: boolean;
+}
+export declare function nativeRecoveryBoundary(stage: NativeRecoveryBoundary["stage"], run: Pick<WorkflowRun, "status">, allowParked: boolean, parent?: Pick<WorkflowRun, "status">): NativeRecoveryBoundary;
+export type TerminalCheckpointOwnerResolution =
+  | {
+      readonly kind: "resolved";
+      readonly run: WorkflowRun;
+      readonly key: PayloadKey | undefined;
+      readonly checkpointOwnerRunId: string;
+      readonly chain: readonly NativeHandoffProvenance[];
+    }
+  | {
+      readonly kind: "unavailable";
+      readonly boundary?: NativeRecoveryBoundary;
+      readonly reason:
+        | "source-not-terminal"
+        | "native-data-expired"
+        | "handoff-discovery-unavailable"
+        | "handoff-owner-ambiguous"
+        | "handoff-parent-frontier-uncertain";
+    };
+/** Anchor authorization remains mandatory; discovery metadata is never authority. */
+export declare function resolveTerminalCheckpointOwner(input: {
+  readonly world: World;
+  readonly anchor: WorkflowRun;
+  readonly allowParked?: boolean;
+  readonly binding: NativeRecoveryOwnerBinding;
+  readonly authorizeOwner: (binding: NativeRecoveryOwnerBinding) => Promise<void>;
+  readonly dependencies: NativeRecoveryCollectorDependencies;
+}): Promise<TerminalCheckpointOwnerResolution>;
+export declare function discoverOwnedRecoveryLineage(input: {
+  readonly world: World;
+  readonly anchor: WorkflowRun;
+  readonly allowParked?: boolean;
+  readonly binding: NativeRecoveryOwnerBinding;
+  readonly authorizeOwner: (binding: NativeRecoveryOwnerBinding) => Promise<void>;
+  readonly dependencies: NativeRecoveryCollectorDependencies;
+}): Promise<TerminalCheckpointOwnerResolution>;
diff --git a/dist/src/execution/session/recovery-owner-provenance.js b/dist/src/execution/session/recovery-owner-provenance.js
