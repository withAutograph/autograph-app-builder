+/** Advisory structural diagnostics. Inputs stay private; outputs contain counts and opaque identity hashes only. */
+export declare function protocolIdentityHash(value: unknown): string | undefined;
+export declare function summarizeModelProtocol(messages: unknown): object;
+export declare function recordModelProtocolDiagnostic(input: {
+  logicalSessionId: string;
+  turnId?: string;
+  sdkCallId?: string;
+  harnessAttempt: number;
+  harnessStep: number;
+  sdkCallIndex: number;
+  canonical: unknown;
+  sdkInput: unknown;
+  sdkBeforeProvider: unknown;
+}): void;
+export declare function recordRecoveryProtocolDiagnostic(input: {
+  sourceOwnerRunId: string;
+  logicalSessionId: string;
+  selectedStepId?: string;
+  selectedEventId?: string;
+  selectedKind?: string;
+  outcome: string;
+  reconstructedCoordination?: boolean;
+  incomingRuntimeResultCount: number;
+  latest: unknown;
+  reconciled: unknown;
+  latestCoordination: unknown;
+  latestPendingInput: unknown;
+  nativeEvents: unknown;
+}): void;
+
+/** Emits only structural counts and opaque hashes from authentic retained candidates. */
+export declare function recordTerminalRecoveryObservation(
+  input: import("#execution/session/terminal-recovery.js").TerminalRecoveryObservationInput,
+): boolean;
diff --git a/dist/src/harness/model-protocol-diagnostic.js b/dist/src/harness/model-protocol-diagnostic.js
new file mode 100644
index 0000000..f971f73
--- /dev/null
+++ b/dist/src/harness/model-protocol-diagnostic.js
@@ -0,0 +1,633 @@
+import { createHash } from "node:crypto";
+import { isDeepStrictEqual } from "node:util";
+import { getStepMetadata, getWorkflowMetadata } from "#compiled/@workflow/core/index.js";
+import { createLogger } from "#internal/logging.js";
+
+import { getPendingCoordinationBatch } from "#harness/coordination.js";
+import { getPendingInputBatches } from "#harness/pending-input-batches.js";
+
+const log = createLogger("harness.model-protocol");
+const SAMPLE_LIMIT = 12;
+// One string keeps the sanitized nested summary intact in Production console sinks.
+// Passing an object as a second console argument lets Node elide it as [Object]/[Array].
+const emitProtocolDiagnostic = (marker, summary) =>
+  log.info(`${marker} ${JSON.stringify(summary)}`);
+export const protocolIdentityHash = (value) =>
+  typeof value === "string"
+    ? createHash("sha256").update("eve.model-protocol.id.v1\0").update(value).digest("hex")
+    : undefined;
+const partsOf = (message) => (Array.isArray(message?.content) ? message.content : []);
+
+// Inspect only protocol identity and structural flags. Never serialize authored content.
+export function summarizeModelProtocol(messages) {
+  const calls = new Map();
+  const requests = new Map();
+  const responses = [];
+  let callParts = 0,
+    resultParts = 0,
+    approvalRequests = 0,
+    approvalResponses = 0;
+  const rows = Array.isArray(messages) ? messages : [];
+  let tailStart = rows.length;
+  while (tailStart > 0 && rows[tailStart - 1]?.role === "tool") tailStart -= 1;
+  const fact = (id) => {
+    if (typeof id !== "string") return undefined;
+    let value = calls.get(id);
+    if (value === undefined) {
+      value = {
+        callCount: 0,
+        resultCount: 0,
+        providerExecutedCallCount: 0,
+        approvalRequestCount: 0,
+        approvedCount: 0,
+        deniedCount: 0,
+        approvedTailCount: 0,
+        callProviderOptionsCount: 0,
+        resultProviderOptionsCount: 0,
+        firstCallIndex: -1,
+        firstResultIndex: -1,
+      };
+      calls.set(id, value);
+    }
+    return value;
+  };
+  rows.forEach((message, index) => {
+    for (const part of partsOf(message)) {
+      if (part?.type === "tool-call") {
+        callParts += 1;
+        const value = fact(part.toolCallId);
+        if (value === undefined) continue;
+        value.callCount += 1;
+        if (value.firstCallIndex < 0) value.firstCallIndex = index;
+        if (part.providerExecuted === true) value.providerExecutedCallCount += 1;
+        if (part.providerOptions !== undefined || message.providerOptions !== undefined)
+          value.callProviderOptionsCount += 1;
+      } else if (part?.type === "tool-result") {
+        resultParts += 1;
+        const value = fact(part.toolCallId);
+        if (value === undefined) continue;
+        value.resultCount += 1;
+        if (value.firstResultIndex < 0) value.firstResultIndex = index;
+        if (part.providerOptions !== undefined || message.providerOptions !== undefined)
+          value.resultProviderOptionsCount += 1;
+      } else if (part?.type === "tool-approval-request") {
+        approvalRequests += 1;
+        requests.set(part.approvalId, { callId: part.toolCallId, index });
+        const value = fact(part.toolCallId);
+        if (value !== undefined) value.approvalRequestCount += 1;
+      } else if (part?.type === "tool-approval-response") {
+        approvalResponses += 1;
+        responses.push({ approvalId: part.approvalId, approved: part.approved === true, index });
+      }
+    }
+  });
+  let approvalResponsesWithoutRequest = 0,
+    approvalResponsesBeforeRequest = 0;
+  for (const response of responses) {
+    const request = requests.get(response.approvalId);
+    if (request === undefined) {
+      approvalResponsesWithoutRequest += 1;
+      continue;
+    }
+    if (response.index < request.index) approvalResponsesBeforeRequest += 1;
+    const value = fact(request.callId);
+    if (value === undefined) continue;
+    if (response.approved) {
+      value.approvedCount += 1;
+      if (response.index >= tailStart) value.approvedTailCount += 1;
+    } else value.deniedCount += 1;
+  }
+  const identities = [...calls].map(([id, value]) => ({
+    idHash: protocolIdentityHash(id),
+    ...value,
+  }));
+  const missing = identities.filter(
+    (value) => value.callCount > value.providerExecutedCallCount && value.resultCount === 0,
+  );
+  const orphaned = identities.filter((value) => value.resultCount > 0 && value.callCount === 0);
+  const duplicates = identities.filter((value) => value.callCount > 1 || value.resultCount > 1);
+  const reversed = identities.filter(
+    (value) => value.firstResultIndex >= 0 && value.firstCallIndex > value.firstResultIndex,
+  );
+  const anomalies = identities.filter(
+    (value) =>
+      missing.includes(value) ||
+      orphaned.includes(value) ||
+      duplicates.includes(value) ||
+      reversed.includes(value),
+  );
+  const sample = [...anomalies, ...identities.filter((value) => !anomalies.includes(value))].slice(
+    0,
+    SAMPLE_LIMIT,
+  );
+  return {
+    messageCount: rows.length,
+    callParts,
+    resultParts,
+    approvalRequests,
+    approvalResponses,
+    identityCount: identities.length,
+    missingResultCount: missing.length,
+    orphanResultCount: orphaned.length,
+    duplicateIdentityCount: duplicates.length,
+    resultBeforeCallCount: reversed.length,
+    approvalResponsesWithoutRequest,
+    approvalResponsesBeforeRequest,
+    terminalToolMessageCount: rows.length - tailStart,
+    terminalApprovedResponseCount: responses.filter(
+      (value) => value.approved && value.index >= tailStart,
+    ).length,
+    protocolHash: createHash("sha256")
+      .update("eve.model-protocol.structure.v1\0")
+      .update(JSON.stringify(identities))
+      .digest("hex"),
+    sample,
+    omittedIdentityCount: identities.length - sample.length,
+  };
+}
+
+function workflowIdentity(logicalSessionId) {
+  let physicalRunId, stepId, workflowAttempt;
+  try {
+    physicalRunId = getWorkflowMetadata().workflowRunId;
+  } catch {}
+  try {
+    const metadata = getStepMetadata();
+    stepId = metadata.stepId;
+    workflowAttempt = metadata.attempt;
+  } catch {}
+  return {
+    physicalRunHash: protocolIdentityHash(physicalRunId),
+    logicalSessionHash: protocolIdentityHash(logicalSessionId),
+    physicalEqualsLogical:
+      physicalRunId === undefined ? undefined : physicalRunId === logicalSessionId,
+    stepHash: protocolIdentityHash(stepId),
+    workflowAttempt,
+  };
+}
+
+export function recordModelProtocolDiagnostic(input) {
+  try {
+    const identity = workflowIdentity(input.logicalSessionId);
+    emitProtocolDiagnostic("before-model-protocol", {
+      version: 1,
+      ...identity,
+      turnHash: protocolIdentityHash(input.turnId),
+      harnessAttempt: input.harnessAttempt,
+      harnessStep: input.harnessStep,
+      sdkCallIndex: input.sdkCallIndex,
+      sdkCallHash: protocolIdentityHash(input.sdkCallId),
+      canonical: summarizeModelProtocol(input.canonical),
+      sdkInput: summarizeModelProtocol(input.sdkInput),
+      sdkBeforeProvider: summarizeModelProtocol(input.sdkBeforeProvider),
+    });
+  } catch {}
+}
+
+function summarizeNativeResults(events) {
+  const results = new Map();
+  let resultEventCount = 0;
+  for (const event of events ?? []) {
+    const id = event?.type === "action.result" ? event.data?.result?.callId : undefined;
+    if (typeof id !== "string") continue;
+    resultEventCount += 1;
+    results.set(id, (results.get(id) ?? 0) + 1);
+  }
+  const identities = [...results].map(([id, count]) => ({
+    idHash: protocolIdentityHash(id),
+    count,
+  }));
+  return {
+    resultEventCount,
+    identityCount: identities.length,
+    sample: identities.slice(0, SAMPLE_LIMIT),
+    omittedIdentityCount: Math.max(0, identities.length - SAMPLE_LIMIT),
+  };
+}
+
+export function recordRecoveryProtocolDiagnostic(input) {
+  try {
+    emitProtocolDiagnostic("recovery-protocol", {
+      version: 1,
+      sourceOwnerRunHash: protocolIdentityHash(input.sourceOwnerRunId),
+      logicalSessionHash: protocolIdentityHash(input.logicalSessionId),
+      selectedStepHash: protocolIdentityHash(input.selectedStepId),
+      selectedEventHash: protocolIdentityHash(input.selectedEventId),
+      selectedKindHash: protocolIdentityHash(input.selectedKind),
+      outcomeHash: protocolIdentityHash(input.outcome),
+      reconstructedCoordination: input.reconstructedCoordination === true,
+      incomingRuntimeResultCount: input.incomingRuntimeResultCount,
+      latest: summarizeModelProtocol(input.latest),
+      reconciled: summarizeModelProtocol(input.reconciled),
+      latestCoordination: summarizeModelProtocol(input.latestCoordination),
+      latestPendingInput: summarizeModelProtocol(input.latestPendingInput),
+      nativeResults: summarizeNativeResults(input.nativeEvents),
+    });
+  } catch {}
+}
+
+// These are observations, never nonexecution certificates. In particular, older
+// harness retries did not retain each attempt, and inline errors can lack an
+// action.result event. Do not use absence in this summary to authorize replay.
+const eventCoordinates = (event) => ({
+  sequence: Number.isSafeInteger(event?.data?.sequence) ? event.data.sequence : undefined,
+  stepIndex: Number.isSafeInteger(event?.data?.stepIndex) ? event.data.stepIndex : undefined,
+  turnHash: protocolIdentityHash(event?.data?.turnId),
+});
+const frameworkKinds = new Set([
+  "user",
+  "context.instruction",
+  "context.state",
+  "context.compaction",
+  "memory.load",
+  "execution.background_task",
+  "execution.continuation",
+  "execution.retry",
+]);
+function tailStructure(messages) {
+  return (messages ?? []).slice(-SAMPLE_LIMIT).map((message, index, rows) => ({
+    index: (messages?.length ?? 0) - rows.length + index,
+    role: ["system", "user", "assistant", "tool"].includes(message?.role)
+      ? message.role
+      : "unknown",
+    kind: frameworkKinds.has(message?.kind) ? message.kind : undefined,
+    kindHash: frameworkKinds.has(message?.kind) ? undefined : protocolIdentityHash(message?.kind),
+    partCount: partsOf(message).length,
+    callCount: partsOf(message).filter((part) => part?.type === "tool-call").length,
+    resultCount: partsOf(message).filter((part) => part?.type === "tool-result").length,
+    approvalResponseCount: partsOf(message).filter(
+      (part) => part?.type === "tool-approval-response",
+    ).length,
+  }));
+}
+function countedHashes(values) {
+  const counts = new Map();
+  for (const value of values) {
+    const hash = protocolIdentityHash(value);
+    if (hash !== undefined) counts.set(hash, (counts.get(hash) ?? 0) + 1);
+  }
+  return {
+    distinctCount: counts.size,
+    sample: [...counts].slice(0, SAMPLE_LIMIT).map(([hash, count]) => ({ hash, count })),
+    omittedCount: Math.max(0, counts.size - SAMPLE_LIMIT),
+  };
+}
+function missingCallFrontier(payload, candidates) {
+  const latest = candidates[0]?.sessionState?.snapshot?.session;
+  const latestParts = (latest?.history ?? []).flatMap(partsOf);
+  const results = new Set(
+    latestParts.filter((part) => part.type === "tool-result").map((part) => part.toolCallId),
+  );
+  const missing = [
+    ...new Map(
+      latestParts
+        .filter(
+          (part) =>
+            part.type === "tool-call" &&
+            part.providerExecuted !== true &&
+            !results.has(part.toolCallId),
+        )
+        .map((part) => [part.toolCallId, part]),
+    ).values(),
+  ];
+  const native = payload?.nativeEvents ?? [];
+  const rows = missing.slice(0, SAMPLE_LIMIT).map((call) => {
+    const callId = call.toolCallId;
+    const bindings = [];
+    const requestIds = new Set();
+    const pendingCoordinates = [];
+    for (const candidate of candidates) {
+      const session = candidate.sessionState?.snapshot?.session;
+      const coordination = getPendingCoordinationBatch(session?.state ?? {});
+      for (const batch of getPendingInputBatches(session?.state ?? {})) {
+        const pendingCall = batch.responseMessages
+          .flatMap(partsOf)
+          .find((part) => part.type === "tool-call" && part.toolCallId === callId);
+        for (const request of batch.requests.filter(
+          (request) => request.action?.callId === callId,
+        )) {
+          requestIds.add(request.requestId);
+          if (batch.event !== undefined) pendingCoordinates.push(batch.event);
+          const responses = (candidate.incoming?.delivery?.payloads ?? [])
+            .flatMap((value) => value.inputResponses ?? [])
+            .filter((value) => value.requestId === request.requestId);
+          const resolutions = native
+            .filter((event) => event.type === "input.resolved")
+            .flatMap((event) =>
+              (event.data?.resolutions ?? [])
+                .filter((value) => value.requestId === request.requestId)
+                .map((value) => ({ event, value })),
+            );
+          bindings.push({
+            slot: candidate.origin.slot,
+            stepHash: protocolIdentityHash(candidate.origin.stepId),
+            requestHash: protocolIdentityHash(request.requestId),
+            requestKindHash: protocolIdentityHash(request.kind),
+            toolNameHash: protocolIdentityHash(request.action.toolName),
+            sameCallBytes: pendingCall !== undefined && isDeepStrictEqual(pendingCall, call),
+            sameActionInput:
+              request.action.toolName === call.toolName &&
+              isDeepStrictEqual(request.action.input, call.input),
+            replayIdentityPresent: batch.toolReplayIdentities?.[request.requestId] !== undefined,
+            responseAuthRequired:
+              batch.responseAuthRequiredRequestIds?.includes(request.requestId) === true,
+            pendingCoordinates: eventCoordinates({ data: batch.event }),
+            incomingResponseCount: responses.length,
+            incomingAuthPresent: candidate.incoming?.delivery?.auth != null,
+            acceptedIncomingResponseMatchCount: resolutions.filter(
+              ({ value }) =>
+                value.response !== undefined &&
+                responses.some((response) => isDeepStrictEqual(response, value.response)),
+            ).length,
+            inputResolutionCount: resolutions.length,
+            inputResolutionSample: resolutions.slice(0, SAMPLE_LIMIT).map(({ event, value }) => ({
+              ...eventCoordinates(event),
+              outcomeHash: protocolIdentityHash(value.outcome),
+              responsePresent: value.response !== undefined,
+            })),
+            inputResolutionOutcomes: countedHashes(resolutions.map(({ value }) => value.outcome)),
+            retainedExecutionClass: coordination?.runtimeActions?.some(
+              (value) => value.callId === callId,
+            )
+              ? "runtime-action"
+              : coordination?.tasks?.some((value) => value.callId === callId)
+                ? "workflow-task"
+                : "approval-without-retained-deferred-dispatch",
+          });
+        }
+      }
+    }
+    const firstSequence = pendingCoordinates.length
+      ? Math.min(...pendingCoordinates.map((value) => value.sequence))
+      : undefined;
+    const acceptedIndex = native.findIndex(
+      (event) =>
+        (event.type === "input.resolved" &&
+          (event.data?.resolutions ?? []).some(
+            (value) => requestIds.has(value.requestId) && value.outcome === "approved",
+          )) ||
+        (event.type === "approval.settled" &&
+          requestIds.has(event.data?.requestId) &&
+          event.data.outcome === "approved"),
+    );
+    const frontier =
+      acceptedIndex >= 0
+        ? native.slice(acceptedIndex)
+        : native.filter(
+            (event) =>
+              firstSequence === undefined ||
+              event.data?.sequence === undefined ||
+              event.data.sequence >= firstSequence,
+          );
+    const failureRows = frontier.filter(
+      (event) => event.type === "step.failed" || event.type === "turn.failed",
+    );
+    const exactMissingMessage = `No tool output found for function call ${callId}`;
+    const matchResult = (event) => event.data?.result?.callId === callId;
+    const accepted = native.filter(
+      (event) => event.type === "approval.settled" && requestIds.has(event.data?.requestId),
+    );
+    const requested = native.filter(
+      (event) =>
+        event.type === "actions.requested" &&
+        event.data?.actions?.some((value) => value.callId === callId),
+    );
+    const nativeSteps = (payload?.steps ?? []).filter(
+      (value) => value.arguments?.args?.[0]?.sessionState !== undefined,
+    );
+    const durableDispatches = nativeSteps.filter((value) => {
+      if (!value.step?.stepName?.includes("dispatchCoordinationStep")) return false;
+      const batch = getPendingCoordinationBatch(
+        value.arguments.args[0].sessionState?.snapshot?.session?.state ?? {},
+      );
+      return [...(batch?.runtimeActions ?? []), ...(batch?.tasks ?? [])].some(
+        (action) => action.callId === callId,
+      );
+    });
+    const durableResults = (payload?.steps ?? []).filter((value) =>
+      (value.output?.results ?? []).some((result) => result.callId === callId),
+    );
+    return {
+      callHash: protocolIdentityHash(callId),
+      toolNameHash: protocolIdentityHash(call.toolName),
+      providerExecuted: call.providerExecuted === true,
+      bindingCount: bindings.length,
+      bindingSample: bindings.slice(0, SAMPLE_LIMIT),
+      omittedBindingCount: Math.max(0, bindings.length - SAMPLE_LIMIT),
+      approvalSettledCount: accepted.length,
+      approvalSettledSample: accepted.slice(0, SAMPLE_LIMIT).map((event) => ({
+        ...eventCoordinates(event),
+        requestHash: protocolIdentityHash(event.data.requestId),
+        responderHash: protocolIdentityHash(event.data.responderPrincipalId),
+        outcomeHash: protocolIdentityHash(event.data.outcome),
+      })),
+      actionRequestedCount: requested.length,
+      actionRequestedSample: requested.slice(0, SAMPLE_LIMIT).map(eventCoordinates),
+      actionResultCount: native.filter(
+        (event) => event.type === "action.result" && matchResult(event),
+      ).length,
+      actionPartialCount: native.filter(
+        (event) => event.type === "action.partial" && matchResult(event),
+      ).length,
+      incomingRuntimeResultCount: candidates.reduce(
+        (count, candidate) =>
+          count +
+          (candidate.incoming?.runtimeResults?.results ?? []).filter(
+            (value) => value.callId === callId,
+          ).length,
+        0,
+      ),
+      frontierUsesWholeStream: acceptedIndex < 0 && firstSequence === undefined,
+      frontierFromAcceptedApproval: acceptedIndex >= 0,
+      approvalResolutionStreamIndex: acceptedIndex < 0 ? undefined : acceptedIndex,
+      frontierEventTypes: countedHashes(frontier.map((event) => event.type)),
+      failedStepOrTurnCount: failureRows.length,
+      exactMissingCallFailureCount: failureRows.filter(
+        (event) =>
+          typeof event.data?.message === "string" &&
+          event.data.message.includes(exactMissingMessage),
+      ).length,
+      failureSample: failureRows.slice(-SAMPLE_LIMIT).map((event) => ({
+        ...eventCoordinates(event),
+        typeHash: protocolIdentityHash(event.type),
+        codeHash: protocolIdentityHash(event.data?.code),
+        exactMissingCall:
+          typeof event.data?.message === "string" &&
+          event.data.message.includes(exactMissingMessage),
+      })),
+      completedStepCount: frontier.filter((event) => event.type === "step.completed").length,
+      cancelledTurnCount: frontier.filter((event) => event.type === "turn.cancelled").length,
+      modelStartedCount: frontier.filter((event) => event.type === "step.started").length,
+      compactionRequestedCount: frontier.filter((event) => event.type === "compaction.requested")
+        .length,
+      compactionCompletedCount: frontier.filter((event) => event.type === "compaction.completed")
+        .length,
+      durableDispatchCount: durableDispatches.length,
+      durableDispatchSample: durableDispatches.slice(0, SAMPLE_LIMIT).map((value) => ({
+        stepHash: protocolIdentityHash(value.step.stepId),
+        statusHash: protocolIdentityHash(value.step.status),
+        resultForCallPresent: (value.output?.results ?? []).some(
+          (result) => result.callId === callId,
+        ),
+      })),
+      durableResultStepCount: durableResults.length,
+      durableResultStepSample: durableResults.slice(0, SAMPLE_LIMIT).map((value) => ({
+        stepHash: protocolIdentityHash(value.step.stepId),
+        statusHash: protocolIdentityHash(value.step.status),
+      })),
+      retainedTurnInputCount: nativeSteps.filter((value) =>
+        value.step?.stepName?.includes("turnStep"),
+      ).length,
+      retainedTurnInputWithStreamCount: nativeSteps.filter(
+        (value) =>
+          value.step?.stepName?.includes("turnStep") &&
+          value.arguments.args[0].sessionWritable !== undefined,
+      ).length,
+      // This runtime did not persist individual old harness attempt outcomes.
+      individualHarnessAttemptEvidenceAvailable: false,
+      registeredToolExecutionClassAvailable: false,
+    };
+  });
+  return {
+    missingCallCount: missing.length,
+    sample: rows,
+    omittedCallCount: Math.max(0, missing.length - SAMPLE_LIMIT),
+  };
+}
+function nativeStepFrontier(payload, candidates) {
+  const inputSlots = candidates
+    .filter((candidate) => candidate.incoming !== undefined)
+    .map((candidate) => candidate.origin.slot);
