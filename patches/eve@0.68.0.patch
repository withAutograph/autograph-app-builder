+  if (resolved.length === 0) return;
+  for (const entry of resolved) {
+    if (entry.outcome !== "approved") continue;
+    const name = entry.request.action.toolName;
+    if (entry.toolReplayIdentity !== undefined && input.toolReplayIdentity?.(name) !== entry.toolReplayIdentity)
