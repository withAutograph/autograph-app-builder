+import type { World, WorkflowRun, Step, Event } from "#compiled/@workflow/world/index.js";
+import type { PayloadKey } from "#compiled/@workflow/core/serialization/encryption.js";
+import type { DurableSession, DurableSessionState } from "#execution/durable-session-store.js";
+import type { TurnStepPayload } from "#execution/session/turn-step-types.js";
+import type { MessageStreamEvent } from "#protocol/message.js";
+
+/** Obtained from a canonical tenant-scoped server reservation, never model/client authority. */
+export interface NativeRecoveryOwnerBinding {
+  readonly ownerRunId: string;
+  readonly logicalSessionId: string;
+}
+export interface CollectTerminalRecoveryCandidateInput {
+  readonly binding: NativeRecoveryOwnerBinding;
+  /** Re-resolve current owner/membership and the canonical source binding. Called before private I/O. */
+  readonly authorizeOwner: (binding: NativeRecoveryOwnerBinding) => Promise<void>;
+}
+declare const privateCandidateBrand: unique symbol;
+/** In-process capability only. JSON serialization does not reveal its private payload. */
+export interface PrivateNativeRecoveryCandidate {
+  readonly kind: "private-native-recovery-candidate";
+  readonly version: 1;
+  readonly [privateCandidateBrand]: true;
+}
+export type NativeRecoveryCandidateKind =
+  | "terminal-finalizer-input"
+  | "completed-terminal-turn-input"
+  | "failed-turn-input"
+  | "committed-turn-output";
+export interface NativeRecoveryOrigin {
+  readonly eventId: string;
+  readonly slot: number;
+  readonly stepId: string;
+}
+export interface PairedNativeRecoveryCheckpoint {
+  readonly kind: NativeRecoveryCandidateKind;
+  readonly origin: NativeRecoveryOrigin;
+  readonly serializedContext: Record<string, unknown>;
+  readonly sessionState: DurableSessionState;
+  readonly incoming?: TurnStepPayload;
+}
+export type NativeRecoveryUncertaintyReason =
+  | "native-step-input-unreadable"
+  | "native-step-output-unreadable"
+  | "native-stream-incomplete"
+  | "failed-turn-effects-unreconciled"
+  | "completed-terminal-effects-unreconciled";
+export interface PrivateNativeRecoveryPayload {
+  readonly version: 1;
+  readonly binding: NativeRecoveryOwnerBinding;
+  readonly run: WorkflowRun;
+  /** Native-only hydration capability for run.input; never serialize or expose publicly. */
+  readonly nativeRunKey: PayloadKey | undefined;
+  readonly candidates: readonly PairedNativeRecoveryCheckpoint[];
+  /** Complete retained native event log; includes facts preceding the preferred candidate. */
+  readonly events: readonly Event[];
+  readonly frontier: readonly {
+    readonly origin: NativeRecoveryOrigin;
+    readonly events: readonly Event[];
+  }[];
+  /** Relevant native steps fetched once; unrelated raw facts stay in events/frontier. */
+  readonly steps: readonly {
+    readonly step: Step;
+    readonly arguments?: unknown;
+    readonly output?: unknown;
+  }[];
+  /** Actual persisted protocol events, including results; these do not imply authored-state commit. */
+  readonly nativeEvents: readonly MessageStreamEvent[];
+  readonly issues: readonly {
+    readonly reason: NativeRecoveryUncertaintyReason;
+    readonly stepId?: string;
+  }[];
+}
+export interface NativeRecoveryInspection {
+  readonly version: 1;
+  readonly candidates: readonly {
+    readonly kind: NativeRecoveryCandidateKind;
+    readonly slot: number;
+    readonly workflowPhase: string;
+    readonly privateApplyGrantPresent: boolean;
+    readonly sandboxStatePresent: boolean;
+    readonly historyMessageCount: number;
+    readonly incomingRuntimeResultCount: number;
+    readonly incomingDeliveryPresent: boolean;
+  }[];
+  readonly nativeEventCount: number;
+  readonly uncertaintyReasons: readonly NativeRecoveryUncertaintyReason[];
+  readonly requiresTrustedReconciliation: true;
+}
+export type TerminalRecoveryCandidateResult =
+  | {
+      readonly kind: "candidate";
+      readonly candidate: PrivateNativeRecoveryCandidate;
+      readonly inspection: NativeRecoveryInspection;
+    }
+  | {
+      readonly kind: "unavailable";
+      readonly reason:
+        | "source-not-terminal"
+        | "native-data-expired"
+        | "paired-native-checkpoint-unavailable";
+    };
+export interface NativeRecoveryCollectorDependencies {
+  readonly getWorld: () => Promise<World>;
+  readonly resolveRunEncryptionKey: (
+    world: World,
+    run: WorkflowRun,
+  ) => Promise<PayloadKey | undefined>;
+  readonly hydrateStepArguments: (
+    data: unknown,
+    runId: string,
+    key: PayloadKey | undefined,
+  ) => Promise<unknown>;
+  readonly hydrateStepReturnValue: (
+    data: unknown,
+    runId: string,
+    key: PayloadKey | undefined,
+  ) => Promise<unknown>;
+  readonly readDurableSession: (state: DurableSessionState) => DurableSession;
+  readonly requireEventSlot: (eventId: string) => number;
+  readonly readNativeEvents: (runId: string) => AsyncIterable<MessageStreamEvent>;
+  readonly now: () => number;
+}
+/** Native framework server wiring, with required app-owned authorization integration. No public route. */
+export declare function collectTerminalRecoveryCandidate(
+  input: CollectTerminalRecoveryCandidateInput,
+): Promise<TerminalRecoveryCandidateResult>;
+export declare function createTerminalRecoveryCandidateCollector(
+  dependencies: NativeRecoveryCollectorDependencies,
+): (input: CollectTerminalRecoveryCandidateInput) => Promise<TerminalRecoveryCandidateResult>;
+/** Trusted native reconciliation/import code only; never place the result in a public response or log. */
+export declare function readTerminalRecoveryCandidate(
+  handle: PrivateNativeRecoveryCandidate,
+): PrivateNativeRecoveryPayload;
