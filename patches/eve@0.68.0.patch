+export async function deriveTerminalRecoveryResumePhase(reconciled) {
+  "use step";
+  const [{ readDurableSession }, { getPendingInputBatches, getDeferredStepInput }, { getApprovalAuditState }, { getProxyInputRequests }, { getPendingCoordinationBatch }, { getPendingAuthorization }, { getBlockingWorkflowToolRuns, getBackgroundTasks }, { getAgentHandleStore }] = await Promise.all([
+    import("#execution/durable-session-store.js"), import("#harness/pending-input-batches.js"), import("#harness/approval-candidates.js"), import("#harness/proxy-input-requests.js"), import("#harness/coordination.js"), import("#harness/authorization.js"), import("#harness/workflow-tool-runs.js"), import("#subagents/handles/store.js"),
+  ]);
+  const session = readDurableSession(reconciled.checkpointCore.sessionState);
+  const state = session.state;
+  const pending = getPendingInputBatches(state);
+  if (getApprovalAuditState(state).activeCandidates.length > 0) return undefined;
+  if (pending.length > 0) return pending.some((batch) => batch.requests.some((request) => request.kind !== "tool-approval")) ? undefined : "replay";
+  if (getDeferredStepInput(session) !== undefined || (getPendingAuthorization(state)?.challenges.length ?? 0) > 0 || getProxyInputRequests(state).size > 0 || getPendingCoordinationBatch(state) !== undefined || reconciled.replayInput !== undefined || (reconciled.carriedInbox?.length ?? 0) > 0) return undefined;
+  if (getBlockingWorkflowToolRuns(state).length > 0 || getBackgroundTasks(state).query().some((task) => !["completed", "failed", "cancelled"].includes(task.status))) return undefined;
+  if (getAgentHandleStore(state)?.handles.some((handle) => ["starting", "running", "reserved", "claimed"].includes(handle.phase))) return undefined;
+  return "await-input";
+}
