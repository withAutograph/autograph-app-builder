--- /dev/null
+++ b/dist/src/execution/session/terminal-recovery-boot.js
@@ -0,0 +1,141 @@
+import { decodeSessionInboxPayload } from "#execution/session-inbox/protocol.js";
+import { activeTurnId } from "#harness/active-turn-id.js";
+import { createHook, getWorkflowMetadata, getWritable } from "#compiled/@workflow/core/index.js";
+import { createSessionInbox } from "#execution/session-inbox/inbox.js";
+import { sessionHookTokens } from "#execution/session/hook-tokens.js";
+import { validateTerminalRecoveryCheckpointStep } from "#execution/session/handoff-steps.js";
+import { sessionTimeoutDeadline } from "#execution/session/timeout.js";
+
+function isRestorableTerminalInboxPayload(payload, sourceTurnId) {
+  let decoded;
+  try {
+    decoded = decodeSessionInboxPayload(payload);
+  } catch {
+    return false;
+  }
+  if (decoded.kind === "cancel") {
+    return (
+      typeof decoded.turnId === "string" &&
+      decoded.turnId === sourceTurnId &&
+      Object.keys(decoded).every((key) => ["kind", "turnId"].includes(key))
+    );
+  }
+  return decoded.kind === "deliver";
+}
+
+/** No harness, tool, model, or sandbox lifecycle starts before the durable receipt is activated. */
+export async function bootTerminalRecoveryOwner(input) {
+  return await bootTerminalRecoveryOwnerWithPorts(input, {
+    createHook,
+    createSessionInbox,
+    getWorkflowMetadata,
+    getWritable,
+    validateCheckpoint: validateTerminalRecoveryCheckpointStep,
+  });
+}
+
+export async function bootTerminalRecoveryOwnerWithPorts(input, ports) {
+  const { checkpoint, descriptor } = input;
+  if (
+    checkpoint.sessionState.sessionId !== descriptor.logicalSessionId ||
+    checkpoint.serializedContext["eve.sessionId"] !== descriptor.logicalSessionId
+  ) {
+    throw new Error("Terminal recovery checkpoint identity changed.");
+  }
+  const carriedInbox = input.carriedInbox ?? [];
+  if (input.provenance.resumePhase === "await-input") {
+    const { deriveTerminalRecoveryResumePhase } = await import("#execution/session/recovery-resume-phase.js");
+    if (await deriveTerminalRecoveryResumePhase({ checkpointCore: checkpoint, replayInput: input.replayInput, carriedInbox }) !== "await-input") throw new Error("Idle recovery checkpoint contains pending work.");
+  }
+  const ids = new Set();
+  for (const [index, item] of carriedInbox.entries()) {
+    if (
+      item.runId !== (input.provenance.checkpointOwnerRunId ?? descriptor.sourceOwnerRunId) ||
+      typeof item.eventId !== "string" ||
+      !/^evnt_[0-9]{26}$/u.test(item.eventId) ||
+      Number(item.eventId.slice(5)) !== item.slot ||
+      !Number.isSafeInteger(item.slot) ||
+      typeof item.correlationId !== "string" ||
+      item.correlationId.length === 0 ||
+      item.slot <= input.provenance.sourceSlot ||
+      ids.has(item.eventId) ||
+      (index > 0 && item.slot <= carriedInbox[index - 1].slot) ||
+      !isRestorableTerminalInboxPayload(
+        item.payload,
+        activeTurnId(checkpoint.sessionState.emissionState),
+      )
+    )
+      throw new Error("Terminal recovery retained inbox binding changed.");
+    ids.add(item.eventId);
+  }
+  const validateCheckpoint = ports.validateCheckpoint;
+  await validateCheckpoint({ checkpoint });
+  const ownerRunId = ports.getWorkflowMetadata().workflowRunId;
+  const inbox = ports.createSessionInbox(descriptor.logicalSessionId);
+  let activation;
+  let transferred = false;
+  let stopInterrupt;
+  try {
+    // Never force a claim: a live owner or another recovery wins over this candidate.
+    await inbox.claimSessionHooks(sessionHookTokens(checkpoint));
+    let cancel;
+    const cancelled = new Promise((resolve) => {
+      cancel = resolve;
+    });
+    stopInterrupt = inbox.onInterrupt(() => cancel(undefined));
+    const acceptedBeforeActivation = inbox.drain();
+    inbox.restore(acceptedBeforeActivation);
+    if (
+      acceptedBeforeActivation.some((payload) =>
+        ["cancel", "reset", "session-timeout"].includes(payload.kind),
+      )
+    )
+      return;
+    activation = ports.createHook({
+      token: input.activationToken,
+      metadata: {
+        recoveryBinding: { ...descriptor, ownerRunId, provenance: input.provenance },
+      },
+    });
+    if (await activation.getConflict()) return;
+    const accepted = await Promise.race([activation, cancelled]);
+    if (accepted === undefined) return;
+    if (
+      accepted?.kind !== "activate-terminal-recovery" ||
+      accepted.operationId !== descriptor.operationId ||
+      accepted.ownerRunId !== ownerRunId
+    ) {
+      throw new Error("Terminal recovery activation does not match its durable receipt.");
+    }
+    // Historical accepted commands are not new-owner preactivation interrupts.
+    // Preserve their FIFO ahead of live arrivals, then use ordinary admission.
+    inbox.restore(carriedInbox.map((item) => item.payload));
+    const boot = {
+      inbox,
+      session: {
+        anchor: { kind: "self" },
+        recovery: true,
+        streamRunId: ownerRunId,
+        caller: input.replayInput?.delivery?.caller,
+        capabilities: checkpoint.capabilities,
+        deploymentId: input.ownerDeploymentId,
+        initialInput: undefined,
+        initialTurnInput: input.replayInput,
+        awaitFirstMessage: input.provenance.resumePhase === "await-input",
+        retention: checkpoint.retention,
+        serializedContext: checkpoint.serializedContext,
+        sessionId: descriptor.logicalSessionId,
+        sessionState: checkpoint.sessionState,
+        sessionTimeoutMs: checkpoint.sessionTimeoutMs,
+        sessionTimeoutDeadline: sessionTimeoutDeadline(checkpoint.sessionTimeoutMs, Date.now()),
+        sessionWritable: ports.getWritable(),
+      },
+    };
+    transferred = true;
+    return boot;
+  } finally {
+    stopInterrupt?.();
+    activation?.dispose();
+    if (!transferred) await inbox.dispose();
+  }
+}
