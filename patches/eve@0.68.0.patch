+          throw new Error("Native recovery step owner differs.");
+        if (!relevantSteps.has(nativeFunction(metadata.stepName))) {
+          const retained = { step: { ...metadata, input: undefined, output: undefined } };
+          steps.set(stepId, retained);
+          return retained;
+        }
+      }
+      const step = await world.steps.get(run.runId, stepId, { resolveData: "all" });
+      if (metadata !== undefined && step.stepName !== metadata.stepName)
+        throw new Error("Native recovery step name differs.");
+      if (step.runId !== run.runId || step.stepId !== stepId) {
+        throw new Error("Native recovery step owner differs.");
+      }
