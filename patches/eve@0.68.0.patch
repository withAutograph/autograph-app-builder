+// Server-only native checkpoint inspection. This module never starts/resumes a run.
+// The caller MUST supply canonical ownership authorization; model/client IDs are
+// not authority. Payloads remain behind an in-process opaque handle.
+const payloads = new WeakMap();
+const isRecord = (value) => value !== null && typeof value === "object";
+const nativeFunction = (name) =>
+  String(name ?? "")
+    .split(/[/:#]/u)
+    .at(-1);
+const coordinates = (event, slot) => ({
+  eventId: event.eventId,
+  slot,
+  stepId: event.correlationId,
+});
+// Eve's vendored World index is type-only at runtime. Follow its native
+// slot-identity contract directly rather than importing a bundler chunk name.
+const nativeEventSlot = (eventId) => {
+  if (!/^evnt_[0-9]{26}$/u.test(eventId))
+    throw new Error("Native recovery event has no slot identity.");
+  const slot = Number(eventId.slice(5));
+  if (!Number.isSafeInteger(slot) || slot < 1)
+    throw new Error("Native recovery event has no slot identity.");
+  return slot;
+};
+const workflowPhases = new Set([
+  "empty",
+  "prepared",
+  "ui_previewed",
+  "ui_accepted",
+  "app_spec_accepted",
+  "dependencies_prepared",
+  "identity_resolved",
+  "planned",
+  "apply_failed",
+  "applied",
+  "validation_pending",
+  "validation_failed",
+  "validated",
+  "reviewed",
+  "publication_pending",
+  "publication_failed",
+  "published_local",
+  "branch_publication_pending",
+  "branch_publication_failed",
+  "published_branch_worktree",
+  "fresh_bootstrap_pending",
+  "fresh_bootstrap_failed",
+  "published_fresh_bootstrap",
+]);
+
+export function readTerminalRecoveryCandidate(handle) {
+  const payload = payloads.get(handle);
+  if (payload === undefined) throw new Error("Unknown private native recovery candidate.");
+  return payload;
+}
+
+/** Dependencies are native SDK operations, injectable for synthetic fixtures. */
+export function createTerminalRecoveryCandidateCollector(dependencies) {
+  return async function collectTerminalRecoveryCandidate(input) {
+    const { binding: suppliedBinding, authorizeOwner } = input;
+    if (
+      !isRecord(suppliedBinding) ||
+      typeof suppliedBinding.ownerRunId !== "string" ||
+      !suppliedBinding.ownerRunId ||
+      typeof suppliedBinding.logicalSessionId !== "string" ||
+      !suppliedBinding.logicalSessionId ||
+      typeof authorizeOwner !== "function"
+    ) {
+      throw new Error("Canonical server ownership authorization is required.");
+    }
+    const binding = Object.freeze({
+      ownerRunId: suppliedBinding.ownerRunId,
+      logicalSessionId: suppliedBinding.logicalSessionId,
+    });
+    // Authorization precedes every private World/stream operation.
+    await authorizeOwner(binding);
+    const world = await dependencies.getWorld();
+    const run = await world.runs.get(binding.ownerRunId, { resolveData: "all" });
+    if (run.runId !== binding.ownerRunId) throw new Error("Native recovery run identity differs.");
+    // Public Builder failure is checked by authorizeOwner. A terminal model
+    // failure can settle the native workflow successfully with next.done.
+    if (!["failed", "completed"].includes(run.status))
+      return { kind: "unavailable", reason: "source-not-terminal" };
+    if (run.expiredAt !== undefined && new Date(run.expiredAt).getTime() <= dependencies.now()) {
+      return { kind: "unavailable", reason: "native-data-expired" };
+    }
+    const key = await dependencies.resolveRunEncryptionKey(world, run);
+    const events = [];
+    const seenEvents = new Set();
+    let cursor;
+    const cursors = new Set();
+    do {
+      const page = await world.events.list({
+        runId: binding.ownerRunId,
+        pagination: { limit: 128, sortOrder: "asc", ...(cursor === undefined ? {} : { cursor }) },
+        resolveData: "all",
+      });
+      for (const event of page.data) {
+        if (seenEvents.has(event.eventId)) continue;
+        if (event.runId !== binding.ownerRunId)
+          throw new Error("Native recovery event owner differs.");
+        const slot = dependencies.requireEventSlot(event.eventId);
+        if (events.length > 0 && slot <= events.at(-1).slot) {
+          throw new Error("Native recovery event order differs.");
+        }
+        seenEvents.add(event.eventId);
+        events.push({ event, slot });
+      }
+      if (!page.hasMore) break;
+      if (!page.cursor || cursors.has(page.cursor))
+        throw new Error("Native recovery pagination did not advance.");
+      cursors.add(page.cursor);
+      cursor = page.cursor;
+    } while (true);
+
+    const issues = [];
+    const steps = new Map();
+    const candidates = [];
+    const stepNames = new Map();
+    const inputOrigins = new Map();
+    for (const { event } of events) {
+      if (event.correlationId && typeof event.eventData?.stepName === "string") {
+        stepNames.set(event.correlationId, nativeFunction(event.eventData.stepName));
+      }
+      if (
+        event.correlationId &&
+        !inputOrigins.has(event.correlationId) &&
+        ["step_created", "step_started"].includes(event.eventType)
+      ) {
+        inputOrigins.set(
+          event.correlationId,
+          coordinates(event, dependencies.requireEventSlot(event.eventId)),
+        );
+      }
+    }
+    const relevantSteps = new Set([
+      "turnStep",
+      "terminateChildSessionsStep",
+      "dispatchCoordinationStep",
+    ]);
+    const readStep = async (stepId) => {
+      if (steps.has(stepId)) return steps.get(stepId);
+      const step = await world.steps.get(binding.ownerRunId, stepId, { resolveData: "all" });
+      if (step.runId !== binding.ownerRunId || step.stepId !== stepId) {
+        throw new Error("Native recovery step owner differs.");
+      }
+      const retained = { step };
+      steps.set(stepId, retained);
+      const name = nativeFunction(step.stepName);
+      if (!relevantSteps.has(name)) return retained;
+      if (
+        step.status === "completed" &&
+        step.output !== undefined &&
+        name !== "terminateChildSessionsStep"
+      ) {
+        try {
+          retained.output = await dependencies.hydrateStepReturnValue(step.output, run.runId, key);
+        } catch {
+          issues.push({ reason: "native-step-output-unreadable", stepId });
+        }
+      }
+      const completedTerminalError = name === "turnStep" && retained.output?.action === "done";
+      if (
+        step.input !== undefined &&
+        (name !== "turnStep" || step.status === "failed" || completedTerminalError)
+      ) {
+        try {
+          retained.arguments = await dependencies.hydrateStepArguments(step.input, run.runId, key);
+        } catch {
+          issues.push({ reason: "native-step-input-unreadable", stepId });
+        }
+      }
+      return retained;
+    };
+    const addCandidate = (kind, value, origin) => {
+      if (!isRecord(value) || !isRecord(value.serializedContext) || !isRecord(value.sessionState))
+        return;
+      let session;
+      try {
+        session = dependencies.readDurableSession(value.sessionState);
+      } catch {
+        return;
+      }
+      if (
+        session.sessionId !== binding.logicalSessionId ||
+        value.sessionState.sessionId !== binding.logicalSessionId ||
+        value.serializedContext["eve.sessionId"] !== binding.logicalSessionId
+      ) {
+        throw new Error("Native checkpoint logical identity differs.");
+      }
+      candidates.push({
+        kind,
+        origin,
+        serializedContext: value.serializedContext,
+        sessionState: value.sessionState,
+        ...(["failed-turn-input", "completed-terminal-turn-input"].includes(kind)
+          ? { incoming: value.input }
+          : {}),
+      });
+    };
+
+    // Native event positions establish checkpoint order. Wall-clock timestamps
+    // and newest step IDs cannot establish which state the owner adopted.
+    for (const { event, slot } of events) {
+      if (!event.eventType.startsWith("step_") || !event.correlationId) continue;
+      const knownName = stepNames.get(event.correlationId);
+      // Unrelated steps already retain their raw resolved input/result/error
+      // in the native log. Do not fetch or hydrate them a second time.
+      if (knownName !== undefined && !relevantSteps.has(knownName)) continue;
+      const retained = await readStep(event.correlationId);
+      const name = nativeFunction(retained.step.stepName);
+      const origin = coordinates(event, slot);
+      const argument = retained.arguments?.args?.[0];
+      if (
+        name === "terminateChildSessionsStep" &&
+        ["step_started", "step_completed", "step_failed"].includes(event.eventType)
+      ) {
+        addCandidate(
+          "terminal-finalizer-input",
+          argument,
+          inputOrigins.get(event.correlationId) ?? origin,
+        );
+      } else if (name === "turnStep" && event.eventType === "step_failed") {
+        addCandidate(
+          "failed-turn-input",
+          argument,
+          inputOrigins.get(event.correlationId) ?? origin,
+        );
+      } else if (
+        name === "turnStep" &&
+        event.eventType === "step_completed" &&
+        retained.step.status === "completed"
+      ) {
+        if (retained.output?.action === "done") {
+          addCandidate(
+            "completed-terminal-turn-input",
+            argument,
+            inputOrigins.get(event.correlationId) ?? origin,
+          );
+        }
+        addCandidate("committed-turn-output", retained.output, origin);
+      }
+    }
+
+    const rank = {
+      "terminal-finalizer-input": 0,
+      "completed-terminal-turn-input": 1,
+      "failed-turn-input": 2,
+      "committed-turn-output": 3,
+    };
+    candidates.sort(
+      (left, right) => rank[left.kind] - rank[right.kind] || right.origin.slot - left.origin.slot,
+    );
+    const unique = candidates.filter(
+      (candidate, index) =>
+        candidates.findIndex(
+          (other) =>
+            other.kind === candidate.kind && other.origin.stepId === candidate.origin.stepId,
+        ) === index,
+    );
+    if (unique.length === 0)
+      return { kind: "unavailable", reason: "paired-native-checkpoint-unavailable" };
+
+    const nativeEvents = [];
+    try {
+      for await (const event of dependencies.readNativeEvents(run.runId)) nativeEvents.push(event);
+    } catch {
+      issues.push({ reason: "native-stream-incomplete" });
+    }
+    // A result emitted during a failed step is real evidence, but is not proof
+    // that the step's authored-state mutations committed. Never infer or replay.
+    for (const { step } of steps.values()) {
+      if (step.status === "failed" && nativeFunction(step.stepName) === "turnStep") {
+        issues.push({ reason: "failed-turn-effects-unreconciled", stepId: step.stepId });
+      }
+    }
+    for (const retained of steps.values()) {
+      if (
+        nativeFunction(retained.step.stepName) === "turnStep" &&
+        retained.output?.action === "done"
+      ) {
+        issues.push({
+          reason: "completed-terminal-effects-unreconciled",
+          stepId: retained.step.stepId,
+        });
+      }
+    }
+    const frontier = unique.map((candidate) => ({
+      origin: candidate.origin,
+      // Full later native log is retained, including original hook/approval
+      // payloads, failed inputs and completed outcomes. No rollback is implied.
+      events: events.filter(({ slot }) => slot > candidate.origin.slot).map(({ event }) => event),
+    }));
+    const payload = {
+      version: 1,
+      binding,
+      run,
+      nativeRunKey: key,
+      candidates: unique,
+      events: events.map(({ event }) => event),
+      frontier,
+      steps: [...steps.values()],
+      nativeEvents,
+      issues,
+    };
+    const handle = Object.freeze({ kind: "private-native-recovery-candidate", version: 1 });
+    payloads.set(handle, payload);
+    const inspection = Object.freeze({
+      version: 1,
+      candidates: unique.map((candidate) => {
+        const session = dependencies.readDurableSession(candidate.sessionState);
+        const workflow = session.state?.["autograph-app-builder.workflow.v17"];
+        const authority = session.state?.["autograph-app-builder.private-apply-authority.v1"];
+        return {
+          kind: candidate.kind,
+          slot: candidate.origin.slot,
+          workflowPhase: workflowPhases.has(workflow?.phase) ? workflow.phase : "unavailable",
+          privateApplyGrantPresent: authority?.grant != null,
+          sandboxStatePresent: session.sandboxState !== undefined,
+          historyMessageCount: session.history?.length ?? 0,
+          incomingRuntimeResultCount: candidate.incoming?.runtimeResults?.results?.length ?? 0,
+          incomingDeliveryPresent: candidate.incoming?.delivery !== undefined,
+        };
+      }),
+      nativeEventCount: nativeEvents.length,
+      uncertaintyReasons: [...new Set(issues.map(({ reason }) => reason))],
+      // Collection alone never establishes safe replay or permission to run.
+      requiresTrustedReconciliation: true,
+    });
+    return { kind: "candidate", candidate: handle, inspection };
+  };
+}
+
+/** Production wiring stays inside the native framework, after owner authorization. */
+export async function collectTerminalRecoveryCandidate(input) {
+  const [runtime, serialization, durable, stream, protocol] = await Promise.all([
+    import("#internal/workflow/runtime.js"),
+    import("#compiled/@workflow/core/serialization.js"),
+    import("#execution/durable-session-store.js"),
+    import("#execution/ndjson-stream.js"),
+    import("#protocol/message-version.js"),
+  ]);
+  // Hydration for inspection must not start stream forwarding, lock polling,
+  // or live AbortSignal readers. Keep transport refs inert; their original
+  // serialized bytes remain in the private native log/step record.
+  const transportRevivers = Object.fromEntries(
+    ["ReadableStream", "WritableStream", "AbortController", "AbortSignal"].map((type) => [
+      type,
+      (value) => Object.freeze({ kind: "native-recovery-transport-reference", type, value }),
+    ]),
+  );
+  return createTerminalRecoveryCandidateCollector({
+    getWorld: runtime.getWorld,
+    resolveRunEncryptionKey: runtime.resolveRunEncryptionKey,
+    hydrateStepArguments: (value, runId, key) =>
+      serialization.hydrateStepArguments(value, runId, key, [], globalThis, transportRevivers),
+    hydrateStepReturnValue: (value, runId, key) =>
+      serialization.hydrateStepReturnValue(value, runId, key, globalThis, transportRevivers),
+    readDurableSession: durable.readDurableSession,
+    requireEventSlot: nativeEventSlot,
+    readNativeEvents: (runId) =>
+      stream.parseNdjsonStream(
+        () => runtime.getRun(runId).getReadable(),
+        protocol.normalizePersistedMessageStreamEvent,
+      ),
+    now: Date.now,
+  })(input);
+}
