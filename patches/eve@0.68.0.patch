+import { getPendingCoordinationBatch, resolvePendingCoordination, setPendingCoordinationBatch } from "#harness/coordination.js";
+import { hasPendingInputBatch, queueDeferredStepInput } from "#harness/pending-input-batches.js";
+
+// Own input must settle before deferred calls can execute. Child proxy input
+// is separate and continues through the existing coordination result path.
+export async function resolveApprovalFirstCoordination(input) {
+  if (!hasPendingInputBatch(input.session.state)) {
+    const resolved = await resolvePendingCoordination(input);
+    if (resolved.outcome !== "resolved") return resolved;
+    const messages = coalesceApprovalReplayTail(resolved.messages);
+    let session = { ...resolved.session, history: messages };
+    if (approvedNativeReplayCallIds(messages, input.tools).size === 0) return { ...resolved, messages, session };
+    const { runtimeActionResults, ...deferred } = input.stepInput ?? {};
+    if (Object.keys(deferred).length > 0) session = queueDeferredStepInput(session, deferred);
+    return { ...resolved, messages, session, stepInput: { runtimeActionResults } };
+  }
+  const results = input.stepInput?.runtimeActionResults;
+  const session = results?.length > 0
+    ? queueDeferredStepInput(input.session, { runtimeActionResults: results })
+    : input.session;
+  return { messages: [...session.history], outcome: "continue", session };
+}
+
+// Preserve the original deferred requests after approval; never replay them via
+// another model call. A denied call already has its not-run transcript/result.
+export function settleCoordinationApprovals(input) {
+  const batch = getPendingCoordinationBatch(input.session.state);
+  if (batch === undefined || input.resolvedInputs === undefined) return;
+  const resolved = input.resolvedInputs.flatMap((batch) => batch.inputs);
+  if (resolved.length === 0) return;
+  for (const entry of resolved) {
+    if (entry.outcome !== "approved") continue;
+    const name = entry.request.action.toolName;
+    if (entry.toolReplayIdentity !== undefined && input.toolReplayIdentity?.(name) !== entry.toolReplayIdentity)
+      throw Error("The connection for this tool call changed or is unavailable. Request a new tool call and approval.");
+    if (!input.tools.has(name))
+      throw Error("The approved tool is no longer available. Request a new tool call and approval.");
+  }
+  const denied = new Set(resolved.filter((entry) => entry.outcome !== "approved")
+    .map((entry) => entry.request.action.callId));
+  return setPendingCoordinationBatch({
+    ...batch,
+    runtimeActions: batch.runtimeActions.filter((call) => !denied.has(call.callId)),
+    tasks: batch.tasks.filter((call) => !denied.has(call.callId)),
+    session: { ...input.session, history: input.messages },
+  });
+}
+
+// The SDK collects approval responses from the last tool message, before its
+// own adjacent-tool coalescing. Keep genuine coordinated outputs in that tail.
+export function approvalReplayTailStart(messages) {
+  let start = messages.length;
+  while (start > 0 && messages[start - 1].role === "tool") start -= 1;
+  return messages.slice(start).some((message) => message.content.some((part) => part.type === "tool-approval-response"))
