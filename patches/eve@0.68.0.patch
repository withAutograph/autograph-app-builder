+import type { DurableSession } from "#execution/durable-session-store.js";
+import type {
+  PairedNativeRecoveryCheckpoint,
+  PrivateNativeRecoveryPayload,
+} from "#execution/session/recovery-candidate.js";
+
+export type RetrospectiveCancelledToolHistory =
+  | { readonly kind: "unchanged" }
+  | { readonly kind: "restored"; readonly history: DurableSession["history"] }
+  | {
+      readonly kind: "uncertain";
+      readonly reason: "cancelled-call-history-unreconciled" | "cancelled-call-result-unreconciled";
+      readonly callId?: string;
+    };
+
+/**
+ * Requires an authorized, immutable-provenance physical leaf payload. Run the
+ * existing effect-frontier assessment BEFORE invoking this pure proposal, and
+ * retain normal protocol/replay checks afterwards. Only history may be used;
+ * this result grants no effect authority and supplies no reducer input.
+ */
+export declare function proposeRetrospectiveCancelledToolHistory(
+  payload: PrivateNativeRecoveryPayload,
+  latestCandidate: PairedNativeRecoveryCheckpoint,
+  latestSession: DurableSession,
+): RetrospectiveCancelledToolHistory;
