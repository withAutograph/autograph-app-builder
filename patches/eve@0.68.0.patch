--- /dev/null
+++ b/dist/src/execution/session/recovery-owner-provenance.js
@@ -0,0 +1,463 @@
+import { createRecoveryHistoryInterner } from "#execution/session/recovery-history-interning.js";
+import { isDeepStrictEqual } from "node:util";
+import {
+  sessionCommandHookToken,
+  sessionInboxHookToken,
+} from "#execution/session-inbox/address.js";
+
+const nameOf = (value) =>
+  String(value ?? "")
+    .split(/[/:#]/u)
+    .at(-1);
+const record = (value) => value !== null && typeof value === "object" && !Array.isArray(value);
+const terminal = (run) => ["completed", "failed", "cancelled"].includes(run.status);
+const unavailable = (reason) => ({ kind: "unavailable", reason });
+const statusLabel = (value) => ["pending", "running", "completed", "failed", "cancelled", "waiting", "queued", "suspended"].includes(value) ? value : "other";
+export const nativeRecoveryBoundary = (stage, run, allowParked, parent) => ({ stage, status: statusLabel(run.status), ...(parent === undefined ? {} : { parentStatus: statusLabel(parent.status) }), allowParked: allowParked === true });
+
+/** Private discovery hints never authorize collection of a candidate's app state. */
+export async function resolveTerminalCheckpointOwner(input) { return await discoverCheckpointOwner({ ...input, allowLiveAncestors: false }); }
+export async function discoverOwnedRecoveryLineage(input) { return await discoverCheckpointOwner({ ...input, allowParked: true, allowLiveAncestors: true }); }
+async function discoverCheckpointOwner({
+  world,
+  anchor,
+  allowParked = false,
+  allowLiveAncestors = false,
+  binding,
+  authorizeOwner,
+  dependencies,
+}) {
+  const authorize = () => authorizeOwner(binding);
+  const history = createRecoveryHistoryInterner(binding.logicalSessionId);
+  const runs = new Map([[anchor.runId, anchor]]);
+  const entries = new Map();
+  const logs = new Map();
+  const retainedSteps = new Map();
+  const stepNames = new Map();
+  const keys = new Map();
+  const keyFor = async (run) => {
+    if (!keys.has(run.runId)) {
+      await authorize();
+      keys.set(run.runId, await dependencies.resolveRunEncryptionKey(world, run));
+    }
+    return keys.get(run.runId);
+  };
+  const runFor = async (runId) => {
+    if (!runs.has(runId)) {
+      await authorize();
+      const run = await world.runs.get(runId, { resolveData: "all" });
+      if (run.runId !== runId) throw new Error("Native handoff run identity differs.");
+      runs.set(runId, run);
+    }
+    return runs.get(runId);
+  };
+  const entryFor = async (run) => {
+    if (!entries.has(run.runId)) {
+      await authorize();
+      const args = await dependencies.hydrateWorkflowArguments(
+        run.input,
+        run.runId,
+        await keyFor(run),
+      );
+      entries.set(run.runId, Array.isArray(args) && args.length === 1 ? history.checkpoint(args[0]) : undefined);
+    }
+    return entries.get(run.runId);
+  };
+  const eventsFor = async (runId, resolveData = "none", refresh = false) => {
+    const cacheKey = `${runId}:${resolveData}`;
+    if (!refresh && logs.has(cacheKey)) return logs.get(cacheKey);
+    const events = [];
+    const seen = new Set();
+    const cursors = new Set();
+    let cursor;
+    do {
+      await authorize();
+      const page = await world.events.list({
+        runId,
+        resolveData,
+        pagination: {
+          limit: 128,
+          sortOrder: "asc",
+          ...(cursor === undefined ? {} : { cursor }),
+        },
+      });
+      for (const event of page.data) {
+        if (event.runId !== runId) throw new Error("Native handoff event owner differs.");
+        if (seen.has(event.eventId)) continue;
+        if (
+          events.length > 0 &&
+          dependencies.requireEventSlot(event.eventId) <=
+            dependencies.requireEventSlot(events.at(-1).eventId)
+        )
+          throw new Error("Native handoff event order differs.");
+        seen.add(event.eventId);
+        events.push(event);
+      }
+      if (!page.hasMore) break;
+      if (!page.cursor || cursors.has(page.cursor))
+        throw new Error("Native handoff pagination did not advance.");
+      cursor = page.cursor;
+      cursors.add(cursor);
+    } while (true);
+    logs.set(cacheKey, events);
+    return events;
+  };
+  const stepsFor = async (run, wanted) => {
+    const events = await eventsFor(run.runId);
+    const names = new Map();
+    for (const event of events) {
+      if (event.correlationId && typeof event.eventData?.stepName === "string")
+        names.set(event.correlationId, nameOf(event.eventData.stepName));
+    }
+    for (const stepId of new Set(
+      events
+        .filter((event) => event.eventType.startsWith("step_") && event.correlationId)
+        .map((event) => event.correlationId),
+    )) {
+      if (names.has(stepId)) continue;
+      await authorize();
+      const step = await world.steps.get(run.runId, stepId, { resolveData: "none" });
+      if (step.runId !== run.runId || step.stepId !== stepId || typeof step.stepName !== "string")
+        throw new Error("Native handoff step metadata is unavailable.");
+      names.set(stepId, nameOf(step.stepName));
+    }
+    stepNames.set(run.runId, names);
+    const selected = [];
+    for (const [stepId, name] of names) {
+      if (!wanted.has(name)) continue;
+      const cacheKey = `${run.runId}:${stepId}`;
+      if (!retainedSteps.has(cacheKey)) {
+        await authorize();
+        const step = await world.steps.get(run.runId, stepId, { resolveData: "all" });
+        if (step.runId !== run.runId || step.stepId !== stepId || nameOf(step.stepName) !== name)
+          throw new Error("Native handoff step identity differs.");
+        const args =
+          step.input === undefined
+            ? undefined
+            : await dependencies.hydrateStepArguments(step.input, run.runId, await keyFor(run));
+        retainedSteps.set(cacheKey, {
+          step: { ...step, input: undefined, output: undefined },
+          input: history.checkpoint(args?.args?.[0]),
+        });
+      }
+      selected.push(retainedSteps.get(cacheKey));
+    }
+    return selected;
+  };
+  const activeStarts = async (run) => {
+    const starts = await stepsFor(run, new Set(["startSessionOwnerStep"]));
+    const events = await eventsFor(run.runId);
+    const token = `${run.runId}:handoff`;
+    const hooks = events.filter(
+      (event) => event.eventType === "hook_created" && event.eventData?.token === token,
+    );
+    const active = [];
+    for (const start of starts) {
+      const first = events.find(
+        (event) =>
+          event.correlationId === start.step.stepId &&
+          ["step_created", "step_started"].includes(event.eventType),
+      );
+      if (first === undefined || start.input?.activationToken !== token)
+        throw new Error("Native handoff start provenance is incomplete.");
+      const slot = dependencies.requireEventSlot(first.eventId);
+      const hook = hooks
+        .filter((event) => dependencies.requireEventSlot(event.eventId) < slot)
+        .at(-1);
+      if (hook === undefined) throw new Error("Native handoff activation hook is unavailable.");
+      const receipts = events.filter(
+        (event) =>
+          event.eventType === "hook_received" && event.correlationId === hook.correlationId,
+      );
+      const outcomes = [];
+      for (const receipt of receipts) {
+        await authorize();
+        const full = await world.events.get(run.runId, receipt.eventId, { resolveData: "all" });
+        if (
+          full.runId !== run.runId ||
+          full.correlationId !== hook.correlationId ||
+          full.eventType !== "hook_received"
+        )
+          throw new Error("Native handoff activation identity differs.");
+        const value = await dependencies.hydrateHookPayload(
+          full.eventData.payload,
+          run.runId,
+          await keyFor(run),
+        );
+        outcomes.push({ value, event: full });
+      }
+      if (
+        outcomes.length === 0 ||
+        !["active", "failed"].includes(outcomes[0].value?.kind) ||
+        outcomes.some(
+          (outcome) =>
+            !isDeepStrictEqual(outcome.value, outcomes[0].value) ||
+            dependencies.requireEventSlot(outcome.event.eventId) <= slot,
+        )
+      )
+        throw new Error("Native handoff activation is ambiguous.");
+      if (outcomes[0].value.kind === "failed") continue;
+      if (start.step.status !== "completed")
+        throw new Error("Native handoff start did not commit.");
+      const equivalent = active.find(
+        (prior) =>
+          prior.hook.correlationId === hook.correlationId &&
+          isDeepStrictEqual(prior.input, start.input),
+      );
+      if (equivalent === undefined)
+        active.push({
+          ...start,
+          first,
+          hook,
+          activation: outcomes[0].event,
+          startStepIds: [start.step.stepId],
+        });
+      else equivalent.startStepIds.push(start.step.stepId);
+    }
+    return active;
+  };
+
+  const anchorStarts = await activeStarts(anchor);
+  if (anchorStarts.length === 0) {
+    await authorize();
+    return {
+      kind: "resolved",
+      run: anchor,
+      key: await keyFor(anchor),
+      checkpointOwnerRunId: anchor.runId,
+      chain: [],
+    };
+  }
+  // Recovery is an operational read of retained canonical storage, not an
+  // observability query whose lookback may expire before the source payloads.
+  const hints = new Map();
+  const cursors = new Set();
+  let cursor;
+  do {
+    await authorize();
+    const page = await world.runs.list({
+      workflowName: anchor.workflowName,
+      resolveData: "none",
+      pagination: { limit: 100, sortOrder: "asc", ...(cursor === undefined ? {} : { cursor }) },
+    });
+    for (const hint of page.data) {
+      const previous = hints.get(hint.runId);
+      if (
+        previous !== undefined &&
+        ((previous.deploymentId !== undefined &&
+          hint.deploymentId !== undefined &&
+          previous.deploymentId !== hint.deploymentId) ||
+          (previous.workflowName !== undefined &&
+            hint.workflowName !== undefined &&
+            previous.workflowName !== hint.workflowName))
+      )
+        throw new Error("Native handoff discovery identity changed.");
+      hints.set(hint.runId, hint);
+    }
+    if (!page.hasMore) break;
+    if (!page.cursor || cursors.has(page.cursor))
+      throw new Error("Native handoff discovery pagination did not advance.");
+    cursor = page.cursor;
+    cursors.add(cursor);
+  } while (true);
+  const childrenFor = async (parent, input) => {
+    const children = [];
+    for (const hint of hints.values()) {
+      // Reuse the already-required exact target-deployment edge predicate to
+      // avoid hydrating unrelated applications while discovering private hints.
+      if (
+        hint.runId === parent.runId ||
+        hint.runId === anchor.runId ||
+        (hint.workflowName !== undefined && hint.workflowName !== anchor.workflowName) ||
+        (hint.deploymentId !== undefined && hint.deploymentId !== input.targetDeploymentId)
+      )
+        continue;
+      if (hint.deploymentId === undefined || hint.workflowName === undefined) {
+        await authorize();
+        const metadata = await world.runs.get(hint.runId, { resolveData: "none" });
+        if (metadata.runId !== hint.runId)
+          throw new Error("Native handoff discovery run identity differs.");
+        if (
+          metadata.deploymentId !== input.targetDeploymentId ||
+          metadata.workflowName !== anchor.workflowName
+        )
+          continue;
+      }
+      const run = await runFor(hint.runId);
+      if (run.deploymentId !== input.targetDeploymentId || run.workflowName !== anchor.workflowName)
+        continue;
+      const entry = await entryFor(run);
+      if (
+        !record(entry) ||
+        entry.kind !== "handoff" ||
+        entry.sessionId !== binding.logicalSessionId ||
+        entry.streamRunId !== binding.ownerRunId ||
+        entry.activationToken !== `${parent.runId}:handoff`
+      )
+        continue;
+      children.push({ run, entry });
+    }
+    return children;
+  };
+
+  const chain = [];
+  const visited = new Set();
+  let parent = anchor;
+  while (true) {
+    if (visited.has(parent.runId)) throw new Error("Native handoff ownership cycle.");
+    visited.add(parent.runId);
+    const starts = parent.runId === anchor.runId ? anchorStarts : await activeStarts(parent);
+    if (starts.length === 0) break;
+    if (starts.length !== 1) return unavailable("handoff-owner-ambiguous");
+    const start = starts[0];
+    const candidates = [];
+    for (const child of await childrenFor(parent, start.input)) {
+      const input = start.input;
+      if (
+        input.anchorRunId !== binding.ownerRunId ||
+        (input.logicalSessionId ?? input.anchorRunId) !== binding.logicalSessionId ||
+        child.entry.ownerDeploymentId !== input.targetDeploymentId ||
+        child.run.deploymentId !== input.targetDeploymentId ||
+        !isDeepStrictEqual(child.entry.checkpoint, input.checkpoint) ||
+        !isDeepStrictEqual(child.entry.delivery, input.delivery)
+      )
+        continue;
+      if (
+        input.checkpoint.sessionState.sessionId !== binding.logicalSessionId ||
+        input.checkpoint.serializedContext["eve.sessionId"] !== binding.logicalSessionId
+      )
+        throw new Error("Native handoff checkpoint logical identity differs.");
+      const activationSteps = await stepsFor(
+        child.run,
+        new Set(["signalSessionOwnerActivationStep", "validateSessionCheckpointStep"]),
+      );
+      const successful = activationSteps.filter(
+        ({ step, input: activation }) =>
+          nameOf(step.stepName) === "signalSessionOwnerActivationStep" &&
+          step.status === "completed" &&
+          activation?.token === child.entry.activationToken &&
+          activation.activation?.kind === "active",
+      );
+      if (
+        successful.length === 0 ||
+        activationSteps.some(
+          ({ step, input: activation }) =>
+            nameOf(step.stepName) === "signalSessionOwnerActivationStep" &&
+            step.status === "completed" &&
+            !isDeepStrictEqual(activation, successful[0].input),
+        )
+      )
+        continue;
+      const validation = activationSteps.filter(
+        ({ step, input: retained }) =>
+          nameOf(step.stepName) === "validateSessionCheckpointStep" &&
+          step.status === "completed" &&
+          isDeepStrictEqual(retained?.checkpoint, child.entry.checkpoint),
+      );
+      if (validation.length === 0) continue;
+      const events = await eventsFor(child.run.runId);
+      const activation = events.find(
+        (event) =>
+          event.eventType === "step_completed" && event.correlationId === successful[0].step.stepId,
+      );
+      const inbox = sessionInboxHookToken(sessionCommandHookToken(binding.logicalSessionId));
+      const claim = events.find(
+        (event) => event.eventType === "hook_created" && event.eventData?.token === inbox,
+      );
+      const validated = events.find(
+        (event) =>
+          event.eventType === "step_completed" &&
+          validation.some(({ step }) => step.stepId === event.correlationId),
+      );
+      if (
+        activation === undefined ||
+        claim === undefined ||
+        validated === undefined ||
+        dependencies.requireEventSlot(validated.eventId) >=
+          dependencies.requireEventSlot(claim.eventId) ||
+        dependencies.requireEventSlot(claim.eventId) >=
+          dependencies.requireEventSlot(activation.eventId)
+      )
+        continue;
+      await authorize();
+      const claimed = await world.events.get(child.run.runId, claim.eventId, {
+        resolveData: "all",
+      });
+      if (
+        claimed.runId !== child.run.runId ||
+        claimed.eventType !== "hook_created" ||
+        claimed.correlationId !== claim.correlationId ||
+        claimed.eventData?.token !== inbox
+      )
+        throw new Error("Native handoff claim identity differs.");
+      const claimMetadata = await dependencies.hydrateHookPayload(
+        claimed.eventData.metadata,
+        child.run.runId,
+        await keyFor(child.run),
+      );
+      if (claimMetadata?.sessionId !== binding.logicalSessionId) continue;
+      candidates.push(child);
+    }
+    if (candidates.length !== 1) return unavailable("handoff-owner-ambiguous");
+    const child = candidates[0];
+    if (!terminal(parent) && !(allowLiveAncestors && ["pending", "running"].includes(parent.status))) return { ...unavailable("source-not-terminal"), boundary: nativeRecoveryBoundary("handoff_parent", parent, allowParked) };
+    if (!terminal(child.run) && !(allowParked && ["pending", "running"].includes(child.run.status))) return { ...unavailable("source-not-terminal"), boundary: nativeRecoveryBoundary("handoff_successor", child.run, allowParked, parent) };
+    // After successful transfer a parent may only finish handoff bookkeeping.
+    // Retain each complete physical frontier separately; never compare its slots
+    // with the successor's slots or silently discard late authored work.
+    const parentEvents = await eventsFor(parent.runId);
+    const names = stepNames.get(parent.runId) ?? new Map();
+    const safeSteps = new Set(["cancelSessionTimeoutStep", "releaseSessionHooksStep"]);
+    for (const event of parentEvents) {
+      if (
+        dependencies.requireEventSlot(event.eventId) <=
+        dependencies.requireEventSlot(start.first.eventId)
+      )
+        continue;
+      if (
+        event.eventType.startsWith("step_") &&
+        !start.startStepIds.includes(event.correlationId) &&
+        !safeSteps.has(names.get(event.correlationId))
+      )
+        return unavailable("handoff-parent-frontier-uncertain");
+      if (["hook_created", "hook_conflict"].includes(event.eventType))
+        return unavailable("handoff-parent-frontier-uncertain");
+      if (event.eventType === "hook_received" && event.correlationId !== start.hook.correlationId) {
+        const token =
+          event.eventData?.token ??
+          parentEvents.find(
+            (created) =>
+              created.eventType === "hook_created" && created.correlationId === event.correlationId,
+          )?.eventData?.token;
+        if (token !== `${binding.ownerRunId}:anchor`)
+          return unavailable("handoff-parent-frontier-uncertain");
+      }
+    }
+    // A fresh metadata scan must independently certify the full parent frontier.
+    const retainedEvents = await eventsFor(parent.runId, "none", true);
+    if (
+      retainedEvents.length !== parentEvents.length ||
+      retainedEvents.some((event, index) => event.eventId !== parentEvents[index].eventId)
+    )
+      return unavailable("handoff-parent-frontier-uncertain");
+    chain.push({
+      parentRunId: parent.runId,
+      ownerRunId: child.run.runId,
+      startStepId: start.step.stepId,
+      activationEventId: start.activation.eventId,
+      events: retainedEvents,
+    });
+    parent = child.run;
+  }
+  if (!terminal(parent) && !(allowParked && ["pending", "running"].includes(parent.status))) return { ...unavailable("source-not-terminal"), boundary: nativeRecoveryBoundary("final_owner", parent, allowParked) };
+  if (parent.expiredAt !== undefined && new Date(parent.expiredAt).getTime() <= dependencies.now())
+    return unavailable("native-data-expired");
+  await authorize();
+  return {
+    kind: "resolved",
+    run: parent,
+    key: await keyFor(parent),
+    checkpointOwnerRunId: parent.runId,
+    chain,
+  };
+}
