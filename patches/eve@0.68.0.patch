+    const seenEvents = new Set();
+    let cursor;
+    const cursors = new Set();
+    do {
+      const page = await world.events.list({
+        runId: run.runId,
+        pagination: { limit: 128, sortOrder: "asc", ...(cursor === undefined ? {} : { cursor }) },
+        resolveData: "none",
+      });
+      for (const event of page.data) {
+        if (seenEvents.has(event.eventId)) continue;
+        if (event.runId !== run.runId) throw new Error("Native recovery event owner differs.");
