{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "app/.well-known/**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".config/mise/scripts/repository/build-operator-worker-catalog.mts",
    ".config/mise/scripts/repository/test-postgres-builder-repository-lookup.mts",
    ".config/mise/scripts/repository/test-postgres-public-release.mts",
    ".config/mise/scripts/repository/inspect-turn-execution.mts",
    ".config/mise/scripts/repository/compiled-operator-proof.mts",
    ".config/mise/scripts/repository/assert-hosted-eve-build-budget.mts"
  ],
  "exclude": ["node_modules"]
}
