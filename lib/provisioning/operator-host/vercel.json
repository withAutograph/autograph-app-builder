{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "operator": {
      "root": ".",
      "framework": "hono",
      "entrypoint": "entrypoint.ts",
      "functions": {
        "entrypoint.ts": {
          "includeFiles": "../../../node_modules/{eve,.pnpm/eve*/node_modules/eve}/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/v1/runtime",
      "destination": { "service": "operator" }
    }
  ]
}
