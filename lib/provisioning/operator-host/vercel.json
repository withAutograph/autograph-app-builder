{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "operator": {
      "root": ".",
      "framework": "hono",
      "entrypoint": "entrypoint.ts",
      "functions": {
        "entrypoint.ts": {
          "includeFiles": "node_modules/.pnpm/eve*/node_modules/eve/**",
          "maxDuration": 1800
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/v1/auth-schema-rollout",
      "destination": { "service": "operator" }
    },
    {
      "source": "/v1/key-custody/possession",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/runtime",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/public-release",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/app-integrations",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/central-integrations",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/central-deployment-events",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/repository-production",
      "destination": {
        "service": "operator"
      }
    },
    {
      "source": "/v1/repository-production/access/complete",
      "destination": {
        "service": "operator"
      }
    }
  ]
}
