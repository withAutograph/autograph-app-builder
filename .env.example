APP_ORIGIN=https://agent.example.com
# Vercel Flags server secrets. Create flags in Vercel, then pull these values
# locally; never expose either value with a NEXT_PUBLIC_ prefix or commit it.
FLAGS=
FLAGS_SECRET=
EVE_MODEL=openai/gpt-5.6-terra
# Vercel Community Integration slug and OAuth credentials. Register/provider activation is separate from deployment.
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# Base64-encoded 32-byte AES-256-GCM key and its rotation version. Never expose either to clients.
VERCEL_INTEGRATION_TOKEN_KEY=
VERCEL_INTEGRATION_TOKEN_KEY_VERSION=
# Sign in with Vercel OIDC App credentials. This is separate from the Community Integration above.
VERCEL_AUTH_CLIENT_ID=
VERCEL_AUTH_CLIENT_SECRET=
# GitHub App installation OAuth configuration. This is separate from the invited-user sign-in provider below.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Deployment-owned installation for the existing GitHub App. It may temporarily
# access all withAutograph repositories; each reader token is limited to
# withAutograph/arrusted-development and is never a user publishing install.
APP_BUILDER_TEMPLATE_READER_INSTALLATION_ID=
# Random HMAC secret of at least 32 characters. Never expose it to clients.
GITHUB_APP_INSTALL_STATE_SECRET=
# Dedicated GitHub user-token envelope key (base64-encoded 32 bytes), rotation
# version, and webhook secret. These are separate from every Vercel/auth key.
GITHUB_APP_USER_TOKEN_KEY=
GITHUB_APP_USER_TOKEN_KEY_VERSION=
GITHUB_APP_WEBHOOK_SECRET=
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://agent.example.com/api/auth
# Passkey-first onboarding is opt-in and restricted to loopback development or
# Vercel Preview. Preview additionally requires the exact protection acknowledgement.
PASSKEY_ONBOARDING=
PASSKEY_PREVIEW_PROTECTION=
EVE_HOSTED_ADAPTER=0
EVE_HOSTED_VERCEL_TEAM_SLUG=example-team
EVE_HOSTED_VERCEL_PROJECT_NAME=autograph-app-builder
EVE_HOSTED_VERCEL_ENVIRONMENT=preview
MCP_RESOURCE_URL=https://agent.example.com/mcp
MCP_OAUTH_ISSUER=https://agent.example.com/api/auth
MCP_OAUTH_AUDIENCE=https://agent.example.com/mcp
MCP_OAUTH_JWKS_URL=https://agent.example.com/api/auth/jwks
MCP_OAUTH_ALGORITHM=ES256
# Local Emulate provider connections. These values are development-only and must never be set in Preview or Production.
# `mise run app:dev-emulated` creates the ignored local secrets and starts
# Emulate, PostgreSQL, and HTTPS Next development on https://localhost:3001.
# Both sign-in buttons and provider Connect use only the seeded emulator.
# APP_BUILDER_LOCAL_PROVIDER_EMULATION=1
# VERCEL_EMULATOR_URL=http://localhost:4000
# GITHUB_EMULATOR_URL=http://localhost:4001
# EMULATE_PROVIDER_TOKEN=emulate_local_provider_token
# EMULATE_VERCEL_CONFIGURATION_ID=icfg_local_1
# EMULATE_VERCEL_TEAM_ID=autograph-local
# EMULATE_GITHUB_INSTALLATION_ID=1001
# EMULATE_GITHUB_REPOSITORY=autograph-local/demo-app
# EMULATE_LOCAL_RELAY_SECRET=generated under .emulate/relay-secret by app:dev-emulated

# Embedded provider emulation is opt-in and valid only for Vercel Preview.
# Configure these as encrypted Preview-only Vercel environment variables.
# Never use NEXT_PUBLIC_ names and never configure them for Production.
# APP_BUILDER_PREVIEW_PROVIDER_EMULATION=1
# EMULATE_PREVIEW_RELAY_SECRET=generate-at-least-32-random-characters
# EMULATE_PREVIEW_GITHUB_CLIENT_ID=preview-emulated-github
# EMULATE_PREVIEW_GITHUB_CLIENT_SECRET=generate-at-least-20-random-characters
# EMULATE_PREVIEW_GITHUB_APP_PRIVATE_KEY=optional-test-only-private-key
# EMULATE_PREVIEW_VERCEL_CLIENT_ID=preview-emulated-vercel
# EMULATE_PREVIEW_VERCEL_CLIENT_SECRET=generate-at-least-20-random-characters
